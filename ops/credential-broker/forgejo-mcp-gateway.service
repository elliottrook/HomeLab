[Unit]
Description=HomeLab broker-private Forgejo MCP gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hlabroker
Group=hlabroker
RuntimeDirectory=homelab-forgejo-mcp
RuntimeDirectoryMode=0755
UMask=0077
ExecStart=/usr/bin/python3 /opt/homelab-broker/forgejo_mcp_gateway.py --socket /run/homelab-forgejo-mcp/gateway.sock --binary /opt/forgejo-mcp/bin/forgejo-mcp --forgejo-url https://git.elliottrook.com --bao-address https://192.168.50.24:8200 --bao-ca /etc/homelab-broker/openbao-ca.crt --bao-approle /etc/homelab-broker/openbao-approle.json --bao-secret-path secret/data/ai-pam/forgejo-mcp-read --mode read
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
