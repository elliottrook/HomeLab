[Unit]
Description=HomeLab broker-private Forgejo MCP safe-write gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hlabroker-write
Group=hlabroker-write
SupplementaryGroups=hlabroker
RuntimeDirectory=homelab-forgejo-mcp-write
RuntimeDirectoryMode=0755
UMask=0007
ExecStart=/usr/bin/python3 /opt/homelab-broker/forgejo_mcp_gateway.py --socket /run/homelab-forgejo-mcp-write/gateway.sock --socket-group hlabroker --binary /opt/forgejo-mcp/bin/forgejo-mcp --forgejo-url https://git.elliottrook.com --bao-address https://192.168.50.24:8200 --bao-ca /etc/homelab-broker/openbao-ca.crt --bao-approle /etc/homelab-broker/openbao-write-approle.json --bao-secret-path secret/data/ai-pam/forgejo-mcp-safe-write --mode safe-write --base-branch main --branch-prefix ai-pam/ --path-prefix ai-pam-pilot/
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
