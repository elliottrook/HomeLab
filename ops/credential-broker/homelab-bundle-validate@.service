[Unit]
Description=Validate HomeLab Forgejo bundle %i
After=local-fs.target

[Service]
Type=oneshot
User=hlabundle
Group=hlabundle
SupplementaryGroups=
UMask=0077
ExecStart=/usr/bin/python3 /opt/homelab-broker/bundle_validate.py --inbox /var/lib/homelab-bundle-runner/inbox --bundle-id %i --base-file /etc/homelab-bundle-runner/base_revision --policy-file /etc/homelab-bundle-runner/policy_digest --allowed-signers /etc/homelab-bundle-runner/allowed_signers --principal cloud-producer
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
