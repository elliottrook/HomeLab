{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(ping:*)"
    ],
    "deny": [
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/*credentials*)",
      "Read(**/*secrets*)",
      "Bash(rm -rf:*)",
      "Bash(mkfs:*)",
      "Bash(dd:*)"
    ],
    "ask": [
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sudo:*)",
      "Bash(apt install:*)",
      "Bash(apt remove:*)",
      "Bash(nut-scanner:*)",
      "Bash(upsc:*)",
      "Bash(upscmd:*)",
      "Bash(systemctl:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "WebFetch(domain:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "network": {
      "allowedDomains": [
        "192.168.50.25",
        "192.168.20.40",
        "192.168.20.41",
        "192.168.20.42",
        "192.168.50.1",
        "192.168.1.1",
        "192.168.50.2",
        "192.168.20.20",
        "192.168.20.31",
        "192.168.50.26",
        "192.168.20.30",
        "192.168.20.10",
        "192.168.50.23",
        "192.168.70.10",
        "192.168.70.12",
        "192.168.50.10",
        "192.168.20.32",
        "192.168.50.21",
        "192.168.50.31",
        "192.168.50.141",
        "192.168.20.11",
        "192.168.60.10",
        "192.168.50.22",
        "192.168.30.102",
        "192.168.30.164",
        "git.elliottrook.com",
        "github.com",
        "deb.debian.org",
        "security.debian.org"
      ],
      "allowUnixSockets": [],
      "allowLocalBinding": false
    }
  }
}
