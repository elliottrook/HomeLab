#!/bin/bash

set -u

REPO="$HOME/lab/homelab"
CONFIG="$REPO/configs/devices.conf"
SERVICES_CONFIG="$REPO/configs/services.conf"
ARISTA_DEVICE="/dev/cu.usbserial-A98IEQ20"

source "$REPO/scripts/lib/output.sh"

show_help() {
    cat <<'HELP'
Jason's HomeLab Toolkit

Usage:
  lab COMMAND [OPTIONS]

General Commands
──────────────────────────────────────────────

  lab status             Check configured devices
  lab health             Check configured service ports
  lab list               List device names and addresses
  lab dashboard          Open all management pages
  lab docs               Show the HomeLab repository
  lab help               Show this help
  lab doctor             Run the complete HomeLab health assessment

Connection Commands
──────────────────────────────────────────────

  lab ssh DEVICE         Connect using SSH
  lab web DEVICE         Open a web interface
  lab arista             Open the Arista serial console

Backup Commands
──────────────────────────────────────────────

  lab backup             Show backup help
  lab backup opnsense    Back up OPNsense configuration
  lab backup arista      Back up Arista configuration and state
  lab backup proxmox     Back up Proxmox host configuration
  lab backup guided      Open guided export checklist
  lab backup synology-copy [--dry-run]
                         Copy private backups to the backup Synology
  lab backup all         Run automated backups, then show guided exports

Examples
──────────────────────────────────────────────

  lab status
  lab ssh proxmox
  lab web unifi
  lab backup all
HELP
}

require_config() {
    if [[ ! -f "$CONFIG" ]]; then
        echo "Configuration file not found: $CONFIG"
        exit 1
    fi
}

find_device() {
    local requested="$1"

    awk -F'|' -v requested="$requested" '
        $0 !~ /^#/ && $1 == requested {
            print
            exit
        }
    ' "$CONFIG"
}

show_list() {
    require_config

    printf "%-12s %-22s %-15s\n" "NAME" "DEVICE" "ADDRESS"
    printf "%-12s %-22s %-15s\n" "------------" "----------------------" "---------------"

    while IFS='|' read -r name display ip ssh_alias web_url; do
        [[ -z "$name" || "$name" == \#* ]] && continue
        printf "%-12s %-22s %-15s\n" "$name" "$display" "$ip"
    done < "$CONFIG"
}

check_host() {
    local display="$1"
    local ip="$2"

    if ping -c 1 -W 1000 "$ip" >/dev/null 2>&1; then
        printf "✓ %-22s %s\n" "$display" "$ip"
    else
        printf "✗ %-22s %s\n" "$display" "$ip"
    fi
}

show_status() {
    require_config

    echo "HomeLab Status"
    echo "------------------------------------------"

    while IFS='|' read -r name display ip ssh_alias web_url; do
        [[ -z "$name" || "$name" == \#* ]] && continue
        check_host "$display" "$ip"
    done < "$CONFIG"
}

ssh_device() {
    local requested="${1:-}"

    if [[ -z "$requested" ]]; then
        echo "Usage: lab ssh DEVICE"
        exit 1
    fi

    local record
    record="$(find_device "$requested")"

    if [[ -z "$record" ]]; then
        echo "Unknown device: $requested"
        echo
        show_list
        exit 1
    fi

    local name display ip ssh_alias web_url
    IFS='|' read -r name display ip ssh_alias web_url <<< "$record"

    if [[ -z "$ssh_alias" ]]; then
        echo "No SSH alias is configured for $display."
        exit 1
    fi

    exec ssh "$ssh_alias"
}

open_web() {
    local requested="${1:-}"

    if [[ -z "$requested" ]]; then
        echo "Usage: lab web DEVICE"
        exit 1
    fi

    local record
    record="$(find_device "$requested")"

    if [[ -z "$record" ]]; then
        echo "Unknown device: $requested"
        echo
        show_list
        exit 1
    fi

    local name display ip ssh_alias web_url
    IFS='|' read -r name display ip ssh_alias web_url <<< "$record"

    if [[ -z "$web_url" ]]; then
        echo "No web interface is configured for $display."
        exit 1
    fi

    echo "Opening $display: $web_url"
    open "$web_url"
}

open_dashboard() {
    require_config

    while IFS='|' read -r name display ip ssh_alias web_url; do
        [[ -z "$name" || "$name" == \#* || -z "$web_url" ]] && continue
        echo "Opening $display"
        open "$web_url"
        sleep 0.2
    done < "$CONFIG"
}
show_health() {
    if [[ ! -f "$SERVICES_CONFIG" ]]; then
        echo "Service configuration not found: $SERVICES_CONFIG"
        exit 1
    fi

    echo "HomeLab Service Health"
    echo "------------------------------------------"

    while IFS='|' read -r name display ip port; do
        [[ -z "$name" || "$name" == \#* ]] && continue

        if nc -z -G 2 "$ip" "$port" >/dev/null 2>&1; then
            printf "✓ %-24s %s:%s\n" "$display" "$ip" "$port"
        else
            printf "✗ %-24s %s:%s\n" "$display" "$ip" "$port"
        fi
    done < "$SERVICES_CONFIG"
}

copy_backups_to_synology() {
    local mode="${1:-run}"
    local source_dir="$HOME/lab/private-backups"
    local mount_point="/Volumes/Backup"
    local dest_dir="$mount_point/HomeLab-Backups/automated/private-backups"
    local manifest
    local rsync_options=(
        -rlt
        --safe-links
        --exclude
        .DS_Store
        --itemize-changes
    )

    if [[ "$mode" != "run" && "$mode" != "--dry-run" ]]; then
        error "Usage: lab backup synology-copy [--dry-run]"
        return 1
    fi

    header "Synology Backup Copy"

    if [[ ! -d "$source_dir" ]]; then
        error "Source backup directory not found: $source_dir"
        return 1
    fi

    if ! mount | grep -Fq " on $mount_point (smbfs"; then
        error "Expected SMB share is not mounted at $mount_point"
        error "Open smb://192.168.20.42/Backup in Finder, then retry."
        return 1
    fi

    info "Source: $source_dir"
    info "Destination: $dest_dir"
    warning "This copy is additive; destination files are not deleted."
    echo

    if [[ "$mode" == "--dry-run" ]]; then
        info "Dry run only; no files will be copied."
        if [[ -d "$dest_dir" ]]; then
            if ! rsync "${rsync_options[@]}" --dry-run "$source_dir/" "$dest_dir/"; then
                error "Synology copy dry run failed."
                return 1
            fi
        else
            warning "Destination does not exist yet and would be created."
            find "$source_dir" -type f ! -name .DS_Store -print
            echo
            info "Files: $(find "$source_dir" -type f ! -name .DS_Store | wc -l | tr -d ' ')"
            info "Source size: $(du -sh "$source_dir" | awk '{print $1}')"
        fi
        footer "Synology copy dry run completed"
        return 0
    fi

    if ! mkdir -p "$dest_dir"; then
        error "Unable to create the Synology destination: $dest_dir"
        return 1
    fi
    chmod 700 "$source_dir"

    info "Copying backup files..."
    if ! rsync "${rsync_options[@]}" "$source_dir/" "$dest_dir/"; then
        error "Copy to the Synology failed."
        return 1
    fi

    manifest="$(mktemp -t homelab-synology-copy.XXXXXX)"
    trap 'rm -f "$manifest"' RETURN

    info "Building source checksum manifest..."
    if ! (
        cd "$source_dir"
        while IFS= read -r -d '' file; do
            shasum -a 256 "$file"
        done < <(find . -type f ! -name .DS_Store -print0)
    ) > "$manifest"; then
        error "Unable to build the source checksum manifest."
        return 1
    fi

    if ! cp "$manifest" "$dest_dir/SHA256SUMS.latest.txt"; then
        error "Unable to copy the checksum manifest to the Synology."
        return 1
    fi

    info "Verifying the Synology destination..."
    if ! (
        cd "$dest_dir"
        shasum -a 256 -c SHA256SUMS.latest.txt
    ); then
        error "Synology destination checksum verification failed."
        return 1
    fi

    rm -f "$manifest"
    trap - RETURN

    footer "Synology backup copy and verification completed"
}

run_backup() {
    local target="${1:-help}"
    local option="${2:-}"

    case "$target" in
        opnsense)
            "$REPO/scripts/backup/opnsense.sh"
            ;;

        arista)
            "$REPO/scripts/backup/arista.sh"
            ;;

        proxmox)
            "$REPO/scripts/backup/proxmox.sh"
            ;;

        guided)
            "$REPO/scripts/backup/guided.sh"
            ;;

        synology-copy)
            copy_backups_to_synology "$option"
            ;;

        all)
            "$REPO/scripts/backup/opnsense.sh"
            "$REPO/scripts/backup/arista.sh"
            "$REPO/scripts/backup/proxmox.sh"

            echo
            warning "Automated backups complete."
            warning "UniFi, TrueNAS and Synology exports still require the guided step."
            echo

            "$REPO/scripts/backup/guided.sh"
            ;;
        doctor)
            "$REPO/scripts/doctor.sh"
            ;;

        help|"")
            header "Backup Commands"
            echo "  opnsense    Automated OPNsense XML backup"
            echo "  arista      Automated Arista configuration and state backup"
            echo "  proxmox     Automated Proxmox host configuration backup"
            echo "  guided      Guided UniFi, TrueNAS and Synology exports"
            echo "  synology-copy [--dry-run]"
            echo "               Copy private backups to the backup Synology"
            echo "  all         Run automated backups and guided exports"
            echo
            ;;

        *)
            error "Unknown backup target: $target"
            echo
            echo "Run: lab backup"
            exit 1
            ;;
    esac
}



case "${1:-help}" in
    status)
        show_status
        ;;
    backup)
        run_backup "${2:-}" "${3:-}"
        ;;
    health)
        show_health
        ;;
    doctor)
        "$REPO/scripts/doctor.sh"
        ;;

    list)
        show_list
        ;;

    ssh)
        ssh_device "${2:-}"
        ;;

    web)
        open_web "${2:-}"
        ;;

    dashboard)
        open_dashboard
        ;;

    arista)
        exec screen "$ARISTA_DEVICE" 9600
        ;;

    docs)
        cd "$REPO" || exit 1
        echo "HomeLab repository:"
        pwd
        ls
        ;;

    help|-h|--help)
        show_help
        ;;

    *)
        echo "Unknown command: $1"
        echo
        show_help
        exit 1
        ;;
esac
