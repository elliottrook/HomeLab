#!/bin/bash

set -u

REPO="$HOME/lab/homelab"
CONFIG="$REPO/configs/devices.conf"
SERVICES_CONFIG="$REPO/configs/services.conf"
ARISTA_DEVICE="/dev/cu.usbserial-A98IEQ20"

show_help() {
    cat <<'HELP'
HomeLab Administration Toolkit

Usage:
  lab status             Check all configured devices
  lab health             Check configured service ports
  lab list               List device names and addresses
  lab ssh DEVICE         Connect using the configured SSH alias
  lab web DEVICE         Open a device's web interface
  lab dashboard          Open all configured web interfaces
  lab arista             Open the Arista serial console
  lab docs               Open the HomeLab repository
  lab help               Show this help
  lab backup opnsense    Back up the OPNsense configuration

Examples:
  lab status
  lab ssh proxmox
  lab web unifi
  lab dashboard
HELP
}

require_config() {
    if [[ ! -f "$CONFIG" ]]; then
        echo "Configuration file not found: $CONFIG"
        exit 1
    fi
}

find_device() {
    local requested="$1"

    awk -F'|' -v requested="$requested" '
        $0 !~ /^#/ && $1 == requested {
            print
            exit
        }
    ' "$CONFIG"
}

show_list() {
    require_config

    printf "%-12s %-22s %-15s\n" "NAME" "DEVICE" "ADDRESS"
    printf "%-12s %-22s %-15s\n" "------------" "----------------------" "---------------"

    while IFS='|' read -r name display ip ssh_alias web_url; do
        [[ -z "$name" || "$name" == \#* ]] && continue
        printf "%-12s %-22s %-15s\n" "$name" "$display" "$ip"
    done < "$CONFIG"
}

check_host() {
    local display="$1"
    local ip="$2"

    if ping -c 1 -W 1000 "$ip" >/dev/null 2>&1; then
        printf "✓ %-22s %s\n" "$display" "$ip"
    else
        printf "✗ %-22s %s\n" "$display" "$ip"
    fi
}

show_status() {
    require_config

    echo "HomeLab Status"
    echo "------------------------------------------"

    while IFS='|' read -r name display ip ssh_alias web_url; do
        [[ -z "$name" || "$name" == \#* ]] && continue
        check_host "$display" "$ip"
    done < "$CONFIG"
}

ssh_device() {
    local requested="${1:-}"

    if [[ -z "$requested" ]]; then
        echo "Usage: lab ssh DEVICE"
        exit 1
    fi

    local record
    record="$(find_device "$requested")"

    if [[ -z "$record" ]]; then
        echo "Unknown device: $requested"
        echo
        show_list
        exit 1
    fi

    local name display ip ssh_alias web_url
    IFS='|' read -r name display ip ssh_alias web_url <<< "$record"

    if [[ -z "$ssh_alias" ]]; then
        echo "No SSH alias is configured for $display."
        exit 1
    fi

    exec ssh "$ssh_alias"
}

open_web() {
    local requested="${1:-}"

    if [[ -z "$requested" ]]; then
        echo "Usage: lab web DEVICE"
        exit 1
    fi

    local record
    record="$(find_device "$requested")"

    if [[ -z "$record" ]]; then
        echo "Unknown device: $requested"
        echo
        show_list
        exit 1
    fi

    local name display ip ssh_alias web_url
    IFS='|' read -r name display ip ssh_alias web_url <<< "$record"

    if [[ -z "$web_url" ]]; then
        echo "No web interface is configured for $display."
        exit 1
    fi

    echo "Opening $display: $web_url"
    open "$web_url"
}

open_dashboard() {
    require_config

    while IFS='|' read -r name display ip ssh_alias web_url; do
        [[ -z "$name" || "$name" == \#* || -z "$web_url" ]] && continue
        echo "Opening $display"
        open "$web_url"
        sleep 0.2
    done < "$CONFIG"
}
show_health() {
    if [[ ! -f "$SERVICES_CONFIG" ]]; then
        echo "Service configuration not found: $SERVICES_CONFIG"
        exit 1
    fi

    echo "HomeLab Service Health"
    echo "------------------------------------------"

    while IFS='|' read -r name display ip port; do
        [[ -z "$name" || "$name" == \#* ]] && continue

        if nc -z -G 2 "$ip" "$port" >/dev/null 2>&1; then
            printf "✓ %-24s %s:%s\n" "$display" "$ip" "$port"
        else
            printf "✗ %-24s %s:%s\n" "$display" "$ip" "$port"
        fi
    done < "$SERVICES_CONFIG"
}
run_backup() {
    local target="${1:-}"

    case "$target" in
        opnsense)
            "$REPO/scripts/backup-opnsense"
            ;;
        *)
            echo "Usage: lab backup opnsense"
            exit 1
            ;;
    esac
}


case "${1:-help}" in
    status)
        show_status
        ;;
    backup)
        run_backup "${2:-}"
        ;;
    health)
        show_health
        ;;

    list)
        show_list
        ;;

    ssh)
        ssh_device "${2:-}"
        ;;

    web)
        open_web "${2:-}"
        ;;

    dashboard)
        open_dashboard
        ;;

    arista)
        exec screen "$ARISTA_DEVICE" 9600
        ;;

    docs)
        cd "$REPO" || exit 1
        echo "HomeLab repository:"
        pwd
        ls
        ;;

    help|-h|--help)
        show_help
        ;;

    *)
        echo "Unknown command: $1"
        echo
        show_help
        exit 1
        ;;
esac
