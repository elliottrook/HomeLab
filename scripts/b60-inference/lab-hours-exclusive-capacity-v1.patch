--- /dev/null
+++ b/scripts/local-ai/install_lab_hours_capacity_metadata.py
@@ -0,0 +1,94 @@
+"""Bounded metadata-only upgrade; no model, service, timer or lease mutation."""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import time
+
+PILOT = Path('/usr/local/libexec/local-ai-lease/full-inference-pilot')
+OLD = {
+    'lab_hours_reservations.py': 'fe7a82c0ae45f949add44b4283c39793af50da156c4d81b67f7f56491bc7be09',
+    'lab_hours_booking_cli.py': '05c9655594f522ae8a43acce4c3b9677bc27a393d5988a21681c78088103f5fb',
+    'lab_hours_release_manifest.json': 'e4e9e4bf5d9456c0b2e74d479866510b48d532e165569ce7c52c07ff9ac6f447',
+}
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--stage', type=Path, required=True)
+    parser.add_argument('--effect-authorized', action='store_true')
+    args = parser.parse_args()
+    if not args.effect_authorized or os.geteuid() != 0:
+        raise RuntimeError('EXPLICIT_INSTALL_AUTHORITY_REQUIRED')
+    stage = args.stage.resolve()
+    st = stage.lstat()
+    if st.st_uid != 0 or st.st_mode & 0o077 or stage.parent != Path('/root'):
+        raise RuntimeError('STAGE_CUSTODY_INVALID')
+    source = stage / 'scripts/local-ai'
+    candidate = json.loads((source/'lab_hours_release_manifest.json').read_text())
+    for name, expected in OLD.items():
+        path = PILOT/name
+        if path.is_symlink() or path.stat().st_uid != 0 or digest(path) != expected:
+            raise RuntimeError('INSTALLED_SOURCE_DRIFT:'+name)
+    for name, expected in candidate['pins'].items():
+        if Path(name).name != name:
+            raise RuntimeError('NONCANONICAL_PIN')
+        path = source/name if name in OLD else PILOT/name
+        if path.is_symlink() or digest(path) != expected:
+            raise RuntimeError('CANDIDATE_PIN_DRIFT:'+name)
+    lease = subprocess.run(['/usr/local/sbin/local-ai-lease','status'],
+                           capture_output=True,text=True,check=True,timeout=10)
+    if json.loads(lease.stdout) not in ('ready', {'state':'ready'}):
+        raise RuntimeError('LEASE_NOT_READY')
+    for path in (Path('/var/lib/local-ai-lab/full-inference-drain.json'),
+                 Path('/var/lib/local-ai-lab/full-inference-drain.lock'),
+                 Path('/run/local-ai-lab-operation.lock')):
+        if path.exists():
+            raise RuntimeError('ACTIVE_LAB_BOUNDARY')
+    result = subprocess.run(['/usr/local/sbin/aster-lab-hours','list'],
+                            capture_output=True,text=True,check=True,timeout=10)
+    now = time.time()
+    for row in json.loads(result.stdout):
+        if row.get('state') == 'claimed' or (row.get('state') == 'scheduled'
+                and now-900 <= row['start_epoch'] <= now+900):
+            raise RuntimeError('BOOKING_NEAR_INSTALL')
+    backup = stage/'rollback'
+    backup.mkdir(mode=0o700)
+    for name in OLD:
+        shutil.copy2(PILOT/name, backup/name)
+    changed = []
+    try:
+        # Publish the manifest last; a concurrent old reader fails closed on drift.
+        for name in OLD:
+            target = PILOT/name
+            temporary = PILOT/(name+'.capacity-update')
+            if temporary.exists():
+                raise RuntimeError('TEMPORARY_TARGET_EXISTS')
+            shutil.copyfile(source/name, temporary)
+            os.chmod(temporary, target.stat().st_mode & 0o777)
+            os.replace(temporary, target)
+            changed.append(name)
+        for name, expected in candidate['pins'].items():
+            if digest(PILOT/name) != expected:
+                raise RuntimeError('POST_INSTALL_DRIFT:'+name)
+        shutil.copyfile(stage/'services/local-ai-lease/ASTER-LAB-HOURS-RESERVATION-RUNBOOK.md',
+                        stage/'installed-contract.md')
+    except BaseException:
+        for name in reversed(changed):
+            shutil.copy2(backup/name, PILOT/name)
+        raise
+    print(json.dumps({'state':'installed','stack_effects':False,
+        'checkpoint':str(backup), 'manifest_sha256':digest(PILOT/'lab_hours_release_manifest.json')}))
+
+
+if __name__ == '__main__':
+    main()
