@@ -143,5 +144,99 @@ class SourceUpdateTests(unittest.TestCase):
         self.assertEqual(self.adapter.effects, before)
         self.assertEqual(partial.read_bytes(), b'synthetic interrupted journal write')
 
+    def pending(self, phase='rolling-back', checkpoint='a'*64):
+        value = {'schema':'aster-diagnostic-source-update.v1',
+                 'checkpoint_sha256':checkpoint,'phase':phase}
+        self.store.write('update.json.next', value)
+        return (self.store.root/'update.json.next').read_bytes()
+
+    def test_recognized_complete_pending_is_archived_then_rollback_only(self):
+        self.update.apply(); raw = self.pending()
+        self.assertEqual(self.update.resolve_pending_rollback()['state'], 'rolled-back')
+        self.assertEqual(self.adapter.pins, self.old)
+        self.assertFalse((self.store.root/'update.json.next').exists())
+        archives = list(self.store.root.glob('pending-*.json'))
+        self.assertEqual(len(archives), 1)
+        self.assertEqual(archives[0].read_bytes(), raw)
+
+    def test_pending_after_source_loss_can_be_resolved_by_fresh_object(self):
+        self.adapter.crash_after = CHANGED[0]
+        with self.assertRaises(SystemExit): self.update.apply()
+        raw = self.pending('updating')
+        update = SourceUpdate(self.store, self.adapter, self.old, self.new)
+        update.resolve_pending_rollback()
+        self.assertEqual(self.adapter.pins, self.old)
+        self.assertEqual(list(self.store.root.glob('pending-*.json'))[0].read_bytes(), raw)
+
+    def test_unrecognized_pending_remains_byte_identical_without_effects(self):
+        self.update.apply()
+        partial = self.store.root/'update.json.next'
+        partial.write_bytes(b'truncated JSON')
+        before = list(self.adapter.effects)
+        with self.assertRaisesRegex(SessionError, 'PENDING_UNRECOGNIZED'):
+            self.update.resolve_pending_rollback()
+        self.assertEqual(self.adapter.effects, before)
+        self.assertEqual(partial.read_bytes(), b'truncated JSON')
+        self.assertFalse(list(self.store.root.glob('pending-*.json')))
+
+    def test_pending_checkpoint_or_phase_drift_is_not_quarantined(self):
+        self.update.apply()
+        for phase, checkpoint in (('rolling-back', 'b'*64), ('checkpointed', 'a'*64)):
+            raw = self.pending(phase, checkpoint)
+            before = list(self.adapter.effects)
+            with self.assertRaisesRegex(SessionError, 'PENDING_UNRECOGNIZED'):
+                self.update.resolve_pending_rollback()
+            self.assertEqual((self.store.root/'update.json.next').read_bytes(), raw)
+            self.assertEqual(self.adapter.effects, before)
+
+    def test_no_idle_proof_or_unknown_source_blocks_pending_archive(self):
+        self.update.apply(); raw = self.pending(); before = list(self.adapter.effects)
+        self.adapter.idle = False
+        with self.assertRaisesRegex(SessionError, 'NOT_PROVEN_IDLE'):
+            self.update.resolve_pending_rollback()
+        self.adapter.idle = True; self.adapter.pins[CHANGED[0]] = 'f'*64
+        with self.assertRaisesRegex(SessionError, 'UNKNOWN_BYTES_RETAINED'):
+            self.update.resolve_pending_rollback()
+        self.assertEqual((self.store.root/'update.json.next').read_bytes(), raw)
+        self.assertEqual(self.adapter.effects, before)
+
+    def test_initial_uncommitted_checkpoint_pending_is_retained(self):
+        self.adapter.checkpoint_ok = False
+        with self.assertRaises(SessionError): self.update.apply()
+        self.adapter.checkpoint_ok = True; raw = self.pending('checkpointed')
+        with self.assertRaisesRegex(SessionError, 'INITIAL_JOURNAL_REQUIRES_REVIEW'):
+            self.update.resolve_pending_rollback()
+        self.assertEqual((self.store.root/'update.json.next').read_bytes(), raw)
+        self.assertFalse(self.adapter.effects)
+
+    def test_loss_after_archive_still_allows_ordinary_rollback(self):
+        self.update.apply(); self.pending()
+        with patch.object(self.update, '_rollback', side_effect=SystemExit('synthetic loss')):
+            with self.assertRaises(SystemExit): self.update.resolve_pending_rollback()
+        update = SourceUpdate(self.store, self.adapter, self.old, self.new)
+        update.rollback()
+        self.assertEqual(self.adapter.pins, self.old)
+        self.assertEqual(len(list(self.store.root.glob('pending-*.json'))), 1)
+
+    def test_existing_archive_is_never_overwritten(self):
+        self.update.apply(); self.pending()
+        digest = hashlib.sha256(canonical(self.store.read('update.json.next'))).hexdigest()
+        existing = self.store.root/f'pending-{digest}-00.json'
+        existing.write_bytes(b'prior evidence')
+        self.update.resolve_pending_rollback()
+        self.assertEqual(existing.read_bytes(), b'prior evidence')
+        self.assertTrue((self.store.root/f'pending-{digest}-01.json').exists())
+
+    def test_archive_capacity_refuses_without_losing_pending_evidence(self):
+        self.update.apply(); raw = self.pending()
+        digest = hashlib.sha256(canonical(self.store.read('update.json.next'))).hexdigest()
+        for slot in range(32):
+            (self.store.root/f'pending-{digest}-{slot:02}.json').write_bytes(b'prior evidence')
+        before = list(self.adapter.effects)
+        with self.assertRaisesRegex(SessionError, 'ARCHIVE_FULL'):
+            self.update.resolve_pending_rollback()
+        self.assertEqual(self.adapter.effects, before)
+        self.assertEqual((self.store.root/'update.json.next').read_bytes(), raw)
+
 
