         if state['phase'] == 'rolled-back':
@@ -128,3 +140,52 @@ class SourceUpdate:
             return self._rollback()
         finally:
             os.close(fd)
+
+    def resolve_pending_rollback(self):
+        """Preserve a recognized complete pending write, then roll back only.
+
+        Never adopt pending installed/success as authority or resume apply.
+        Malformed/initial/unrecognized pending writes remain untouched. The
+        future adapter must hold host exclusion, not just this journal lock.
+        """
+        fd = self.store.lock()
+        try:
+            self._ready()
+            if self.store.read('plan.json') != self.plan:
+                raise SessionError('SOURCE_UPDATE_PLAN_DRIFT')
+            if not (self.store.root/'update.json').exists():
+                # No source effect can precede the first committed state.
+                # Preserve this pre-effect ambiguity for explicit review.
+                raise SessionError('SOURCE_UPDATE_INITIAL_JOURNAL_REQUIRES_REVIEW')
+            state = self._state(self.store.read('update.json'))
+            try:
+                pending = self._state(self.store.read('update.json.next'))
+            except (ValueError, OSError, SessionError):
+                raise SessionError('SOURCE_UPDATE_PENDING_UNRECOGNIZED') from None
+            if (pending['checkpoint_sha256'] != state['checkpoint_sha256']
+                    or pending['phase'] not in PENDING_EDGES[state['phase']]):
+                raise SessionError('SOURCE_UPDATE_PENDING_UNRECOGNIZED')
+            self._known_pins()
+            if self.adapter.verify_checkpoint(state['checkpoint_sha256'], self.plan['old']) is not True:
+                raise SessionError('SOURCE_UPDATE_CHECKPOINT_UNVERIFIED')
+            digest = hashlib.sha256(canonical(pending)).hexdigest()
+            # No deletion or overwrite. Bounded slots preserve repeated same-
+            # phase pending writes, including interruption of rollback itself.
+            for slot in range(32):
+                archive = self.store.root/f'pending-{digest}-{slot:02}.json'
+                if not archive.exists() and not archive.is_symlink():
+                    break
+            else:
+                raise SessionError('SOURCE_UPDATE_PENDING_ARCHIVE_FULL')
+            self._ready()
+            os.rename(self.store.root/'update.json.next', archive)
+            directory = os.open(self.store.root, os.O_RDONLY)
+            try:
+                os.fsync(directory)
+            finally:
+                os.close(directory)
+            # If lost here, ordinary rollback still has the original committed
+            # state and verified checkpoint; evidence survives in the archive.
+            return self._rollback()
+        finally:
+            os.close(fd)
