+                for event in self.units.cleared_failures:
+                    if event not in previous['events']:
+                        previous['events'].append(event)
+                if len(previous['events'])>64:raise SessionError('UNIT_RECOVERY_EVIDENCE_DRIFT')
+                self.store.write(name,previous)
 
     def verify_entry(self,entry):
         self._load(); deadline=max(self.private['end_epoch'],self.clock()+120)
