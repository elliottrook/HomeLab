+import unittest
+from install_b60_completed_integrity_qualification import qualification_files,validate_terminal
+from lab_hours_exclusive_session import SessionError
+class CompletedIntegrityClockTests(unittest.TestCase):
+    def test_only_booked_qualification_clock_without_preparation(self):
+        b={'booking_id':'b60-exclusive-20261105-day-r3','start_epoch':1793924100}
+        files=qualification_files(b)
+        self.assertEqual(len(files),2)
+        self.assertFalse(any('integrity' in n for n in files))
+        timer=next(v for k,v in files.items() if k.endswith('.timer'))
+        self.assertIn('OnCalendar=2026-11-05 17:15:00 America/Vancouver',timer)
+        self.assertIn('Persistent=false',timer)
+    def test_failed_mismatched_or_stack_effecting_scan_refused(self):
+        b={'booking_id':'b60-exclusive-20261105-day-r3'}
+        t={'schema':'aster-exclusive-integrity-result.v1','booking_id':b['booking_id'],'state':'complete','ai_stack_effects':False,'archive_receipt':'proof'}
+        validate_terminal(t,b,'proof')
+        for key,value in [('booking_id','other'),('state','no_go'),('ai_stack_effects',True),('archive_receipt','old')]:
+            with self.assertRaises(SessionError):validate_terminal(dict(t,**{key:value}),b,'proof')
