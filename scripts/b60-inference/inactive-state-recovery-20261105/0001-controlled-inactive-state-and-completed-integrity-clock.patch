@@ -0,0 +1,77 @@
+"""Arm one future restore-only clock using an already completed fresh scan.
+
+Creates no preparation clock, so integrity can finish before another owner's
+reserved window. Actual admission revalidates archive identity and freshness.
+"""
+import argparse,hashlib,json,os,time
+from pathlib import Path
+from datetime import datetime
+from zoneinfo import ZoneInfo
+from host_exclusion import host_exclusion
+from lab_hours_exclusive_profile import load_profile,protected_bytes
+from lab_hours_exclusive_session import IDENTITY,SessionError,canonical
+from lab_hours_reservations import ReservationStore
+from retained_archive_integrity import load_root_owned,verify,fixed_proxmox_inventory,fixed_resolve
+from install_b60_daytime_qualification import ROOT,PACKAGE,UNITS,call,day_window_invalid,unit_files
+
+
+def qualification_files(booking):
+    prefix='b60-exclusive-qualification-'+booking['booking_id']
+    return {name:body for name,body in unit_files(booking,'unused').items() if name.startswith(prefix+'.')}
+
+
+def validate_terminal(terminal,booking,proof):
+    if (terminal.get('schema')!='aster-exclusive-integrity-result.v1'
+            or terminal.get('booking_id')!=booking['booking_id']
+            or terminal.get('state')!='complete' or terminal.get('ai_stack_effects') is not False
+            or terminal.get('archive_receipt')!=proof):
+        raise SessionError('COMPLETED_INTEGRITY_REQUIRED')
+
+
+def install(booking_id):
+    if os.geteuid()!=0 or os.uname().nodename!='proxmox' or not IDENTITY.fullmatch(booking_id):
+        raise SessionError('QUALIFICATION_SCHEDULE_IDENTITY')
+    with host_exclusion(ROOT):
+        if any(p.exists() or p.is_symlink() for p in (ROOT/'lease.json',ROOT/'lease.lock',
+                ROOT/'full-inference-drain.json',ROOT/'full-inference-drain.lock',
+                Path('/run/local-ai-lab-operation.lock'))):raise SessionError('SHARED_HOST_NOT_READY')
+        if json.loads(call(('/usr/local/sbin/local-ai-lease','status'))) not in ('ready',{'state':'ready'}):
+            raise SessionError('SHARED_HOST_NOT_READY')
+        profile=load_profile(ROOT/'exclusive-activations'/(booking_id+'.json'),PACKAGE)
+        booking=ReservationStore(ROOT/'reservations',expected_uid=0).get(booking_id)
+        if (profile['qualification_only'] is not True or profile['experiment'] is not None
+                or profile['booking_id']!=booking_id or booking.get('owner')!='b60-stream-a'
+                or booking.get('owner')!=profile['owner'] or booking.get('kind')!='exclusive-stack'
+                or booking.get('state')!='reserved' or booking['start_epoch']<time.time()+300
+                or day_window_invalid(booking)):
+            raise SessionError('FUTURE_RESTORE_ONLY_BOOKING_REQUIRED')
+        terminal_path=ROOT/'exclusive-integrity'/booking_id/'terminal.json'
+        terminal_bytes=protected_bytes(terminal_path)
+        terminal=json.loads(terminal_bytes);receipt=load_root_owned()
+        zone=ZoneInfo('America/Vancouver');cycle=datetime.fromtimestamp(time.time(),zone).strftime('%Y_%m_%d')
+        inventory=fixed_proxmox_inventory()
+        proof=verify(receipt,inventory,date=cycle,now_epoch=int(time.time()),resolve=fixed_resolve,lstat=os.lstat)
+        verify(receipt,inventory,date=cycle,now_epoch=booking['start_epoch']+120,resolve=fixed_resolve,lstat=os.lstat)
+        validate_terminal(terminal,booking,proof)
+        files=qualification_files(booking)
+        if len(files)!=2 or any((UNITS/n).exists() or (UNITS/n).is_symlink() for n in files):
+            raise SessionError('QUALIFICATION_UNIT_ALREADY_EXISTS')
+        for name,body in files.items():
+            fd=os.open(UNITS/name,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o644)
+            with os.fdopen(fd,'w') as stream:stream.write(body);stream.flush();os.fsync(stream.fileno())
+        call(('systemd-analyze','verify',*(str(UNITS/name) for name in files)))
+        call(('systemctl','daemon-reload'))
+        timers=[n for n in files if n.endswith('.timer')]
+        call(('systemctl','enable','--now',*timers))
+        return {'state':'qualification-scheduled','booking_id':booking_id,'timers':timers,
+            'preparation_timer_created':False,'model_experiment_scheduled':False,
+            'integrity_terminal_sha256':hashlib.sha256(terminal_bytes).hexdigest(),
+            'archive_receipt':proof,'unit_sha256':{n:hashlib.sha256(v.encode()).hexdigest() for n,v in files.items()}}
+
+
+if __name__=='__main__':
+    p=argparse.ArgumentParser(description=__doc__);p.add_argument('--booking-id',required=True)
+    p.add_argument('--schedule-qualification',action='store_true',required=True);a=p.parse_args()
+    try:print(json.dumps(install(a.booking_id),sort_keys=True))
+    except Exception as e:
+        print(json.dumps({'state':'no_go','failure_code':str(e) if isinstance(e,SessionError) else type(e).__name__}));raise SystemExit(1)
