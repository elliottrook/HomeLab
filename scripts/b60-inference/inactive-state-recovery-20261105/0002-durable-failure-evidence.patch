                 self.adapter.restore([row],2000,configuration_restored=True,timer_resume_safe=True)
             self.assertFalse(any('reset-failed' in c for c,t in self.runner.calls))
+
+    def test_failure_evidence_is_recorded_before_reset_and_after_observation(self):
+        row={'guest':'116','unit':'epub-narration-worker.service','active':'inactive','enablement':'static'}
+        self.runner.units[('116',row['unit'])]=['failed','static'];self.runner.failed_stop=True
+        events=[]
+        def record(event):
+            if not events:self.assertFalse(any('reset-failed' in c for c,t in self.runner.calls))
+            events.append(dict(event))
+        self.adapter.record_recovery=record
+        self.adapter.restore([row],2000,configuration_restored=True,timer_resume_safe=True)
+        self.assertEqual([e['state_reset'] for e in events],['intended','observed-inactive'])
