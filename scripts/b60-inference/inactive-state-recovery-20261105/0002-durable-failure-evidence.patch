                         raise UnitStateError('INACTIVE_STATE_NOT_RESTORED')
                     self.cleared_failures[-1]['state_reset']='observed-inactive'
+                    self.record_recovery(dict(self.cleared_failures[-1]))
         return self.verify(entry,deadline)
 
     def verify(self, entry, deadline):
