         self.store,self.bookings,self.profile=store,bookings,profile
         self.runner,self.admission,self.arm=runner,admission,arm_guardian
         self.clock=clock
-        self.units=ProxmoxUnitAdapter(runner,clock=clock)
+        self.units=ProxmoxUnitAdapter(runner,clock=clock,record_recovery=self._record_unit_recovery)
         self.timers=CalendarTimerResume(self.units,booking_id=profile.get('booking_id'),clock=clock)
         self.boundary=ExclusiveHostBoundary(root,operation,bookings,ready=self._ready)
         self.private=None
@@ -216,22 +216,21 @@ class ProxmoxEntryAdapter:
             raise SessionError('MOUNT_DRIFT_REQUIRES_DECLARED_RECOVERY')
         for guest in self.profile['guest_plans']:
             if self._guest(guest,'restore',deadline).get('verified') is not True: return False
-        try:
-            return self.units.restore(self.private['units'],deadline,
-                configuration_restored=True,timer_resume_safe=self.timers)
-        finally:
-            if self.units.cleared_failures:
-                name='unit-state-recovery.json'
-                previous=self.store.read(name) if (self.store.root/name).exists() else {
-                    'schema':'aster-unit-state-recovery.v1','booking_id':self.private['booking_id'],'events':[]}
-                if (previous.get('schema')!='aster-unit-state-recovery.v1'
-                        or previous.get('booking_id')!=self.private['booking_id']):
-                    raise SessionError('UNIT_RECOVERY_EVIDENCE_DRIFT')
-                for event in self.units.cleared_failures:
-                    if event not in previous['events']:
-                        previous['events'].append(event)
-                if len(previous['events'])>64:raise SessionError('UNIT_RECOVERY_EVIDENCE_DRIFT')
-                self.store.write(name,previous)
+        return self.units.restore(self.private['units'],deadline,
+            configuration_restored=True,timer_resume_safe=self.timers)
+
+    def _record_unit_recovery(self,event):
+        # Durable intent precedes reset-failed; observed state follows it. Owner
+        # loss cannot silently erase the original interrupted-job evidence.
+        name='unit-state-recovery.json'
+        previous=self.store.read(name) if (self.store.root/name).exists() else {
+            'schema':'aster-unit-state-recovery.v1','booking_id':self.profile['booking_id'],'events':[]}
+        if (previous.get('schema')!='aster-unit-state-recovery.v1'
+                or previous.get('booking_id')!=self.profile['booking_id']):
+            raise SessionError('UNIT_RECOVERY_EVIDENCE_DRIFT')
+        if event not in previous['events']:previous['events'].append(event)
+        if len(previous['events'])>64:raise SessionError('UNIT_RECOVERY_EVIDENCE_DRIFT')
+        self.store.write(name,previous)
 
     def verify_entry(self,entry):
         self._load(); deadline=max(self.private['end_epoch'],self.clock()+120)
