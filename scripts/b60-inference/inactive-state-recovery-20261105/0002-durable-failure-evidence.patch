     def call(self, guest, unit, args, deadline):
         if (guest,unit) not in SCOPE:
@@ -148,10 +149,12 @@ class ProxmoxUnitAdapter:
                         'prior_state':'failed','result':'signal','exit_code':2,'signal':15,
                         'observed_epoch':int(self.clock()),'state_reset':'intended',
                         'application_job_success_claimed':False})
+                    self.record_recovery(dict(self.cleared_failures[-1]))
                     self.effect(row,('reset-failed',),deadline)
