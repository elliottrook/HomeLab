+def timer_profile(raw,row):
+    if not isinstance(raw,str) or len(raw)>8192:raise UnitStateError('TIMER_RESUME_PROFILE_UNSUPPORTED')
+    values={'Persistent':[],'TimersCalendar':[],'TimersMonotonic':[]}
+    for line in raw.splitlines():
+        key,sep,value=line.partition('=')
+        if not sep or key not in values:raise UnitStateError('TIMER_RESUME_PROFILE_UNSUPPORTED')
+        if value:values[key].append(value)
+    if len(values['Persistent'])!=1 or values['Persistent'][0] not in {'yes','no'}:
+        raise UnitStateError('TIMER_RESUME_PROFILE_UNSUPPORTED')
+    if values['TimersCalendar'] and not values['TimersMonotonic']:
+        return 'calendar',values['Persistent'][0]
+    if ((row.get('guest'),row.get('unit'))==('115','paperless-summary.timer')
+            and values['Persistent']==['no'] and not values['TimersCalendar']):
+        parsed=[]
+        for item in values['TimersMonotonic']:
+            match=re.fullmatch(r'\{ (OnBootUSec|OnUnitInactiveUSec)=(2min|5min) ; next_elapse=[^{}]+ \}',item)
+            if not match:raise UnitStateError('TIMER_RESUME_PROFILE_UNSUPPORTED')
+            parsed.append(match.groups())
+        if len(parsed)==2 and set(parsed)=={('OnBootUSec','2min'),('OnUnitInactiveUSec','5min')}:
+            return 'paperless-monotonic','no'
+    raise UnitStateError('TIMER_RESUME_PROFILE_UNSUPPORTED')
+
 
