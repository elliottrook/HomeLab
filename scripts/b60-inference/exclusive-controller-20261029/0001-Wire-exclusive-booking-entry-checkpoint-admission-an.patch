+import unittest
+from lab_hours_prepare_entry_plan import configuration_files,current_plan
+from lab_hours_file_checkpoint import CheckpointError
+
+
+class PlanTests(unittest.TestCase):
+    def test_repeated_environment_paths_and_dropins_not_values_are_preserved(self):
+        raw=('EnvironmentFiles=/etc/aster/aster.env (ignore_errors=no)\n'
+             'EnvironmentFiles=/etc/aster/arr-broker.env (ignore_errors=no)\n'
+             'FragmentPath=/etc/systemd/system/aster-agent.service\n'
+             'DropInPaths=/etc/systemd/system/aster-agent.service.d/test.conf\n')
+        files=configuration_files(raw)
+        self.assertEqual(len(files),4)
+        self.assertIn('/etc/aster/arr-broker.env',files)
+
+    def test_root_level_llama_env_is_an_exact_exception_not_all_etc(self):
+        files=configuration_files('FragmentPath=/etc/systemd/system/aster-llama.service\n'
+                                 'EnvironmentFiles=/etc/aster-llama.env (ignore_errors=no)\n')
+        self.assertIn('/etc/aster-llama.env',files)
+        with self.assertRaisesRegex(CheckpointError,'OUTSIDE'):
+            configuration_files('FragmentPath=/etc/systemd/system/aster-llama.service\n'
+                                'EnvironmentFiles=/etc/shadow (ignore_errors=no)\n')
+
+    def test_raw_configuration_or_unknown_metadata_never_becomes_a_plan(self):
+        with self.assertRaisesRegex(CheckpointError,'UNSUPPORTED'):
+            configuration_files('FragmentPath=/etc/systemd/system/aster-agent.service\nSecret=value\n')
+
+    def test_news_inventory_includes_all_three_services_and_two_timers(self):
+        seen=[]
+        def runner(command):
+            seen.append(command[2]); return 'FragmentPath=/etc/systemd/system/'+command[2]+'\n'
+        plan=current_plan('114',runner=runner)
+        self.assertEqual(len(seen),5)
+        self.assertIn('news-aggregator-digest.service',seen)
+        self.assertEqual(plan['immutable_artifacts'],{})
+
+    def test_unknown_guest_cannot_choose_arbitrary_units(self):
+        with self.assertRaisesRegex(CheckpointError,'SCOPE'): current_plan('103')
+
+
+if __name__=='__main__': unittest.main()
