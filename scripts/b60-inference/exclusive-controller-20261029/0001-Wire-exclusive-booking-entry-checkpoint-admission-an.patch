index 000000000..0e5a64aaf
--- /dev/null
+++ b/scripts/local-ai/build_lab_hours_exclusive_bundle.py
@@ -0,0 +1,49 @@
+"""Build an exact local-import closure, without installing or arming anything."""
+from __future__ import annotations
+import argparse
+import ast
+import hashlib
+import json
+from pathlib import Path
+import shutil
+
+ENTRYPOINTS=('lab_hours_exclusive_cli.py','lab_hours_prepare_entry_plan.py')
+
+
+def closure(source,entrypoints=ENTRYPOINTS):
+    found=set(); pending=list(entrypoints)
+    while pending:
+        name=pending.pop()
+        if name in found: continue
+        path=source/name
+        if path.is_symlink() or not path.is_file(): raise ValueError('SOURCE_NOT_REGULAR')
+        tree=ast.parse(path.read_bytes(),filename=name); found.add(name)
+        for node in ast.walk(tree):
+            modules=[]
+            if isinstance(node,ast.Import): modules=[alias.name for alias in node.names]
+            elif isinstance(node,ast.ImportFrom) and node.module: modules=[node.module]
+            for module in modules:
+                candidate=module.split('.')[0]+'.py'
+                if (source/candidate).is_file(): pending.append(candidate)
+    return sorted(found)
+
+
+def build(source,destination):
+    names=closure(source)
+    destination.mkdir(mode=0o700,parents=False,exist_ok=False)
+    package=destination/'exclusive-session'; package.mkdir(mode=0o700)
+    pins={}
+    for name in names:
+        target=package/name; shutil.copyfile(source/name,target); target.chmod(0o600)
+        pins[name]=hashlib.sha256(target.read_bytes()).hexdigest()
+    (destination/'source-manifest.json').write_text(json.dumps({
+        'schema':'aster-exclusive-source-bundle.v1','pins':pins,
+        'installed':False,'armed':False},sort_keys=True,separators=(',',':')))
+    (destination/'source-manifest.json').chmod(0o600)
+    return {'source_count':len(pins),'installed':False,'armed':False}
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__); parser.add_argument('destination',type=Path)
+    args=parser.parse_args()
+    print(json.dumps(build(Path(__file__).resolve().parent,args.destination),sort_keys=True))
diff --git a/scripts/local-ai/lab_hours_exclusive_admission.py b/scripts/local-ai/lab_hours_exclusive_admission.py
