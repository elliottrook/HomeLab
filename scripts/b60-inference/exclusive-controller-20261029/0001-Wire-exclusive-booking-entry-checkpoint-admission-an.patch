+            raise ReservationError('exclusive claim identity is invalid')
+        with self.locked():
+            value=self._read_unlocked(self._path(booking_id))
+            now=int(self.clock())
+            if (value.get('kind')!='exclusive-stack' or value.get('state')!='reserved'
+                    or value.get('owner')!=owner):
+                raise ReservationError('exclusive booking owner or state mismatch')
+            if not value['start_epoch']<=now<=value['start_epoch']+120:
+                raise ReservationError('exclusive booking is outside its claim window')
+            value.update(state='claimed',claimant=claimant,claimed_epoch=now,
+                         entry_sha256=entry_sha256)
+            self._write_unlocked(value)
+            return value
+
     def cancel(self, booking_id: str) -> dict[str, object]:
         with self.locked():
