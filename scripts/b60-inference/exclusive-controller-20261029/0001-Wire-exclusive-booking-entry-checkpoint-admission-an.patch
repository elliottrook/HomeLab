diff --git a/scripts/local-ai/lab_hours_guest_checkpoint.py b/scripts/local-ai/lab_hours_guest_checkpoint.py
new file mode 100644
index 000000000..deda1783e
--- /dev/null
+++ b/scripts/local-ai/lab_hours_guest_checkpoint.py
@@ -0,0 +1,178 @@
+"""Root-local checkpoint endpoint; contents and credentials never leave guest.
+
+The plan is a protected declared mutation inventory, not a command supplied by
+a reservation. Only hashes and bounded result codes are emitted.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import stat
+import subprocess
+import time
+
+from lab_hours_file_checkpoint import FileCheckpoint, CheckpointError, sha
+
+ALLOWED_ROOTS=(Path('/etc/systemd/system'),Path('/opt/aster-agent'),
+               Path('/opt/aster-speech'),Path('/etc/local-ai'),Path('/etc/aster'),
+               Path('/etc/aster-speech'),Path('/etc/news-aggregator'))
+EXACT_CONFIG_FILES=frozenset({Path('/etc/aster-llama.env')})
+ARTIFACT_ROOTS=(Path('/opt'),Path('/var/lib'),Path('/mnt'),
+                Path('/usr/share/ollama/.ollama/models/blobs'))
+
+
+def private_json(path, *, uid=0):
+    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW)
+    try:
+        st=os.fstat(fd)
+        if (not stat.S_ISREG(st.st_mode) or st.st_uid!=uid or st.st_nlink!=1
+                or stat.S_IMODE(st.st_mode)!=0o600 or st.st_size>65536):
+            raise CheckpointError('PRIVATE_PLAN_CUSTODY')
+        return json.loads(os.read(fd,65537))
+    finally: os.close(fd)
+
+
+def validate_plan(plan, *, artifact_roots=ARTIFACT_ROOTS):
+    if (not isinstance(plan,dict) or set(plan)!={'schema','files','immutable_artifacts'}
+            or plan['schema']!='aster-guest-entry-plan.v1'
+            or not isinstance(plan['files'],list)
+            or not isinstance(plan['immutable_artifacts'],dict)
+            or set(plan['immutable_artifacts']) not in (set(),{'model','runtime'})):
+        raise CheckpointError('GUEST_ENTRY_PLAN_SCHEMA')
+    for value in plan['immutable_artifacts'].values():
+        path=Path(value)
+        if (not path.is_absolute() or '..' in path.parts
+                or not any(root in path.parents for root in artifact_roots)
+                or any(component.is_symlink() for component in (path,*path.parents))):
+            raise CheckpointError('ARTIFACT_SCOPE')
+
+
+def artifact_identities(plan):
+    result={}
+    for role,raw in plan['immutable_artifacts'].items():
+        path=Path(raw)
+        st=path.lstat()
+        if not stat.S_ISREG(st.st_mode) or st.st_nlink!=1:
+            raise CheckpointError('IMMUTABLE_ARTIFACT_CUSTODY')
+        before=(st.st_dev,st.st_ino,st.st_size,st.st_mtime_ns,st.st_ctime_ns)
+        result[role]=sha(path)
+        after=path.stat()
+        if before!=(after.st_dev,after.st_ino,after.st_size,after.st_mtime_ns,after.st_ctime_ns):
+            raise CheckpointError('IMMUTABLE_ARTIFACT_CHANGED')
+    return result
+
+
+def active_llama_artifacts():
+    """Project only model/executable identity from the live source-local PID.
+
+    Raw command-line arguments (which may include credentials) are never logged,
+    persisted or returned. Other runtime types need their own identity adapter.
+    """
+    result=subprocess.run(['systemctl','show','aster-llama.service','--property=MainPID','--value'],
+        capture_output=True,text=True,timeout=10,check=False)
+    if result.returncode or not result.stdout.strip().isdigit() or int(result.stdout.strip())<1:
+        raise CheckpointError('ACTIVE_ENTRY_PROCESS_UNAVAILABLE')
+    proc=Path('/proc')/result.stdout.strip()
+    before=(proc/'stat').read_text().rsplit(')',1)[1].split()[19]
+    if not any(line.endswith('/system.slice/aster-llama.service')
+               for line in (proc/'cgroup').read_text().splitlines()):
+        raise CheckpointError('ENTRY_PROCESS_SCOPE')
+    arguments=(proc/'cmdline').read_bytes().split(b'\0')
+    model=None
+    for index,argument in enumerate(arguments):
+        if argument in (b'--model',b'-m') and index+1<len(arguments): model=os.fsdecode(arguments[index+1])
+        elif argument.startswith(b'--model='): model=os.fsdecode(argument.partition(b'=')[2])
+    if not model: raise CheckpointError('ENTRY_MODEL_ARGUMENT_UNSUPPORTED')
+    result={'model':str(Path(model).resolve()),'runtime':str((proc/'exe').resolve())}
+    if before!=(proc/'stat').read_text().rsplit(')',1)[1].split()[19]:
+        raise CheckpointError('ENTRY_PROCESS_IDENTITY_CHANGED')
+    return result
+
+
+def bind_active_llama_entry(plan):
+    if active_llama_artifacts()!={role:str(Path(path).resolve())
+                                  for role,path in plan['immutable_artifacts'].items()}:
+        raise CheckpointError('ACTIVE_ENTRY_ARTIFACT_PLAN_MISMATCH')
+    return True
+
+
+def capture(plan, root, *, allowed_roots=ALLOWED_ROOTS, artifact_roots=ARTIFACT_ROOTS,
+            active_binding=None):
+    validate_plan(plan,artifact_roots=artifact_roots)
+    artifacts=artifact_identities(plan)
+    checkpoint=FileCheckpoint(root,allowed_roots=allowed_roots,
+                              allowed_files=EXACT_CONFIG_FILES if allowed_roots==ALLOWED_ROOTS else ())
+    identity=checkpoint.capture(plan['files'])
+    result={'schema':'aster-guest-entry-checkpoint.v1','checkpoint_sha256':identity,
+            'configuration_sha256':identity}
+    if plan['immutable_artifacts']:
+        result['active_process_verified']=active_binding is not None and active_binding(plan) is True
+    result.update({role+'_sha256':identity for role,identity in artifacts.items()})
+    return result
+
+
+def recover(plan, root, receipt, *, deadline, apply=False, clock=time.time,
+            allowed_roots=ALLOWED_ROOTS, artifact_roots=ARTIFACT_ROOTS):
+    validate_plan(plan,artifact_roots=artifact_roots)
+    if deadline<=clock(): raise CheckpointError('GUEST_RESTORE_DEADLINE')
+    actual=artifact_identities(plan)
+    if actual!={role:receipt[role+'_sha256'] for role in plan['immutable_artifacts']}:
+        raise CheckpointError('ENTRY_ARTIFACT_CHANGED_RECOVERY_COPY_REQUIRED')
+    checkpoint=FileCheckpoint(root,allowed_roots=allowed_roots,
+                              allowed_files=EXACT_CONFIG_FILES if allowed_roots==ALLOWED_ROOTS else ())
+    ok=checkpoint.restore(receipt['checkpoint_sha256']) if apply else checkpoint.verify(receipt['checkpoint_sha256'])
+    if deadline<=clock(): raise CheckpointError('GUEST_RESTORE_DEADLINE')
+    return {'verified':ok,'files_restored':apply,'artifact_identities_verified':True}
+
+
+def main():
+    parser=argparse.ArgumentParser()
+    parser.add_argument('action',choices=['capture','verify','restore'])
+    parser.add_argument('--plan',type=Path,required=True)
+    parser.add_argument('--checkpoint',type=Path,required=True)
+    parser.add_argument('--receipt',type=Path,required=True)
+    parser.add_argument('--deadline',type=int,required=True)
+    parser.add_argument('--effect-authorized',action='store_true')
+    parser.add_argument('--guest-id',choices=('104','110','114','115','116'),required=True)
+    args=parser.parse_args()
+    try:
+        if os.geteuid()!=0: raise CheckpointError('ROOT_REQUIRED')
+        parent=args.checkpoint.parent
+        if (parent.parent!=Path('/var/lib/local-ai-lab-entry')
+                or args.plan.parent!=parent or args.receipt.parent!=parent):
+            raise CheckpointError('CHECKPOINT_PATH_SCOPE')
+        for directory in (parent,parent.parent):
+            st=directory.lstat()
+            if not stat.S_ISDIR(st.st_mode) or st.st_uid!=0 or st.st_mode&0o077:
+                raise CheckpointError('CHECKPOINT_DIRECTORY_CUSTODY')
+        if args.action in {'capture','restore'} and not args.effect_authorized:
+            raise CheckpointError('CHECKPOINT_EFFECT_NOT_AUTHORIZED')
+        if time.time()>=args.deadline: raise CheckpointError('GUEST_RESTORE_DEADLINE')
+        plan=private_json(args.plan)
+        if args.action=='capture':
+            from lab_hours_prepare_entry_plan import current_plan
+            if plan!=current_plan(args.guest_id):
+                raise CheckpointError('LIVE_CONFIGURATION_INVENTORY_DRIFT')
+            result=capture(plan,args.checkpoint,active_binding=bind_active_llama_entry)
+            if plan['immutable_artifacts'] and result.get('active_process_verified') is not True:
+                raise CheckpointError('ACTIVE_ENTRY_IDENTITY_NOT_VERIFIED')
+            fd=os.open(args.receipt,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o600)
+            with os.fdopen(fd,'w') as stream:
+                json.dump(result,stream,sort_keys=True); stream.flush(); os.fsync(stream.fileno())
+        else:
+            result=recover(plan,args.checkpoint,private_json(args.receipt),
+                deadline=args.deadline,apply=args.action=='restore')
+            if args.action=='verify' and plan['immutable_artifacts']:
+                if bind_active_llama_entry(plan) is not True:
+                    raise CheckpointError('RESTORED_PROCESS_IDENTITY_NOT_VERIFIED')
+        print(json.dumps(result,sort_keys=True)); return 0
+    except Exception as exc:
+        # Never log paths, command-line material or file contents on failure.
+        code=str(exc) if isinstance(exc,CheckpointError) else type(exc).__name__
+        print(json.dumps({'state':'no_go','code':code},sort_keys=True)); return 1
+
+
+if __name__=='__main__': raise SystemExit(main())
