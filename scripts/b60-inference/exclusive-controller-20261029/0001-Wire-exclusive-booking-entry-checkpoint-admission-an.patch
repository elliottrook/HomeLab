+import unittest
+from lab_hours_owner_scope import OwnerScopes
+
+
+class ScopeTests(unittest.TestCase):
+    def setUp(self):
+        self.calls=[]; self.live=True
+        def runner(command,timeout):
+            self.calls.append((command,timeout))
+            if command[:2]==('systemctl','stop'): self.live=False; return 0,''
+            if command[0]=='systemd-run': return 0,''
+            if 'guardian' in command[2]:
+                return 0,'ActiveState=active\nMainPID=101\nKillMode=control-group\nRestart=no\n'
+            return 0,('LoadState=loaded\nActiveState=active\nMainPID=100\nTasksCurrent=2\n'
+                if self.live else 'LoadState=loaded\nActiveState=inactive\nMainPID=0\nTasksCurrent=0\n')
+        self.scope=OwnerScopes(runner,'b60-exclusive-20261030',clock=lambda:1000)
+
+    def test_fence_stops_only_exact_owner_and_proves_no_tasks(self):
+        self.assertTrue(self.scope.alive({})); self.assertTrue(self.scope.fence({}))
+        self.assertFalse(self.scope.alive({}))
+        self.assertEqual(self.calls[1][0],('systemctl','stop',self.scope.owner))
+
+    def test_guardian_is_independent_no_restart_and_has_bounded_lifetime(self):
+        self.assertTrue(self.scope.arm({'restore_deadline':3700},{}))
+        command=self.calls[0][0]
+        self.assertIn('--property=KillMode=control-group',command)
+        self.assertIn('--property=RuntimeMaxSec=3300',command)
+        self.assertIn('--property=Restart=no',command)
+        self.assertNotIn('PartOf=',str(command))
+
+    def test_failed_guardian_start_never_reports_armed(self):
+        self.scope.runner=lambda command,timeout:(1,'')
+        self.assertFalse(self.scope.arm({'restore_deadline':3700},{}))
+
+
+if __name__=='__main__': unittest.main()
