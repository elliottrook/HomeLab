+"""Read only current guest metadata using an explicitly staged source directory.
+
+Requires the helper packet already staged in each named guest. No checkpoint,
+activation, service operation, model request, or secret-bearing file read.
+"""
+import argparse
+import json
+import re
+import subprocess
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__); parser.add_argument('--staging',required=True)
+    args=parser.parse_args()
+    if not re.fullmatch(r'/root/b60-exclusive-probe-20261029\.[a-zA-Z0-9]+',args.staging):
+        raise SystemExit('STAGING_IDENTITY')
+    script='''import hashlib,json,sys
+sys.path.insert(0,sys.argv[1])
+from lab_hours_prepare_entry_plan import current_plan
+from lab_hours_file_checkpoint import CheckpointError
+try:
+    p=current_plan(sys.argv[2])
+    print(json.dumps({"guest":sys.argv[2],"configuration_file_count":len(p["files"]),
+        "plan_sha256":hashlib.sha256(json.dumps(p,sort_keys=True,separators=(",",":")).encode()).hexdigest(),
+        "model_runtime_bound":bool(p["immutable_artifacts"]),"configuration_contents_read":False}))
+except Exception as error:
+    print(json.dumps({"state":"no_go","failure_code":str(error) if isinstance(error,CheckpointError) else type(error).__name__}))
+    raise SystemExit(1)
+'''
+    for guest in ('104','110','114','115','116'):
+        result=subprocess.run(('pct','exec',guest,'--','python3','-B','-c',script,args.staging,guest),
+            capture_output=True,text=True,timeout=30,check=False)
+        if result.returncode:
+            try: code=json.loads(result.stdout).get('failure_code','INVENTORY_PROBE_FAILED')
+            except (ValueError,AttributeError): code='INVENTORY_PROBE_FAILED'
+            print(json.dumps({'guest':guest,'state':'no_go','failure_code':code}))
+            return 1
+        value=json.loads(result.stdout)
+        print(json.dumps(value,sort_keys=True))
+    return 0
+
+
+if __name__=='__main__': raise SystemExit(main())
