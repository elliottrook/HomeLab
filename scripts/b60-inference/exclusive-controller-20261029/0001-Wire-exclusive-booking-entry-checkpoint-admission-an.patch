+"""Explicit no-catch-up rearm for declared calendar timers only.
+
+systemd.timer documents clean --what=state for its persistent timestamp cache.
+This records a deliberately skipped interval, never a successful application job.
+Monotonic/boot-triggered timers require a separate reviewed resume policy.
+"""
+from __future__ import annotations
+
+from lab_hours_unit_adapter import UnitStateError
+
+
+class CalendarTimerResume:
+    def __init__(self, units): self.units=units; self.skipped=[]
+
+    def __call__(self,row,deadline):
+        if not row['unit'].endswith('.timer') or row['active']!='active':
+            raise UnitStateError('TIMER_RESUME_IDENTITY')
+        observed=self.units.observe(row['guest'],row['unit'],deadline)
+        if observed['ActiveState']!='inactive':
+            raise UnitStateError('TIMER_MUST_BE_STOPPED_BEFORE_REARM')
+        code,output=self.units.call(row['guest'],row['unit'],('show','--no-pager',
+            '--property=Persistent,TimersCalendar,TimersMonotonic'),deadline)
+        if code: raise UnitStateError('TIMER_RESUME_OBSERVATION')
+        fields={line.partition('=')[0]:line.partition('=')[2] for line in output.splitlines()}
+        if (set(fields)!={'Persistent','TimersCalendar','TimersMonotonic'}
+                or fields['Persistent'] not in {'yes','no'}
+                or not fields['TimersCalendar']
+                or fields['TimersMonotonic'] not in {'','[]'}):
+            raise UnitStateError('TIMER_RESUME_PROFILE_UNSUPPORTED')
+        if fields['Persistent']=='yes':
+            self.units.effect(row,('clean','--what=state'),deadline)
+            self.skipped.append({'guest':row['guest'],'unit':row['unit'],
+                'policy':'skip-missed-calendar-events','job_success_claimed':False})
+        return True
