index 000000000..bb7b1756d
--- /dev/null
+++ b/scripts/local-ai/lab_hours_exclusive_cli.py
@@ -0,0 +1,106 @@
+"""Host-local exclusive entry-restore qualification. Dormant until installed.
+
+run/watch/recover accept only the named private activation profile, never a
+command, model or path supplied through the reservation ledger.
+"""
+from __future__ import annotations
+import argparse
+import json
+import os
+from pathlib import Path
+import subprocess
+import time
+
+from lab_hours_exclusive_session import ExclusiveSession,SessionStore,SessionError,IDENTITY
+from lab_hours_exclusive_profile import load_profile
+from lab_hours_exclusive_admission import FreshAdmission
+from lab_hours_exclusive_guardian import guard
+from lab_hours_proxmox_adapter import ProxmoxEntryAdapter
+from lab_hours_owner_scope import OwnerScopes
+from lab_hours_reservations import ReservationStore
+
+ROOT=Path('/var/lib/local-ai-lab')
+PACKAGE=Path('/usr/local/libexec/local-ai-lease/exclusive-session')
+
+
+def runner(command,timeout):
+    # Never print/return stderr; errors can contain source-local configuration.
+    result=subprocess.run(command,capture_output=True,text=True,timeout=timeout,check=False)
+    return result.returncode,result.stdout
+
+
+def context(booking_id):
+    if not IDENTITY.fullmatch(booking_id): raise SessionError('CLI_BOOKING_IDENTITY')
+    if os.geteuid()!=0 or os.uname().sysname!='Linux' or os.uname().nodename!='proxmox':
+        raise SessionError('PROXMOX_ROOT_REQUIRED')
+    profile=load_profile(ROOT/'exclusive-activations'/(booking_id+'.json'),PACKAGE)
+    if profile['booking_id']!=booking_id: raise SessionError('ACTIVATION_BOOKING_MISMATCH')
+    store=SessionStore(ROOT/'exclusive-sessions'/booking_id,expected_uid=0)
+    bookings=ReservationStore(ROOT/'reservations',expected_uid=0)
+    scopes=OwnerScopes(runner,booking_id)
+    adapter=ProxmoxEntryAdapter(store,bookings,profile,runner=runner,
+        admission=FreshAdmission(runner,store),arm_guardian=scopes.arm)
+    return profile,store,bookings,scopes,adapter
+
+
+def operate(action,booking_id):
+    profile,store,bookings,scopes,adapter=context(booking_id)
+    session=ExclusiveSession(store,adapter)
+    try:
+        if action=='validate':
+            return {'state':'static-profile-valid','armed':False,'qualification_only':True}
+        if action=='launch':
+            booking=bookings.get(booking_id); now=int(time.time())
+            if (booking.get('owner')!=profile['owner'] or booking.get('kind')!='exclusive-stack'
+                    or booking.get('state')!='reserved'
+                    or not booking['start_epoch']<=now<=booking['start_epoch']+120):
+                raise SessionError('LAUNCH_BOOKING_WINDOW')
+            command=('systemd-run','--quiet','--unit='+scopes.owner,
+                '--property=Type=exec','--property=User=root',
+                '--property=KillMode=control-group','--property=Restart=no',
+                '--property=TimeoutStopSec=30',
+                '--property=RuntimeMaxSec='+str(booking['end_epoch']-now+300),
+                '/usr/bin/python3','-B',str(PACKAGE/'lab_hours_exclusive_cli.py'),
+                'run','--booking-id',booking_id)
+            if runner(command,15)[0]: raise SessionError('OWNER_LAUNCH_FAILED')
+            return {'state':'owner-launched','booking_id':booking_id,'qualification_only':True}
+        if action=='watch':
+            return guard(store,adapter,owner=profile['owner'],
+                         owner_alive=scopes.alive,fence_owner=scopes.fence)
+        if action=='recover':
+            if not scopes.fence({}): raise SessionError('OWNER_SCOPE_NOT_FENCED')
+            return session.recover(owner=profile['owner'])
+        if action!='run': raise SessionError('CLI_ACTION_INVALID')
+        fields=scopes._show()
+        if fields.get('MainPID')!=str(os.getpid()) or not scopes.alive({}):
+            raise SessionError('RUN_NOT_IN_EXACT_OWNER_SCOPE')
+        try:
+            session.begin(bookings.get(booking_id),owner=profile['owner'],
+                          trial_seconds=profile['trial_seconds'])
+            return session.run_trial(owner=profile['owner'])
+        except Exception:
+            # The guardian independently survives this owner. Best-effort local
+            # recovery is attempted once too, but failure is never a retry of
+            # admission or a model experiment.
+            if (store.root/'session.json').exists():
+                session.recover(owner=profile['owner'])
+            raise
+    finally: adapter.boundary.close()
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('action',choices=('validate','launch','run','watch','recover'))
+    parser.add_argument('--booking-id',required=True)
+    args=parser.parse_args()
+    try:
+        result=operate(args.action,args.booking_id)
+        print(json.dumps(result,sort_keys=True)); return 0
+    except Exception as error:
+        # Fixed codes only; no exception string from subprocess, JSON, OS or
+        # configuration handling may leak into an AI-visible journal.
+        code=str(error) if isinstance(error,SessionError) else type(error).__name__
+        print(json.dumps({'state':'no_go','failure_code':code},sort_keys=True)); return 1
+
+
+if __name__=='__main__': raise SystemExit(main())
