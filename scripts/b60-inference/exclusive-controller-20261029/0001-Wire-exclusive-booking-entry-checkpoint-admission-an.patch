--- /dev/null
+++ b/scripts/local-ai/lab_hours_owner_scope.py
@@ -0,0 +1,56 @@
+"""Independent host-local owner/watchdog systemd scopes with exact names."""
+from __future__ import annotations
+import time
+from lab_hours_exclusive_session import IDENTITY,SessionError
+
+
+class OwnerScopes:
+    def __init__(self,runner,booking_id,*,clock=time.time):
+        if not IDENTITY.fullmatch(booking_id): raise SessionError('OWNER_SCOPE_IDENTITY')
+        self.runner,self.booking_id,self.clock=runner,booking_id,clock
+        self.owner='b60-exclusive-owner-'+booking_id+'.service'
+        self.guardian='b60-exclusive-guardian-'+booking_id+'.service'
+
+    def _show(self):
+        code,raw=self.runner(('systemctl','show',self.owner,'--no-pager',
+            '--property=LoadState,ActiveState,MainPID,TasksCurrent'),10)
+        if len(raw)>4096: raise SessionError('OWNER_SCOPE_OBSERVATION')
+        fields=dict(line.split('=',1) for line in raw.splitlines() if '=' in line)
+        if code or set(fields)!={'LoadState','ActiveState','MainPID','TasksCurrent'}:
+            raise SessionError('OWNER_SCOPE_OBSERVATION')
+        return fields
+
+    def alive(self,state):
+        fields=self._show()
+        return (fields['LoadState']=='loaded' and fields['ActiveState'] in {'active','activating'}
+            and fields['MainPID'].isdigit() and int(fields['MainPID'])>0
+            and fields['TasksCurrent'].isdigit() and int(fields['TasksCurrent'])>0)
+
+    def fence(self,state):
+        # No restart and no wildcard kill. systemd owns the exact cgroup and
+        # KillMode=control-group is required by the launcher.
+        code,_=self.runner(('systemctl','stop',self.owner),30)
+        if code: return False
+        fields=self._show()
+        return (fields['ActiveState'] in {'inactive','failed'} and fields['MainPID']=='0'
+                and fields['TasksCurrent'] in {'0','','[not set]'})
+
+    def arm(self,state,profile):
+        remaining=int(state['restore_deadline']-self.clock())
+        if remaining<=900: raise SessionError('GUARDIAN_RECOVERY_WINDOW')
+        # A fixed installed entry point, never a command from the reservation.
+        command=('systemd-run','--quiet','--unit='+self.guardian,
+            '--property=Type=exec','--property=KillMode=control-group',
+            '--property=Restart=no','--property=TimeoutStopSec=30',
+            '--property=RuntimeMaxSec='+str(remaining+600),
+            '/usr/bin/python3','-B',
+            '/usr/local/libexec/local-ai-lease/exclusive-session/lab_hours_exclusive_cli.py',
+            'watch','--booking-id',self.booking_id)
+        code,_=self.runner(command,15)
+        if code: return False
+        code,raw=self.runner(('systemctl','show',self.guardian,'--no-pager',
+            '--property=ActiveState,MainPID,KillMode,Restart'),10)
+        fields=dict(line.split('=',1) for line in raw.splitlines() if '=' in line)
+        return (code==0 and fields.get('ActiveState')=='active'
+            and fields.get('MainPID','').isdigit() and int(fields['MainPID'])>0
+            and fields.get('KillMode')=='control-group' and fields.get('Restart')=='no')
diff --git a/scripts/local-ai/lab_hours_prepare_entry_plan.py b/scripts/local-ai/lab_hours_prepare_entry_plan.py
new file mode 100644
index 000000000..9ac0134b6
--- /dev/null
+++ b/scripts/local-ai/lab_hours_prepare_entry_plan.py
@@ -0,0 +1,100 @@
+"""Prepare content-free guest-local plans; no configuration bytes are copied.
+
+The executable endpoint is metadata-only. Actual recovery copies are created
+later, after booked admission; secrets remain in the same protected guest.
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+
+from lab_hours_unit_adapter import SCOPE
+from lab_hours_guest_checkpoint import (active_llama_artifacts,ALLOWED_ROOTS,
+    EXACT_CONFIG_FILES,validate_plan)
+from lab_hours_file_checkpoint import FileCheckpoint,CheckpointError
+
+
+def configuration_files(raw):
+    files=set(); fragments=0
+    for line in raw.splitlines():
+        key,sep,value=line.partition('=')
+        if not sep: raise CheckpointError('CONFIGURATION_METADATA_MALFORMED')
+        if key=='FragmentPath':
+            if not value: raise CheckpointError('CONFIGURATION_FRAGMENT_MISSING')
+            fragments+=1; files.add(value)
+        elif key=='DropInPaths': files.update(value.split())
+        elif key=='EnvironmentFiles':
+            if value:
+                match=re.fullmatch(r'(/[^\s]+) \(ignore_errors=(?:yes|no)\)',value)
+                if not match: raise CheckpointError('ENVIRONMENT_PATH_METADATA_UNSUPPORTED')
+                files.add(match[1])
+        else: raise CheckpointError('CONFIGURATION_METADATA_UNSUPPORTED')
+    if fragments!=1: raise CheckpointError('CONFIGURATION_FRAGMENT_AMBIGUOUS')
+    # Pure lexical scope validation here permits offline cross-platform tests.
+    # The guest-local checkpoint independently rejects symlink targets/parents
+    # using its actual Linux filesystem immediately before copying anything.
+    for raw_path in files:
+        path=Path(raw_path)
+        if (not path.is_absolute() or '..' in path.parts
+                or (path not in EXACT_CONFIG_FILES
+                    and not any(root in path.parents for root in ALLOWED_ROOTS))):
+            raise CheckpointError('TARGET_OUTSIDE_DECLARED_SCOPE')
+    return files
+
+
+def current_plan(guest,*,runner=None,artifacts=None):
+    if runner is None:
+        def runner(command):
+            result=subprocess.run(command,capture_output=True,text=True,timeout=10,check=False)
+            if result.returncode: raise CheckpointError('CONFIGURATION_METADATA_FAILED')
+            return result.stdout
+    units=sorted(unit for owner,unit in SCOPE if owner==guest)
+    if not units: raise CheckpointError('GUEST_PLAN_SCOPE')
+    files=set()
+    for unit in units:
+        raw=runner(('systemctl','show',unit,'--no-pager',
+                    '--property=FragmentPath,DropInPaths,EnvironmentFiles'))
+        if len(raw)>32768: raise CheckpointError('CONFIGURATION_METADATA_OVERSIZED')
+        files.update(configuration_files(raw))
+    plan={'schema':'aster-guest-entry-plan.v1','files':sorted(files),
+          'immutable_artifacts':(active_llama_artifacts() if artifacts is None else artifacts)
+                                if guest=='110' else {}}
+    validate_plan(plan)
+    return plan
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--guest-id',choices=('104','110','114','115','116'),required=True)
+    parser.add_argument('--booking-id',required=True)
+    args=parser.parse_args()
+    try:
+        if os.geteuid()!=0 or not re.fullmatch(r'b60-exclusive-\d{8}',args.booking_id):
+            raise CheckpointError('PREPARATION_IDENTITY')
+        plan=current_plan(args.guest_id)
+        data=json.dumps(plan,sort_keys=True,separators=(',',':')).encode()
+        root=Path('/var/lib/local-ai-lab-entry'); root.mkdir(mode=0o700,exist_ok=True)
+        parent=root/args.booking_id; parent.mkdir(mode=0o700,exist_ok=True)
+        for directory in (root,parent):
+            info=directory.lstat()
+            if directory.is_symlink() or info.st_uid!=0 or info.st_mode&0o077:
+                raise CheckpointError('PLAN_DIRECTORY_CUSTODY')
+        target=parent/'plan.json'
+        fd=os.open(target,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o600)
+        with os.fdopen(fd,'wb') as stream:
+            stream.write(data); stream.flush(); os.fsync(stream.fileno())
+        fd=os.open(parent,os.O_RDONLY)
+        try: os.fsync(fd)
+        finally: os.close(fd)
+        print(json.dumps({'state':'prepared','plan_sha256':hashlib.sha256(data).hexdigest(),
+                          'configuration_contents_copied':False})); return 0
+    except Exception as error:
+        code=str(error) if isinstance(error,CheckpointError) else type(error).__name__
+        print(json.dumps({'state':'no_go','code':code})); return 1
+
+
+if __name__=='__main__': raise SystemExit(main())
diff --git a/scripts/local-ai/lab_hours_proxmox_adapter.py b/scripts/local-ai/lab_hours_proxmox_adapter.py
new file mode 100644
index 000000000..f8146c43d
--- /dev/null
+++ b/scripts/local-ai/lab_hours_proxmox_adapter.py
@@ -0,0 +1,211 @@
+"""Combined Proxmox adapter for a protected, source-pinned session profile.
+
+No code runs at import. Session.begin enforces the booked interval before
+calling admission. Guest checkpoint contents stay guest-local.
+"""
+from __future__ import annotations
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import time
+
+from lab_hours_exclusive_session import canonical,SessionError
+from lab_hours_exclusive_boundary import ExclusiveHostBoundary
+from lab_hours_unit_adapter import ProxmoxUnitAdapter
+from lab_hours_timer_resume import CalendarTimerResume
+
+
+class ProxmoxEntryAdapter:
+    def __init__(self,store,bookings,profile,*,runner,admission,arm_guardian,
+                 clock=time.time,root=Path('/var/lib/local-ai-lab'),
+                 operation=Path('/run/local-ai-lab-operation.lock'),gpu_users=None):
+        self.store,self.bookings,self.profile=store,bookings,profile
+        self.runner,self.admission,self.arm=runner,admission,arm_guardian
+        self.clock=clock
+        self.units=ProxmoxUnitAdapter(runner,clock=clock)
+        self.timers=CalendarTimerResume(self.units)
+        self.boundary=ExclusiveHostBoundary(root,operation,bookings,ready=self._ready)
+        self.private=None
+        self.gpu_users=gpu_users
+
+    def _call(self,command,deadline,maximum=120):
+        remaining=deadline-self.clock()
+        if remaining<=0: raise SessionError('HOST_ADAPTER_DEADLINE')
+        code,output=self.runner(tuple(command),min(maximum,remaining))
+        if code: raise SessionError('HOST_ADAPTER_COMMAND_FAILED')
+        return output
+
+    def _ready(self):
+        code,output=self.runner(('/usr/local/sbin/local-ai-lease','status'),10)
+        try: value=json.loads(output)
+        except (TypeError,ValueError): return False
+        return code==0 and value in ('ready',{'state':'ready'})
+
+    def _guest(self,guest,action,deadline):
+        booking=self.private['booking_id']
+        parent='/var/lib/local-ai-lab-entry/'+booking
+        for name in ('lab_hours_guest_checkpoint.py','lab_hours_file_checkpoint.py',
+                     'lab_hours_unit_adapter.py','lab_hours_prepare_entry_plan.py'):
+            path='/usr/local/libexec/local-ai-lease/entry-checkpoint/'+name
+            raw=self._call(('pct','exec',guest,'--','sha256sum',path),deadline,10)
+            if raw.split()[:1]!=[self.profile['source_sha256'][name]]:
+                raise SessionError('GUEST_CHECKPOINT_SOURCE_DRIFT')
+        command=('pct','exec',guest,'--','/usr/bin/python3','-B',
+            '/usr/local/libexec/local-ai-lease/entry-checkpoint/lab_hours_guest_checkpoint.py',
+            action,'--guest-id',guest,'--plan',parent+'/plan.json','--checkpoint',parent+'/files',
+            '--receipt',parent+'/receipt.json','--deadline',str(int(deadline)))
+        if action in {'capture','restore'}: command+=('--effect-authorized',)
+        try: value=json.loads(self._call(command,deadline))
+        except ValueError: raise SessionError('GUEST_RECEIPT_MALFORMED') from None
+        if not isinstance(value,dict) or value.get('state')=='no_go':
+            raise SessionError('GUEST_CHECKPOINT_FAILED')
+        return value
+
+    def _mount_identity(self,deadline):
+        raw=self._call(('pct','config','110','--current'),deadline,10)
+        # Raw configuration never leaves the root-local adapter. A workload in
+        # this release may add no mount/device changes; drift blocks release.
+        rows=[line for line in raw.splitlines() if
+              line.startswith(('mp','rootfs:','dev','lxc.mount','lxc.cgroup'))]
+        return hashlib.sha256('\n'.join(sorted(rows)).encode()).hexdigest()
+
+    def admit(self,booking):
+        self.boundary.prepare()
+        try:
+            if self.admission(booking,self.profile) is not True:
+                raise SessionError('SOURCE_ADMISSION_FAILED')
+            self.private={'schema':'aster-proxmox-entry.v1','booking_id':booking['booking_id'],
+                'owner':booking['owner'],'end_epoch':booking['end_epoch'],
+                'claimant':'b60-'+hashlib.sha256(booking['booking_id'].encode()).hexdigest()[:20]}
+            return True
+        except BaseException:
+            self.boundary.close(); raise
+
+    def capture(self):
+        deadline=self.private['end_epoch']-900
+        rows=self.units.capture([tuple(row) for row in self.profile['units']],deadline)
+        receipts={guest:self._guest(guest,'capture',deadline) for guest in self.profile['guest_plans']}
+        main=receipts['110']
+        if main.get('active_process_verified') is not True:
+            raise SessionError('ENTRY_MODEL_PROCESS_NOT_BOUND')
+        self.private.update(units=rows,guest_receipts=receipts,
+                            mount_identity=self._mount_identity(deadline),profile=self.profile)
+        self.store.write('adapter.json',self.private,immutable=True)
+        configuration=hashlib.sha256(canonical({'units':rows,'receipts':receipts})).hexdigest()
+        return {'schema':'aster-entry-snapshot.v1','model_sha256':main['model_sha256'],
+            'runtime_sha256':main['runtime_sha256'],'configuration_sha256':configuration,
+            'checkpoint_sha256':hashlib.sha256(canonical(self.private)).hexdigest(),
+            'units':[{'guest':r['guest'],'unit':r['unit'],'active':r['active']!='inactive',
+                      'enabled':r['enablement'] in {'enabled','enabled-runtime'},
+                      'runtime_masked':r['enablement']=='masked-runtime'} for r in rows],
+            'mounts':[{'identity_sha256':self.private['mount_identity'],'present':True,'readonly':False}]}
+
+    def verify_checkpoint(self,entry):
+        if self.private is None: self.private=self.store.read('adapter.json')
+        if hashlib.sha256(canonical(self.private)).hexdigest()!=entry['checkpoint_sha256']:
+            return False
+        return all(self._guest(g,'verify',self.private['end_epoch']-900).get('verified') is True
+                   for g in self.profile['guest_plans'])
+
+    def arm_guardian(self,state):
+        # The independent watchdog is started before the durable claim. Its
+        # entry point must distinguish unclaimed/no-effects from claimed work.
+        if self.arm(state,self.profile) is not True: return False
+        binding=self.boundary.claim(state['booking_id'],owner=state['owner'],
+            claimant=self.private['claimant'],entry_sha256=state['entry_sha256'])
+        self.private['binding']=binding
+        self.store.write('adapter.json',self.private)
+        return True
+
+    def isolate(self,state):
+        if self.units.isolate(self.private['units'],state['trial_deadline']) is not True:
+            return False
+        if self.gpu_users is not None: return not self.gpu_users()
+        from full_inference_lab_runtime import _gpu_users
+        return not _gpu_users()
+
+    def execute(self,state,deadline):
+        experiment=self.profile.get('experiment')
+        if experiment is None:
+            return True  # Explicit restore-only qualification, not a model result.
+        path=experiment['guest_script']; expected=experiment['sha256']
+        raw=self._call(('pct','exec','110','--','sha256sum',path),deadline,30)
+        if raw.split()[0]!=expected: raise SessionError('TRIAL_SOURCE_DRIFT')
+        unit='b60-exclusive-trial-'+state['booking_id']+'.service'
+        command=('pct','exec','110','--','systemd-run','--quiet','--wait','--collect',
+            '--unit='+unit,'--property=KillMode=control-group',
+            '--property=RuntimeMaxSec='+str(max(1,int(deadline-self.clock()))),
+            '/usr/bin/python3','-B',path,'--booking-id',state['booking_id'],
+            '--deadline',str(int(deadline)))
+        # Do not echo model output. Synthetic/private captures remain guest-local.
+        self._call(command,deadline,maximum=1800)
+        return True
+
+    def _load(self):
+        if self.private is None: self.private=self.store.read('adapter.json')
+        self.profile=self.private['profile']
+        if self.boundary.exclusion is None:
+            self.boundary.resume(self.private['binding'])
+
+    def prepare_recovery(self,state):
+        if state['phase']!='checkpointed': return 'claimed'
+        if self.private is None: self.private=self.store.read('adapter.json')
+        binding={'schema':'aster-exclusive-host-binding.v1',
+            'booking_id':state['booking_id'],'owner':state['owner'],
+            'claimant':self.private['claimant'],'entry_sha256':state['entry_sha256']}
+        result=self.boundary.reconcile_checkpointed(binding)
+        if result=='claimed' and self.private.get('binding')!=binding:
+            # Covers a crash after the ledger claim but before adapter.json was
+            # updated. Both canonical markers and the ledger were just checked.
+            self.private['binding']=binding
+            self.store.write('adapter.json',self.private)
+        return result
+
+    def fence_experiments(self,state):
+        self._load()
+        deadline=max(state['restore_deadline'],self.clock()+300)
+        unit='b60-exclusive-trial-'+state['booking_id']+'.service'
+        self.runner(('pct','exec','110','--','systemctl','stop',unit),min(30,deadline-self.clock()))
+        code,raw=self.runner(('pct','exec','110','--','systemctl','show',unit,
+                       '--property=LoadState,MainPID,TasksCurrent'),min(10,deadline-self.clock()))
+        if len(raw)>4096: return False
+        fields=dict(line.split('=',1) for line in raw.splitlines() if '=' in line)
+        absent=code in {0,1} and fields.get('LoadState')=='not-found'
+        empty=code==0 and fields.get('MainPID')=='0' and fields.get('TasksCurrent') in {'','0','[not set]'}
+        if not absent and not empty: return False
+        # Re-entry may interrupt a partial restoration. Quiesce every declared
+        # caller/timer again before recovering configuration bytes, not just
+        # the backend. This also leaves calendar timers stopped for safe
+        # no-catch-up rearm after an interrupted previous start sequence.
+        if self.units.isolate(self.private['units'],deadline) is not True: return False
+        if self.gpu_users is None:
+            from full_inference_lab_runtime import _gpu_users
+            return not _gpu_users()
+        return not self.gpu_users()
+
+    def restore(self,entry,deadline):
+        self._load()
+        if self._mount_identity(deadline)!=self.private['mount_identity']:
+            raise SessionError('MOUNT_DRIFT_REQUIRES_DECLARED_RECOVERY')
+        for guest in self.profile['guest_plans']:
+            if self._guest(guest,'restore',deadline).get('verified') is not True: return False
+        return self.units.restore(self.private['units'],deadline,
+            configuration_restored=True,timer_resume_safe=self.timers)
+
+    def verify_entry(self,entry):
+        self._load(); deadline=max(self.private['end_epoch'],self.clock()+120)
+        if self._mount_identity(deadline)!=self.private['mount_identity']: return False
+        if not self.units.verify(self.private['units'],deadline): return False
+        for guest in self.profile['guest_plans']:
+            if self._guest(guest,'verify',deadline).get('verified') is not True: return False
+        if any(r['guest']=='110' and r['unit']=='aster-llama.service' and r['active']=='active'
+               for r in self.private['units']):
+            self._call(('pct','exec','110','--','/usr/local/sbin/aster-llama-production-auth-probe'),deadline,30)
+        return True
+
+    def release(self,state):
+        entry=self.store.read('entry.json')
+        return self.boundary.release(self.private['binding'],
+            verify_restored=lambda:self.verify_entry(entry),
+            success=not state.get('deadline_missed',False) and not state.get('trial_failed',True))
diff --git a/scripts/local-ai/lab_hours_reservations.py b/scripts/local-ai/lab_hours_reservations.py
index a3be86474..cbb72b91f 100644
--- a/scripts/local-ai/lab_hours_reservations.py
+++ b/scripts/local-ai/lab_hours_reservations.py
@@ -186,6 +186,23 @@ class ReservationStore:
             self._write_unlocked(value)
             return value
 
+    def claim_exclusive(self, booking_id, *, owner, claimant, entry_sha256):
+        """Claim capacity only through the entry-checkpoint controller."""
