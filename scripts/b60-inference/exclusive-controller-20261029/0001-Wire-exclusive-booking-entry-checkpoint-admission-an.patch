+
+class Store:
+    def __init__(self): self.rows={}
+    def write(self,name,value,**kwargs): self.rows[name]=value
+
+
+class AdmissionTests(unittest.TestCase):
+    def setUp(self):
+        self.now=int(datetime(2026,10,30,3,10,tzinfo=ZoneInfo('America/Vancouver')).timestamp())
+        self.booking={'booking_id':'b60-exclusive-20261030','start_epoch':self.now,
+                      'end_epoch':self.now+2700}
+        self.profile={'owner':'b60-stream-a','trial_seconds':300,
+                      'guest_plans':{g:'a'*64 for g in ('104','110','114','115','116')}}
+        self.commands=[]; self.store=Store(); self.whole=True; self.proof=True
+        def runner(command,timeout):
+            self.commands.append(command)
+            if command[0]=='readlink':
+                return 0,'/sys/x/xe' if command[-1].endswith('/driver') else '/sys/x/0000:04:00.0'
+            if command[0]=='cat': return 0,'0xe211'
+            if command[0]=='awk': return 0,str(8*1024*1024)
+            if command[0]=='df': return 0,'Avail\n'+str(30*1024**3)
+            if 'sha256sum' in command: return 0,'a'*64+'  plan.json'
+            if '--property=Triggers' in command:
+                return 0,TRIGGERS[command[2]][command[6]]
+            return 0,'{}'
+        self.admission=FreshAdmission(runner,self.store,clock=lambda:self.now,
+            backup=lambda **kwargs:SimpleNamespace(source_observed=True,
+                integrity_verified=self.proof,integrity_receipt='retained-archive-integrity-sha256:'+'b'*64),
+            whole_job=lambda cycle:self.whole,gpu_users=lambda:())
+
+    def test_observed_backup_and_actual_fixed_sources_create_hash_only_receipt(self):
+        self.assertTrue(self.admission(self.booking,self.profile))
+        self.assertTrue(self.store.rows['admission.json']['qualification_only'])
+        self.assertFalse(any('zstd' in command for command in self.commands))
+
+    def test_archive_integrity_cannot_be_substituted_with_success_flag(self):
+        self.proof=False
+        with self.assertRaisesRegex(SessionError,'ARCHIVE'): self.admission(self.booking,self.profile)
+        self.assertFalse(self.store.rows)
+
+    def test_whole_job_failure_is_not_masked_by_three_artifacts(self):
+        self.whole=False
+        with self.assertRaisesRegex(SessionError,'WHOLE_BACKUP'): self.admission(self.booking,self.profile)
+        self.assertFalse(self.store.rows)
+
+    def test_late_invocation_never_probes_or_claims(self):
+        self.now+=121
+        with self.assertRaisesRegex(SessionError,'WINDOW'): self.admission(self.booking,self.profile)
+        self.assertEqual(self.commands,[])
+
+    def test_surprise_gpu_holder_cannot_admit(self):
+        self.admission.gpu_users=lambda:(SimpleNamespace(cgroup='/unrelated/user'),)
+        with self.assertRaisesRegex(SessionError,'UNDECLARED'): self.admission(self.booking,self.profile)
+        self.assertFalse(self.store.rows)
+
+
+if __name__=='__main__': unittest.main()
