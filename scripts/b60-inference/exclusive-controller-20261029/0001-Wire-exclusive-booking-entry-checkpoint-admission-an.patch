@@ -0,0 +1,138 @@
+"""Combined durable booking/lease/file/unit/controller integration fixtures."""
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+from lab_hours_proxmox_adapter import ProxmoxEntryAdapter
+from lab_hours_exclusive_session import ExclusiveSession,SessionStore,SessionError
+from lab_hours_reservations import ReservationStore
+from lab_hours_guest_checkpoint import capture,recover
+from test_lab_hours_unit_adapter import Systemd
+
+
+class HostRunner(Systemd):
+    def __call__(self,command,timeout):
+        if command==('/usr/local/sbin/local-ai-lease','status'): return 0,'{"state":"ready"}'
+        if command[-1]=='/usr/local/sbin/aster-llama-production-auth-probe': return 0,''
+        if any('b60-exclusive-trial-' in word for word in command):
+            return (1,'LoadState=not-found\n') if 'show' in command else (0,'')
+        if any('Persistent,TimersCalendar' in word for word in command):
+            return 0,'Persistent=yes\nTimersCalendar={ calendar }\nTimersMonotonic=\n'
+        return super().__call__(command,timeout)
+
+
+class Adapter(ProxmoxEntryAdapter):
+    def _mount_identity(self,deadline): return 'a'*64
+    def _guest(self,guest,action,deadline):
+        options={'allowed_roots':(self.fixture,),'artifact_roots':(self.fixture,)}
+        if action=='capture':
+            self.receipt=capture(self.plan,self.fixture/'checkpoint',active_binding=lambda plan:True,**options)
+            return self.receipt
+        return recover(self.plan,self.fixture/'checkpoint',self.receipt,
+            deadline=deadline,clock=self.clock,apply=action=='restore',**options)
+
+
+class CombinedAdapterTests(unittest.TestCase):
+    def setUp(self):
+        self.temp=tempfile.TemporaryDirectory(); self.addCleanup(self.temp.cleanup)
+        self.root=Path(self.temp.name).resolve(); self.host=self.root/'host'; self.host.mkdir(mode=0o700)
+        self.store=SessionStore(self.root/'session')
+        self.bookings=ReservationStore(self.host/'reservations',clock=lambda:1000)
+        self.booking=self.bookings.reserve(booking_id='b60-exclusive-20261030',owner='b60-stream-a',
+            exclusive=True,start_epoch=1000,end_epoch=3700)
+        self.runner=HostRunner()
+        self.profile={'units':list(self.runner.units),'guest_plans':{'110':{}},'experiment':None}
+        self.adapter=Adapter(self.store,self.bookings,self.profile,runner=self.runner,
+            admission=lambda booking,profile:True,arm_guardian=lambda state,profile:True,
+            clock=lambda:1000,root=self.host,operation=self.root/'operation.lock',gpu_users=lambda:())
+        self.addCleanup(self.adapter.boundary.close)
+        self.adapter.fixture=self.root/'guest'; self.adapter.fixture.mkdir()
+        model=self.adapter.fixture/'model.gguf'; model.write_bytes(b'entry weights')
+        binary=self.adapter.fixture/'llama-server'; binary.write_bytes(b'entry runtime')
+        self.config=self.adapter.fixture/'service.conf'; self.config.write_bytes(b'entry configuration')
+        self.adapter.plan={'schema':'aster-guest-entry-plan.v1','files':[str(self.config)],
+            'immutable_artifacts':{'model':str(model),'runtime':str(binary)}}
+        self.session=ExclusiveSession(self.store,self.adapter,clock=lambda:1000)
+
+    def test_full_transaction_combines_booking_claim_checkpoint_drain_restore_release(self):
+        self.session.begin(self.booking,owner='b60-stream-a')
+        self.assertEqual(self.bookings.get(self.booking['booking_id'])['state'],'claimed')
+        self.config.write_bytes(b'changed during lab')
+        result=self.session.run_trial(owner='b60-stream-a')
+        self.assertEqual(result['outcome'],'complete-restored')
+        self.assertEqual(self.config.read_bytes(),b'entry configuration')
+        self.assertEqual(self.bookings.get(self.booking['booking_id'])['state'],'complete')
+        self.assertFalse((self.root/'operation.lock').exists())
+
+    def test_unknown_gpu_holder_prevents_restore_and_retains_claim(self):
+        self.session.begin(self.booking,owner='b60-stream-a')
+        self.adapter.gpu_users=lambda:('unknown-holder',)
+        with self.assertRaisesRegex(SessionError,'FENCE_UNCERTAIN'):
+            self.session.recover(owner='b60-stream-a')
+        self.assertEqual(self.bookings.get(self.booking['booking_id'])['state'],'claimed')
+
+    def test_guardian_failure_does_not_claim_booking_or_drain(self):
+        self.adapter.arm=lambda state,profile:False
+        with self.assertRaisesRegex(SessionError,'GUARDIAN_NOT_ARMED'):
+            self.session.begin(self.booking,owner='b60-stream-a')
+        self.assertEqual(self.bookings.get(self.booking['booking_id'])['state'],'reserved')
+        self.assertFalse((self.root/'operation.lock').exists())
+
+    def test_admission_failure_leaves_no_checkpoint_or_shared_lock(self):
+        self.adapter.admission=lambda booking,profile:False
+        with self.assertRaisesRegex(SessionError,'SOURCE_ADMISSION_FAILED'):
+            self.session.begin(self.booking,owner='b60-stream-a')
+        self.assertFalse((self.store.root/'entry.json').exists())
+        self.assertFalse((self.root/'operation.lock').exists())
+
+    def test_guardian_failure_recovery_does_not_restart_unclaimed_stack(self):
+        self.adapter.arm=lambda state,profile:False
+        with self.assertRaises(SessionError): self.session.begin(self.booking,owner='b60-stream-a')
+        before=list(self.runner.calls)
+        result=self.session.recover(owner='b60-stream-a')
+        self.assertEqual(result['phase'],'aborted-before-claim')
+        self.assertFalse(result['production_restored'])
+        self.assertEqual(before,self.runner.calls)
+        self.assertEqual(self.bookings.get(self.booking['booking_id'])['state'],'reserved')
+
+    def test_crash_between_claim_and_adapter_binding_is_reconciled(self):
+        original=self.store.write
+        def crash(name,value,**options):
+            if name=='adapter.json' and 'binding' in value: raise RuntimeError('simulated loss')
+            original(name,value,**options)
+        self.store.write=crash
+        with self.assertRaises(RuntimeError): self.session.begin(self.booking,owner='b60-stream-a')
+        self.store.write=original
+        self.adapter.boundary.close(); self.adapter.private=None
+        result=self.session.recover(owner='b60-stream-a')
+        self.assertEqual(result['phase'],'released')
+        self.assertEqual(self.bookings.get(self.booking['booking_id'])['state'],'failed')
+        self.assertTrue(result['trial_failed'])
+
+    def test_failed_trial_restores_but_booking_does_not_report_success(self):
+        self.session.begin(self.booking,owner='b60-stream-a')
+        self.adapter.execute=lambda state,deadline:False
+        result=self.session.run_trial(owner='b60-stream-a')
+        self.assertEqual(result['outcome'],'failed-restored')
+        self.assertTrue(result['session']['production_restored'])
+        self.assertEqual(self.bookings.get(self.booking['booking_id'])['state'],'failed')
+
+    def test_partial_unclaimed_intent_is_removed_without_stack_effects(self):
+        self.adapter.arm=lambda state,profile:False
+        with self.assertRaises(SessionError): self.session.begin(self.booking,owner='b60-stream-a')
+        state=self.store.read('session.json')
+        binding={'schema':'aster-exclusive-host-binding.v1','booking_id':state['booking_id'],
+            'owner':state['owner'],'claimant':self.adapter.private['claimant'],
+            'entry_sha256':state['entry_sha256']}
+        lock=self.host/'lease.lock'; lock.mkdir(mode=0o700)
+        self.adapter.boundary._create(lock/'exclusive.json',binding)
+        self.adapter.boundary._create(self.root/'operation.lock',binding)
+        before=list(self.runner.calls)
+        self.assertEqual(self.session.recover(owner='b60-stream-a')['phase'],'aborted-before-claim')
+        self.assertEqual(before,self.runner.calls)
+        self.assertFalse(lock.exists())
+        self.assertFalse((self.root/'operation.lock').exists())
+
+
+if __name__=='__main__': unittest.main()
