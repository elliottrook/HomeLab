@@ -0,0 +1,68 @@
+"""Opt-in harmless systemd fixture: prove clean state skips old calendar runs.
+
+Creates only uniquely named /run timer/service fixtures and empty timestamp
+files for those names. Never references an existing application unit.
+"""
+from __future__ import annotations
+import argparse
+from datetime import datetime,timedelta,timezone
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import time
+
+
+def main():
+    parser=argparse.ArgumentParser(); parser.add_argument('--run-fixture',action='store_true')
+    if not parser.parse_args().run_fixture or os.geteuid()!=0:
+        raise RuntimeError('ROOT_AND_EXPLICIT_FIXTURE_FLAG_REQUIRED')
+    token=f'b60-no-replay-{os.getpid()}-{int(time.time())}'
+    units=Path('/run/systemd/system'); stamps=Path('/var/lib/systemd/timers')
+    names=[token+'-control',token+'-cleaned']
+    installed=[]; created_stamps=[]
+    def call(*args,check=True):
+        result=subprocess.run(['systemctl',*args],capture_output=True,text=True,timeout=15)
+        if check and result.returncode: raise RuntimeError('FIXTURE_SYSTEMD_COMMAND_FAILED')
+        return result
+    def write(path,text):
+        fd=os.open(path,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o644)
+        with os.fdopen(fd,'w') as stream: stream.write(text)
+        installed.append(path)
+    with tempfile.TemporaryDirectory(prefix=token+'-',dir='/run') as temporary:
+        root=Path(temporary); markers=[root/'control-fired',root/'cleaned-fired']
+        future=(datetime.now(timezone.utc)+timedelta(hours=1)).strftime('%H:%M:%S')
+        try:
+            for name,marker in zip(names,markers):
+                write(units/(name+'.service'),f'[Service]\nType=oneshot\nExecStart=/usr/bin/touch {marker}\n')
+                write(units/(name+'.timer'),f'[Timer]\nOnCalendar=*-*-* {future} UTC\nPersistent=true\nAccuracySec=1us\n')
+                stamp=stamps/('stamp-'+name+'.timer')
+                fd=os.open(stamp,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o644)
+                os.close(fd); created_stamps.append(stamp)
+                old=time.time()-3*86400; os.utime(stamp,(old,old))
+            call('daemon-reload')
+            call('start',names[0]+'.timer')
+            until=time.monotonic()+5
+            while not markers[0].exists() and time.monotonic()<until: time.sleep(.1)
+            if not markers[0].exists(): raise RuntimeError('POSITIVE_CATCHUP_CONTROL_DID_NOT_FIRE')
+            call('show',names[1]+'.timer','--property=LoadState','--value')
+            call('clean','--what=state',names[1]+'.timer')
+            call('start',names[1]+'.timer')
+            time.sleep(1)
+            if markers[1].exists(): raise RuntimeError('CLEANED_TIMER_REPLAYED_MISSED_EVENT')
+            if call('is-active',names[1]+'.timer').stdout.strip()!='active':
+                raise RuntimeError('CLEANED_TIMER_NOT_REARMED')
+            print(json.dumps({'state':'passed','positive_catchup_control':True,
+                'cleaned_timer_replayed':False,'cleaned_timer_active':True,
+                'ai_stack_effects':False},sort_keys=True))
+        finally:
+            for name in names:
+                call('stop',name+'.timer',name+'.service',check=False)
+                call('reset-failed',name+'.timer',name+'.service',check=False)
+            for path in installed+created_stamps:
+                if path.exists(): path.unlink()
+            call('daemon-reload')
+
+
+if __name__=='__main__': main()
