+import unittest
+from lab_hours_timer_resume import CalendarTimerResume
+from lab_hours_unit_adapter import UnitStateError
+
+
+class Units:
+    def __init__(self):
+        self.active='inactive'; self.persistent='yes'; self.monotonic=''; self.effects=[]
+    def observe(self,*args): return {'ActiveState':self.active}
+    def call(self,*args):
+        return 0,f'Persistent={self.persistent}\nTimersCalendar={{ calendar }}\nTimersMonotonic={self.monotonic}\n'
+    def effect(self,row,args,deadline): self.effects.append(args)
+
+
+class TimerResumeTests(unittest.TestCase):
+    def setUp(self):
+        self.units=Units(); self.policy=CalendarTimerResume(self.units)
+        self.row={'guest':'114','unit':'news-aggregator-ingest.timer','active':'active'}
+    def test_persistent_calendar_state_reset_is_explicitly_not_job_success(self):
+        self.assertTrue(self.policy(self.row,100))
+        self.assertEqual(self.units.effects,[('clean','--what=state')])
+        self.assertFalse(self.policy.skipped[0]['job_success_claimed'])
+    def test_nonpersistent_calendar_needs_no_cache_mutation(self):
+        self.units.persistent='no'; self.policy(self.row,100)
+        self.assertEqual(self.units.effects,[])
+    def test_active_timer_cannot_be_cleaned(self):
+        self.units.active='active'
+        with self.assertRaisesRegex(UnitStateError,'MUST_BE_STOPPED'): self.policy(self.row,100)
+        self.assertEqual(self.units.effects,[])
+    def test_monotonic_timer_is_not_silently_reinterpreted(self):
+        self.units.monotonic='{ OnBootUSec=1min }'
+        with self.assertRaisesRegex(UnitStateError,'UNSUPPORTED'): self.policy(self.row,100)
+
+
+if __name__=='__main__': unittest.main()
