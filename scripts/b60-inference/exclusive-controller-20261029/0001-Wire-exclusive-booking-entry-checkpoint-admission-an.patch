@@ -0,0 +1,90 @@
+"""Fresh fixed-source admission for the entry-restore qualification only.
+
+Reuses the platform's retained archive verifier; does not scan archives, acquire
+an alternate lease, call a model, or treat task SUCCESS as content integrity.
+"""
+from __future__ import annotations
+from datetime import datetime
+import hashlib
+import time
+from zoneinfo import ZoneInfo
+from lab_hours_exclusive_session import SessionError
+
+ZONE=ZoneInfo('America/Vancouver')
+TRIGGERS={'114':{'news-aggregator-ingest.timer':'news-aggregator-ingest.service',
+                 'news-aggregator-digest.timer':'news-aggregator-digest.service'},
+          '115':{'paperless-summary.timer':'paperless-summary.service'},
+          '116':{'epub-narration-worker.timer':'epub-narration-worker.service'}}
+
+
+class FreshAdmission:
+    def __init__(self,runner,store,*,clock=time.time,backup=None,whole_job=None,gpu_users=None):
+        self.runner,self.store,self.clock=runner,store,clock
+        self.backup,self.whole_job,self.gpu_users=backup,whole_job,gpu_users
+
+    def _call(self,command,timeout=10):
+        code,raw=self.runner(command,timeout)
+        if code or len(raw)>1024*1024: raise SessionError('FRESH_SOURCE_PROBE_FAILED')
+        return raw.strip()
+
+    def __call__(self,booking,profile):
+        now=int(self.clock()); start=booking['start_epoch']; end=booking['end_epoch']
+        if (not start<=now<=start+120 or now+profile['trial_seconds']+900>end
+                or datetime.fromtimestamp(end,ZONE).date()!=datetime.fromtimestamp(start,ZONE).date()
+                or datetime.fromtimestamp(end,ZONE).strftime('%H:%M')>='04:15'):
+            raise SessionError('FRESH_BOOKING_WINDOW_FAILED')
+        cycle=datetime.fromtimestamp(now,ZONE).strftime('%Y_%m_%d')
+        if self.backup is None:
+            from fixed_source_adapters import FixedSourceAdapters
+            self.backup=FixedSourceAdapters(self.runner,
+                clock=lambda:datetime.fromtimestamp(self.clock(),ZONE)).backup_from_retained
+        proof=self.backup(date_prefix=cycle,lease_issued_epoch=now)
+        if (proof.source_observed is not True or proof.integrity_verified is not True
+                or not proof.integrity_receipt.startswith('retained-archive-integrity-sha256:')):
+            raise SessionError('FRESH_ARCHIVE_PROOF_FAILED')
+        if self.whole_job is None:
+            from full_inference_lab_sources import (LocalProxmoxFullDrainSourceProducer,
+                AcceptedBaseline,TrustedOwnerAttestation)
+            # Only the whole-job/backup-source method is reused. No old fixed
+            # 9B consumer/model assumptions enter this generic entry capture.
+            producer=LocalProxmoxFullDrainSourceProducer(self.runner,
+                AcceptedBaseline('','',''),TrustedOwnerAttestation(profile['owner'],'booked-exclusive'),
+                wall_clock=self.clock)
+            self.whole_job=producer._backup_current
+        if self.whole_job(cycle) is not True: raise SessionError('WHOLE_BACKUP_JOB_UNPROVEN')
+        if self._call(('readlink','/sys/bus/pci/devices/0000:04:00.0/driver')).rsplit('/',1)[-1]!='xe':
+            raise SessionError('B60_DRIVER_DRIFT')
+        if self._call(('cat','/sys/bus/pci/devices/0000:04:00.0/device'))!='0xe211':
+            raise SessionError('B60_DEVICE_DRIFT')
+        if not self._call(('readlink','-f','/sys/class/drm/renderD128/device')).endswith('/0000:04:00.0'):
+            raise SessionError('B60_RENDER_NODE_DRIFT')
+        memory=self._call(('awk','/MemAvailable:/ {print $2}','/proc/meminfo'))
+        disk=self._call(('df','--output=avail','-B1','/var/lib/local-ai-lab'))
+        if (not memory.isdigit() or int(memory)<4*1024*1024
+                or not disk.split()[-1].isdigit() or int(disk.split()[-1])<20*1024**3):
+            raise SessionError('QUALIFICATION_RESOURCE_HEADROOM')
+        for guest,pin in profile['guest_plans'].items():
+            path='/var/lib/local-ai-lab-entry/'+booking['booking_id']+'/plan.json'
+            if self._call(('pct','exec',guest,'--','sha256sum',path)).split()[0]!=pin:
+                raise SessionError('GUEST_PLAN_SOURCE_DRIFT')
+        for guest,rows in TRIGGERS.items():
+            for timer,service in rows.items():
+                raw=self._call(('pct','exec',guest,'--','systemctl','show',timer,
+                                '--property=Triggers','--value'))
+                if raw!=service: raise SessionError('TIMER_CONSUMER_INVENTORY_DRIFT')
+        self._call(('pvesh','get','/version','--output-format','json'))
+        self._call(('pct','exec','110','--','/usr/local/sbin/aster-llama-production-auth-probe'),30)
+        if self.gpu_users is None:
+            from full_inference_lab_runtime import _gpu_users
+            self.gpu_users=_gpu_users
+        users=self.gpu_users()
+        if len(users)>1 or any(not u.cgroup.endswith('/lxc/110/ns/system.slice/aster-llama.service')
+                               for u in users):
+            raise SessionError('UNDECLARED_B60_CONSUMER')
+        # Receipt contains identities only. Raw command output, credentials,
+        # journal contents and process command lines never enter durable logs.
+        self.store.write('admission.json',{'schema':'aster-exclusive-admission.v1',
+            'booking_id':booking['booking_id'],'observed_epoch':now,
+            'archive_receipt':proof.integrity_receipt,'whole_backup_job_verified':True,
+            'entry_gpu_holder_count':len(users),'qualification_only':True},immutable=True)
+        return True
diff --git a/scripts/local-ai/lab_hours_exclusive_boundary.py b/scripts/local-ai/lab_hours_exclusive_boundary.py
new file mode 100644
index 000000000..e043d1cc3
--- /dev/null
+++ b/scripts/local-ai/lab_hours_exclusive_boundary.py
@@ -0,0 +1,180 @@
+"""Bind exclusive capacity to the existing host exclusion and durable locks.
+
+No model, service, timer, network or backup effect is performed here. The
+legacy lease.lock and shared operation marker survive owner loss and prevent
+supported entrypoints from admitting competing work during guardian recovery.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import stat
+
+from host_exclusion import host_exclusion
+from lab_hours_reservations import ID_RE
+
+
+class BoundaryError(RuntimeError): pass
+
+
+class ExclusiveHostBoundary:
+    def __init__(self, root, operation, bookings, *, ready):
+        self.root=Path(root); self.operation=Path(operation)
+        self.bookings=bookings; self.ready=ready; self.exclusion=None
+
+    def prepare(self):
+        self.exclusion=host_exclusion(self.root)
+        self.exclusion.__enter__()
+        try:
+            if (self.ready() is not True or (self.root/'lease.json').exists()
+                    or (self.root/'lease.lock').exists() or self.operation.exists()
+                    or (self.root/'full-inference-drain.json').exists()
+                    or (self.root/'full-inference-drain.lock').exists()):
+                raise BoundaryError('SHARED_HOST_NOT_READY')
+        except BaseException:
+            self.close(); raise
+
+    def claim(self, booking_id, *, owner, claimant, entry_sha256):
+        if self.exclusion is None: raise BoundaryError('EXCLUSION_NOT_HELD')
+        if (not ID_RE.fullmatch(booking_id) or not ID_RE.fullmatch(owner)
+                or not ID_RE.fullmatch(claimant)
+                or len(entry_sha256)!=64 or any(c not in '0123456789abcdef' for c in entry_sha256)):
+            raise BoundaryError('CLAIM_BINDING_INVALID')
+        binding={'schema':'aster-exclusive-host-binding.v1','booking_id':booking_id,
+                 'owner':owner,'claimant':claimant,'entry_sha256':entry_sha256}
+        row=self.bookings.get(booking_id)
+        now=int(self.bookings.clock())
+        if (row.get('kind')!='exclusive-stack' or row.get('state')!='reserved'
+                or row.get('owner')!=owner or not row['start_epoch']<=now<=row['start_epoch']+120):
+            raise BoundaryError('BOOKING_NOT_CLAIMABLE')
+        lock=self.root/'lease.lock'
+        lock.mkdir(mode=0o700)
+        # Durable intent precedes the booking mutation. Never erase uncertainty
+        # on a partial claim; guardian reconciliation uses this exact binding.
+        self._create(lock/'exclusive.json',binding)
+        self._create(self.operation,binding)
+        try:
+            self.bookings.claim_exclusive(booking_id,owner=owner,claimant=claimant,
+                                          entry_sha256=entry_sha256)
+        except BaseException:
+            raise BoundaryError('CLAIM_UNCERTAIN_LOCKS_RETAINED') from None
+        return binding
+
+    def _create(self,path,binding):
+        fd=os.open(path,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o600)
+        with os.fdopen(fd,'w') as stream:
+            json.dump(binding,stream,sort_keys=True); stream.flush(); os.fsync(stream.fileno())
+        fd=os.open(path.parent,os.O_RDONLY)
+        try: os.fsync(fd)
+        finally: os.close(fd)
+
+    def _read(self,path):
+        fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW)
+        try:
+            st=os.fstat(fd)
+            if (not stat.S_ISREG(st.st_mode) or st.st_uid!=os.geteuid()
+                    or st.st_nlink!=1 or stat.S_IMODE(st.st_mode)!=0o600 or st.st_size>4096):
+                raise BoundaryError('HOST_BINDING_CUSTODY')
+            return json.loads(os.read(fd,4097))
+        finally: os.close(fd)
+
+    def resume(self,binding):
+        self.exclusion=host_exclusion(self.root)
+        self.exclusion.__enter__()
+        try:
+            row=self.bookings.get(binding['booking_id'])
+            if (row.get('owner')!=binding['owner'] or row.get('claimant')!=binding['claimant']
+                    or row.get('entry_sha256')!=binding['entry_sha256']
+                    or row.get('state') not in {'claimed','complete','failed'}):
+                raise BoundaryError('BOOKING_BINDING_MISMATCH')
+            if (self.root/'lease.json').exists():
+                raise BoundaryError('OTHER_MANUAL_LEASE_PRESENT')
+            self._require_binding(binding,row)
+        except BaseException:
+            self.close(); raise
+
+    def reconcile_checkpointed(self,binding):
+        """Resolve owner loss before the durable 'guardian-armed' phase.
+
+        No stack effect can have occurred in this phase. A complete claim is
+        recovered normally; an unclaimed intent is cleaned only under the
+        shared exclusion and only if every extant marker belongs to us.
+        """
+        if self.exclusion is None:
+            self.exclusion=host_exclusion(self.root)
+            self.exclusion.__enter__()
+        row=self.bookings.get(binding['booking_id'])
+        if row.get('state')=='claimed':
+            self._require_binding(binding,row)
+            return 'claimed'
+        if row.get('state')!='reserved' or row.get('owner')!=binding['owner']:
+            raise BoundaryError('PRE_EFFECT_BOOKING_DRIFT')
+        paths=(self.operation,self.root/'lease.lock'/'exclusive.json')
+        present=[p for p in paths if p.exists()]
+        if present:
+            if (self.root/'lease.json').exists() or any(self._read(p)!=binding for p in present):
+                raise BoundaryError('PRE_EFFECT_OTHER_OWNER')
+            # Validate all markers before deleting any. Unknown lock-directory
+            # contents are deliberately retained rather than recursively erased.
+            lock=self.root/'lease.lock'
+            if lock.exists() and set(p.name for p in lock.iterdir())-{'exclusive.json'}:
+                raise BoundaryError('PRE_EFFECT_LOCK_CONTENT_DRIFT')
+            for path in present: path.unlink()
+            if lock.exists(): lock.rmdir()
+            for directory in {self.root,self.operation.parent}:
+                fd=os.open(directory,os.O_RDONLY)
+                try: os.fsync(fd)
+                finally: os.close(fd)
+        self.close()
+        return 'unclaimed'
+
+    def release(self,binding,*,verify_restored,success=True):
+        if self.exclusion is None: raise BoundaryError('EXCLUSION_NOT_HELD')
+        row=self.bookings.get(binding['booking_id'])
+        self._require_binding(binding,row)
+        if verify_restored() is not True:
+            raise BoundaryError('RESTORATION_NOT_VERIFIED_LOCKS_RETAINED')
+        receipts=self.root/'exclusive-releases'
+        receipts.mkdir(mode=0o700,exist_ok=True)
+        st=receipts.lstat()
+        if not stat.S_ISDIR(st.st_mode) or st.st_uid!=os.geteuid() or stat.S_IMODE(st.st_mode)!=0o700:
+            raise BoundaryError('RELEASE_RECEIPT_CUSTODY')
+        receipt=receipts/(binding['booking_id']+'.json')
+        if not receipt.exists(): self._create(receipt,binding)
+        elif self._read(receipt)!=binding: raise BoundaryError('RELEASE_RECEIPT_MISMATCH')
+        if row['state']=='claimed':
+            self.bookings.finish(binding['booking_id'],claimant=binding['claimant'],
+                success=success,result_code='RESTORED' if success else 'FAILED_RESTORED')
+        # The retained receipt and terminal booking bind partially removed locks
+        # after a crash; every resumed release still verifies restoration again.
+        if self.operation.exists(): self.operation.unlink()
+        lock=self.root/'lease.lock'; identity=lock/'exclusive.json'
+        if identity.exists(): identity.unlink()
+        if lock.exists(): lock.rmdir()
+        for directory in {self.root,self.operation.parent}:
+            fd=os.open(directory,os.O_RDONLY)
+            try: os.fsync(fd)
+            finally: os.close(fd)
+        self.close()
+        return True
+
+    def _require_binding(self,binding,row):
+        terminal=(row.get('state') in {'complete','failed'} and
+            row.get('result_code') in {'RESTORED','FAILED_RESTORED'})
+        receipt=self.root/'exclusive-releases'/(binding['booking_id']+'.json')
+        can_resume_cleanup=terminal and receipt.exists() and self._read(receipt)==binding
+        for path in (self.operation,self.root/'lease.lock'/'exclusive.json'):
+            if path.exists():
+                if self._read(path)!=binding: raise BoundaryError('HOST_BINDING_MISMATCH')
+            elif not can_resume_cleanup:
+                raise BoundaryError('HOST_BINDING_MISSING')
+        if (row.get('entry_sha256')!=binding['entry_sha256']
+                or row.get('owner')!=binding['owner'] or row.get('claimant')!=binding['claimant']):
+            raise BoundaryError('BOOKING_BINDING_MISMATCH')
+
+    def close(self):
+        if self.exclusion is not None:
+            self.exclusion.__exit__(None,None,None)
+            self.exclusion=None
