@@ -0,0 +1,78 @@
+"""Strict protected activation profile. No live probes or effects at import."""
+from __future__ import annotations
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import stat
+
+from lab_hours_exclusive_session import IDENTITY, SHA, SessionError
+from lab_hours_unit_adapter import SCOPE
+
+
+def protected_bytes(path, *, uid=0, maximum=65536, executable=False):
+    path=Path(path)
+    # Root custody must extend to the complete parent chain, not just a file
+    # that could be exchanged through a writable or symlinked directory.
+    for parent in (path.parent,*path.parents[1:]):
+        info=parent.lstat()
+        if (not stat.S_ISDIR(info.st_mode) or info.st_uid!=uid
+                or info.st_mode & 0o022):
+            raise SessionError('PROFILE_PARENT_CUSTODY')
+    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW)
+    try:
+        info=os.fstat(fd)
+        if (not stat.S_ISREG(info.st_mode) or info.st_uid!=uid or info.st_nlink!=1
+                or info.st_mode & 0o022 or info.st_size>maximum
+                or (not executable and stat.S_IMODE(info.st_mode)!=0o600)):
+            raise SessionError('PROFILE_FILE_CUSTODY')
+        return os.read(fd,maximum+1)
+    finally: os.close(fd)
+
+
+def validate_profile(value):
+    fields={'schema','owner','booking_id','trial_seconds','units','guest_plans',
+            'experiment','source_sha256','qualification_only'}
+    if not isinstance(value,dict) or set(value)!=fields:
+        raise SessionError('ACTIVATION_PROFILE_SCHEMA')
+    if (value['schema']!='aster-exclusive-activation.v1'
+            or value['owner']!='b60-stream-a'
+            or not isinstance(value['booking_id'],str)
+            or not IDENTITY.fullmatch(value['booking_id'])
+            or type(value['trial_seconds']) is not int
+            or not 1<=value['trial_seconds']<=1800):
+        raise SessionError('ACTIVATION_PROFILE_IDENTITY')
+    units=value['units']
+    if (not isinstance(units,list) or any(not isinstance(r,list) or len(r)!=2 for r in units)
+            or len(units)!=len(SCOPE) or set(map(tuple,units))!=SCOPE):
+        raise SessionError('COMPLETE_CONSUMER_INVENTORY_REQUIRED')
+    guests=value['guest_plans']
+    if (not isinstance(guests,dict) or set(guests)!={'104','110','114','115','116'}
+            or any(not isinstance(v,str) or not SHA.fullmatch(v) for v in guests.values())):
+        raise SessionError('GUEST_PLAN_PINS_REQUIRED')
+    sources=value['source_sha256']
+    if (not isinstance(sources,dict) or not sources
+            or any(not isinstance(k,str) or not re.fullmatch(r'[a-z][a-z0-9_]*\.py',k)
+                   or not isinstance(v,str) or not SHA.fullmatch(v) for k,v in sources.items())):
+        raise SessionError('CONTROLLER_SOURCE_PINS_REQUIRED')
+    # Initial activation is deliberately recovery qualification only. Supporting
+    # arbitrary model stacks requires a reviewed trial and mount recovery plan;
+    # a profile cannot smuggle an arbitrary script into this release.
+    if value['qualification_only'] is not True or value['experiment'] is not None:
+        raise SessionError('MODEL_TRIAL_NOT_YET_QUALIFIED')
+    return value
+
+
+def load_profile(path, source_root, *, uid=0):
+    value=validate_profile(json.loads(protected_bytes(path,uid=uid)))
+    for name,digest in value['source_sha256'].items():
+        raw=protected_bytes(Path(source_root)/name,uid=uid,maximum=262144,executable=True)
+        if hashlib.sha256(raw).hexdigest()!=digest:
+            raise SessionError('CONTROLLER_SOURCE_DRIFT')
+    # Pin every local Python dependency in the deployment directory. Otherwise
+    # hashing the entrypoint alone can silently select an unreviewed import.
+    actual={p.name for p in Path(source_root).glob('*.py')}
+    if actual!=set(value['source_sha256']):
+        raise SessionError('CONTROLLER_DEPENDENCY_SET_DRIFT')
+    return value
