index 000000000..48f260f75
--- /dev/null
+++ b/scripts/local-ai/qualify_lab_hours_owner_scope.py
@@ -0,0 +1,40 @@
+"""Harmless actual host-systemd owner fencing fixture, not AI recovery proof."""
+import argparse
+import json
+import os
+import subprocess
+import time
+from lab_hours_owner_scope import OwnerScopes
+
+
+def runner(command,timeout):
+    result=subprocess.run(command,capture_output=True,text=True,timeout=timeout,check=False)
+    return result.returncode,result.stdout
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--run-fixture',action='store_true',required=True)
+    parser.parse_args()
+    if os.geteuid()!=0: raise SystemExit('ROOT_REQUIRED')
+    booking='b60-fixture-'+str(os.getpid())+'-'+str(int(time.time()))
+    scope=OwnerScopes(runner,booking)
+    try:
+        command=('systemd-run','--quiet','--unit='+scope.owner,
+            '--property=Type=exec','--property=KillMode=control-group',
+            '--property=Restart=no','--property=RuntimeMaxSec=30',
+            '/usr/bin/sleep','25')
+        if runner(command,10)[0]: raise RuntimeError('FIXTURE_OWNER_START')
+        alive=scope.alive({}); fenced=scope.fence({})
+        if not alive or not fenced: raise RuntimeError('FIXTURE_FENCE_NOT_PROVEN')
+        print(json.dumps({'state':'passed','actual_systemd_owner_observed':alive,
+            'owner_fenced':fenced,'ai_stack_effects':False},sort_keys=True)); return 0
+    except Exception as error:
+        print(json.dumps({'state':'no_go','failure_type':type(error).__name__,
+                          'ai_stack_effects':False})); return 1
+    finally:
+        runner(('systemctl','stop',scope.owner),10)
+        runner(('systemctl','reset-failed',scope.owner),10)
+
+
+if __name__=='__main__': raise SystemExit(main())
