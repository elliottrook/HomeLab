+from datetime import datetime
+import unittest
+from zoneinfo import ZoneInfo
+from lab_hours_exclusive_integrity_prepare import validate_window,validate_first_pull
+from install_lab_hours_qualification_schedule import unit_files
+
+
+class QualificationScheduleTests(unittest.TestCase):
+    def setUp(self):
+        self.start=int(datetime(2026,10,30,3,10,tzinfo=ZoneInfo('America/Vancouver')).timestamp())
+        self.booking={'booking_id':'b60-exclusive-20261030','owner':'b60-stream-a',
+            'kind':'exclusive-stack','state':'reserved','start_epoch':self.start,'end_epoch':self.start+2700}
+        self.preparation=self.start-115*60
+
+    def test_integrity_work_is_bounded_before_booking(self):
+        cycle,deadline=validate_window(self.booking,self.preparation)
+        self.assertEqual(cycle,'2026_10_30'); self.assertEqual(deadline,self.start-90*60)
+
+    def test_daytime_or_late_integrity_scan_cannot_start(self):
+        for now in (self.preparation-1,self.preparation+121,self.start):
+            with self.assertRaisesRegex(ValueError,'WINDOW'): validate_window(self.booking,now)
+
+    def test_foreign_or_already_claimed_booking_cannot_use_this_preparation(self):
+        self.booking['state']='claimed'
+        with self.assertRaisesRegex(ValueError,'WINDOW'): validate_window(self.booking,self.preparation)
+
+    def task(self):
+        return {'id':1,'enabled':True,'schedule':{'hour':'01','minute':'00'},'job':{
+            'state':'SUCCESS','arguments':[1],
+            'time_started':{'$date':(self.preparation-15*60)*1000},
+            'time_finished':{'$date':(self.preparation-10*60)*1000}}}
+
+    def test_first_pull_must_be_exact_same_night_after_archives(self):
+        self.assertTrue(validate_first_pull([self.task()],'2026_10_30',self.preparation,
+                                            self.preparation-30*60))
+        task=self.task(); task['job']['arguments']=[3]
+        self.assertFalse(validate_first_pull([task],'2026_10_30',self.preparation,
+                                             self.preparation-30*60))
+
+    def test_previous_night_and_duplicate_pull_receipts_fail(self):
+        task=self.task()
+        self.assertFalse(validate_first_pull([task],'2026_10_31',self.preparation,
+                                             self.preparation-30*60))
+        self.assertFalse(validate_first_pull([task,task],'2026_10_30',self.preparation,
+                                             self.preparation-30*60))
+
+    def test_two_future_nonpersistent_clocks_do_not_schedule_model_work(self):
+        files=unit_files(self.booking,'a'*64)
+        timers=[body for name,body in files.items() if name.endswith('.timer')]
+        self.assertEqual(len(timers),2)
+        for body in timers:
+            self.assertIn('Persistent=false',body)
+            self.assertIn('2026-10-30',body)
+            self.assertIn('America/Vancouver',body)
+        owner=files['b60-exclusive-qualification-20261030.service']
+        self.assertIn(' launch --booking-id b60-exclusive-20261030',owner)
+        self.assertNotIn('stop',owner); self.assertNotIn('model',owner)
+        self.assertTrue(any('03:10:00' in body for body in timers))
+        self.assertTrue(any('01:15:00' in body for body in timers))
+
+
+if __name__=='__main__': unittest.main()
