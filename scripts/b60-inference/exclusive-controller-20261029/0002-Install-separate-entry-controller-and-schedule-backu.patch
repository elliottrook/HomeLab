+"""Exact own-package status-only correction; no AI or schedule effects."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import time
+
+from host_exclusion import host_exclusion
+from lab_hours_exclusive_profile import protected_bytes,load_profile
+from lab_hours_exclusive_session import SessionError,canonical
+from lab_hours_reservations import ReservationStore
+
+ROOT=Path('/var/lib/local-ai-lab')
+PACKAGE=Path('/usr/local/libexec/local-ai-lease/exclusive-session')
+OLD='c0891184454234be85f287d50d8e18deae81675cb92bcb524a819ab5ad8196e1'
+NEW='9f48ed0b828d6a1001f0b9122b9fcc5b192afcf9e70353699a617c8f01f30469'
+BOOKING='b60-exclusive-20261030'
+
+
+def atomic(path,raw):
+    temporary=path.with_name(path.name+'.status-correction')
+    fd=os.open(temporary,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o600)
+    with os.fdopen(fd,'wb') as stream:
+        stream.write(raw); stream.flush(); os.fsync(stream.fileno())
+    os.replace(temporary,path)
+    fd=os.open(path.parent,os.O_RDONLY)
+    try: os.fsync(fd)
+    finally: os.close(fd)
+
+
+def correct(source):
+    if os.geteuid()!=0 or os.uname().nodename!='proxmox': raise SessionError('PROXMOX_ROOT_REQUIRED')
+    raw=protected_bytes(source,executable=True,maximum=262144)
+    if hashlib.sha256(raw).hexdigest()!=NEW: raise SessionError('STATUS_CORRECTION_SOURCE_DRIFT')
+    target=PACKAGE/'lab_hours_exclusive_cli.py'
+    profile_path=ROOT/'exclusive-activations'/(BOOKING+'.json')
+    with host_exclusion(ROOT):
+        if any(p.exists() for p in (ROOT/'lease.json',ROOT/'lease.lock',
+                ROOT/'full-inference-drain.json',ROOT/'full-inference-drain.lock',
+                Path('/run/local-ai-lab-operation.lock'))):
+            raise SessionError('SHARED_HOST_NOT_READY')
+        status=subprocess.run(('/usr/local/sbin/local-ai-lease','status'),capture_output=True,
+                              text=True,timeout=10,check=False)
+        if status.returncode or json.loads(status.stdout) not in ('ready',{'state':'ready'}):
+            raise SessionError('SHARED_HOST_NOT_READY')
+        row=ReservationStore(ROOT/'reservations',expected_uid=0).get(BOOKING)
+        if row.get('state')!='reserved' or row['start_epoch']<time.time()+7200:
+            raise SessionError('FUTURE_UNCLAIMED_BOOKING_REQUIRED')
+        profile=load_profile(profile_path,PACKAGE)
+        previous=protected_bytes(target,executable=True,maximum=262144)
+        if hashlib.sha256(previous).hexdigest()!=OLD or profile['source_sha256'][target.name]!=OLD:
+            raise SessionError('STATUS_CORRECTION_OLD_SOURCE_DRIFT')
+        old_profile=protected_bytes(profile_path)
+        checkpoint=ROOT/'exclusive-status-correction-20261029'; checkpoint.mkdir(mode=0o700)
+        for name,data in (('cli.before.py',previous),('profile.before.json',old_profile)):
+            fd=os.open(checkpoint/name,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o600)
+            with os.fdopen(fd,'wb') as stream:
+                stream.write(data); stream.flush(); os.fsync(stream.fileno())
+        try:
+            atomic(target,raw)
+            profile['source_sha256'][target.name]=NEW
+            atomic(profile_path,canonical(profile))
+            load_profile(profile_path,PACKAGE)
+        except Exception:
+            atomic(target,previous); atomic(profile_path,old_profile); raise
+        return {'state':'status-corrected','ai_stack_effects':False,
+                'schedule_effects':False,'old_sha256':OLD,'new_sha256':NEW}
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__); parser.add_argument('--source',type=Path,required=True)
+    args=parser.parse_args()
+    try: print(json.dumps(correct(args.source),sort_keys=True))
+    except Exception as error:
+        code=str(error) if isinstance(error,SessionError) else type(error).__name__
+        print(json.dumps({'state':'no_go','failure_code':code})); raise SystemExit(1)
