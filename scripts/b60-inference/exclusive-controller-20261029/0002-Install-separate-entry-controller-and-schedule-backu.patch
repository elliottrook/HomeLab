+"""Installer fixtures: real disposable files, fake host/guest transport only."""
+import contextlib
+import hashlib
+import json
+from pathlib import Path
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+import install_lab_hours_exclusive_dormant as install
+from lab_hours_exclusive_session import SessionError
+
+
+class InstallerTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary=tempfile.TemporaryDirectory(); self.addCleanup(self.temporary.cleanup)
+        self.root=Path(self.temporary.name).resolve()
+        self.bundle=self.root/'bundle'; self.bundle.mkdir(); (self.bundle/'exclusive-session').mkdir()
+        self.pins={}
+        for name in install.HELPERS:
+            raw=b'# synthetic source\n'; (self.bundle/'exclusive-session'/name).write_bytes(raw)
+            self.pins[name]=hashlib.sha256(raw).hexdigest()
+        raw=json.dumps({'schema':'aster-exclusive-source-bundle.v1','pins':self.pins,
+            'installed':False,'armed':False},sort_keys=True).encode()
+        (self.bundle/'source-manifest.json').write_bytes(raw)
+        self.expected=hashlib.sha256(raw).hexdigest()
+        self.reader=patch.object(install,'protected_bytes',side_effect=lambda path,**kwargs:Path(path).read_bytes())
+        self.reader.start(); self.addCleanup(self.reader.stop)
+
+    def test_exact_bundle_hashes_are_checked_before_install(self):
+        self.assertEqual(install.source_bundle(self.bundle,self.expected),self.pins)
+        (self.bundle/'exclusive-session'/install.HELPERS[0]).write_bytes(b'changed')
+        with self.assertRaisesRegex(SessionError,'SOURCE_DRIFT'):
+            install.source_bundle(self.bundle,self.expected)
+
+    def test_extra_dependency_cannot_hide_outside_manifest(self):
+        (self.bundle/'exclusive-session'/'extra.py').write_bytes(b'')
+        with self.assertRaisesRegex(SessionError,'FILE_SET'):
+            install.source_bundle(self.bundle,self.expected)
+
+    def test_existing_different_code_is_not_overwritten(self):
+        target=self.root/'existing.py'; target.write_bytes(b'peer-owned')
+        with self.assertRaisesRegex(SessionError,'SOURCE_DRIFT'):
+            install.put_new(target,b'ours')
+        self.assertEqual(target.read_bytes(),b'peer-owned')
+
+    def test_new_code_file_is_private_and_same_source_is_idempotent(self):
+        target=self.root/'new.py'; install.put_new(target,b'ours')
+        install.put_new(target,b'ours')
+        self.assertEqual(target.stat().st_mode&0o777,0o600)
+
+    def test_fake_full_install_never_has_service_lease_or_timer_effect_commands(self):
+        host=self.root/'host'; host.mkdir()
+        target=self.root/'installed'; commands=[]
+        def runner(command,timeout=30):
+            commands.append(command)
+            if command[0]=='/usr/local/sbin/local-ai-lease': return '{"state":"ready"}'
+            if command[0]=='pct' and command[1]=='push': return ''
+            if '-c' in command: return 'absent'
+            return json.dumps({'state':'prepared','plan_sha256':'a'*64,
+                               'configuration_contents_copied':False})
+        row={'owner':'b60-stream-a','kind':'exclusive-stack','state':'reserved',
+             'start_epoch':install.time.time()+10000}
+        with patch.object(install.os,'geteuid',return_value=0), \
+             patch.object(install.os,'uname',return_value=SimpleNamespace(nodename='proxmox')), \
+             patch.object(install,'ROOT',host),patch.object(install,'TARGET',target), \
+             patch.object(install,'host_exclusion',side_effect=lambda root:contextlib.nullcontext()), \
+             patch.object(install,'directory',side_effect=lambda path:path.mkdir(parents=True,exist_ok=True)), \
+             patch.object(install,'run',side_effect=runner),patch.object(install,'load_profile'), \
+             patch.object(install.ReservationStore,'get',return_value=row):
+            result=install.install(self.bundle,self.expected,'b60-exclusive-20261030')
+        self.assertEqual(result['state'],'dormant-installed')
+        self.assertFalse(result['armed']); self.assertFalse(result['ai_stack_effects'])
+        self.assertFalse(any('systemctl' in c or 'systemd-run' in c for c in commands))
+        self.assertEqual([c for c in commands if c[0]=='/usr/local/sbin/local-ai-lease'],
+                         [('/usr/local/sbin/local-ai-lease','status')])
+
+
+if __name__=='__main__': unittest.main()
