+        plans={}
+        # These small source packets remain in each guest; no private bytes are
+        # transported out. An existing helper is accepted only byte-for-byte.
+        inspect='''import hashlib,json,os,pathlib,stat,sys
+p=pathlib.Path(sys.argv[1]);p.mkdir(mode=0o700,parents=True,exist_ok=True)
+for d in (p,*p.parents):
+ s=d.lstat()
+ if not stat.S_ISDIR(s.st_mode) or s.st_uid!=0 or s.st_mode&0o022: raise SystemExit(1)
+f=p/sys.argv[2]
