@@ -0,0 +1,151 @@
+"""Install new dormant code and one protected plan/profile, never arm a run.
+
+No existing runtime file is overwritten. No service/timer command, model call,
+checkpoint of secret-bearing bytes, mount or lease claim exists in this file.
+Partial installation is retained and may resume only with identical pins.
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import stat
+import subprocess
+import time
+
+from host_exclusion import host_exclusion
+from lab_hours_exclusive_session import IDENTITY,SessionError,canonical
+from lab_hours_exclusive_profile import protected_bytes,validate_profile,load_profile
+from lab_hours_reservations import ReservationStore
+from lab_hours_unit_adapter import SCOPE
+
+ROOT=Path('/var/lib/local-ai-lab')
+TARGET=Path('/usr/local/libexec/local-ai-lease/exclusive-session')
+GUEST_TARGET='/usr/local/libexec/local-ai-lease/entry-checkpoint'
+HELPERS=('lab_hours_guest_checkpoint.py','lab_hours_file_checkpoint.py',
+         'lab_hours_unit_adapter.py','lab_hours_prepare_entry_plan.py')
+
+
+def put_new(path,data):
+    if path.exists():
+        if protected_bytes(path,executable=True,maximum=262144)!=data:
+            raise SessionError('EXISTING_DORMANT_SOURCE_DRIFT')
+        return
+    fd=os.open(path,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o600)
+    with os.fdopen(fd,'wb') as stream:
+        stream.write(data); stream.flush(); os.fsync(stream.fileno())
+    fd=os.open(path.parent,os.O_RDONLY)
+    try: os.fsync(fd)
+    finally: os.close(fd)
+
+
+def directory(path):
+    path.mkdir(mode=0o700,parents=True,exist_ok=True)
+    for parent in (path,*path.parents):
+        info=parent.lstat()
+        if not stat.S_ISDIR(info.st_mode) or info.st_uid!=0 or info.st_mode&0o022:
+            raise SessionError('DORMANT_INSTALL_DIRECTORY_CUSTODY')
+
+
+def run(command,timeout=30):
+    result=subprocess.run(command,capture_output=True,text=True,timeout=timeout,check=False)
+    if result.returncode or len(result.stdout)>65536:
+        raise SessionError('DORMANT_INSTALL_COMMAND_FAILED')
+    return result.stdout
+
+
+def source_bundle(source,expected):
+    raw=protected_bytes(source/'source-manifest.json')
+    if hashlib.sha256(raw).hexdigest()!=expected: raise SessionError('BUNDLE_MANIFEST_DRIFT')
+    manifest=json.loads(raw)
+    if (set(manifest)!={'schema','pins','installed','armed'}
+            or manifest['schema']!='aster-exclusive-source-bundle.v1'
+            or manifest['installed'] is not False or manifest['armed'] is not False
+            or not isinstance(manifest['pins'],dict)):
+        raise SessionError('DORMANT_BUNDLE_SCHEMA')
+    pins=manifest['pins']
+    if set(p.name for p in (source/'exclusive-session').iterdir())!=set(pins):
+        raise SessionError('DORMANT_BUNDLE_FILE_SET_DRIFT')
+    for name,digest in pins.items():
+        if '/' in name or not name.endswith('.py'): raise SessionError('DORMANT_SOURCE_NAME')
+        raw=protected_bytes(source/'exclusive-session'/name,executable=True,maximum=262144)
+        if hashlib.sha256(raw).hexdigest()!=digest: raise SessionError('DORMANT_SOURCE_DRIFT')
+    return pins
+
+
+def install(source,expected,booking_id):
+    if os.geteuid()!=0 or os.uname().nodename!='proxmox': raise SessionError('PROXMOX_ROOT_REQUIRED')
+    if not IDENTITY.fullmatch(booking_id): raise SessionError('INSTALL_BOOKING_IDENTITY')
