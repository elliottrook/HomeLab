diff --git a/scripts/local-ai/lab_hours_exclusive_integrity_prepare.py b/scripts/local-ai/lab_hours_exclusive_integrity_prepare.py
new file mode 100644
index 000000000..d6c8c259d
--- /dev/null
+++ b/scripts/local-ai/lab_hours_exclusive_integrity_prepare.py
@@ -0,0 +1,157 @@
+"""One booked-night low-priority archive-integrity preparation, not a lease.
+
+This does not call a model, stop AI units, mount anything, or change backups.
+It verifies existing same-night archives and publishes the platform's standard
+root-local integrity receipt. The later owner independently rebinds all sources.
+"""
+from __future__ import annotations
+import argparse
+from datetime import datetime
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+from zoneinfo import ZoneInfo
+
+PACKAGE=Path('/usr/local/libexec/local-ai-lease/exclusive-session')
+ROOT=Path('/var/lib/local-ai-lab')
+ZONE=ZoneInfo('America/Vancouver')
+
+
+def validate_window(booking,now):
+    local=datetime.fromtimestamp(now,ZONE)
+    day=datetime.fromtimestamp(booking['start_epoch'],ZONE)
+    begin=day.replace(hour=1,minute=15,second=0,microsecond=0).timestamp()
+    deadline=int(day.replace(hour=1,minute=40,second=0,microsecond=0).timestamp())
+    if (booking.get('owner')!='b60-stream-a' or booking.get('kind')!='exclusive-stack'
+            or booking.get('state')!='reserved' or local.date()!=day.date()
+            or not begin<=now<=begin+120 or deadline+900>=booking['start_epoch']):
+        raise ValueError('INTEGRITY_PREPARATION_WINDOW')
+    return day.strftime('%Y_%m_%d'),deadline
+
+
+def validate_first_pull(rows,cycle,now,latest_archive):
+    matches=[row for row in rows if row.get('id')==1]
+    if len(matches)!=1: return False
+    row=matches[0]; schedule=row.get('schedule',{}); job=row.get('job',{})
+    started=job.get('time_started',{}).get('$date')
+    finished=job.get('time_finished',{}).get('$date')
+    hour,minute=str(schedule.get('hour','')),str(schedule.get('minute',''))
+    return (row.get('enabled') is True and hour.isdigit() and int(hour)==1
+        and minute.isdigit() and int(minute)==0 and job.get('state')=='SUCCESS'
+        and job.get('arguments')==[1] and type(started) is int and type(finished) is int
+        and latest_archive<=started/1000<=finished/1000<=now
+        and datetime.fromtimestamp(started/1000,ZONE).strftime('%Y_%m_%d')==cycle
+        and datetime.fromtimestamp(finished/1000,ZONE).strftime('%Y_%m_%d')==cycle
+        and datetime.fromtimestamp(started/1000,ZONE).hour>=1)
+
+
+def runner(command,timeout):
+    result=subprocess.run(command,capture_output=True,text=True,timeout=timeout,check=False)
+    return result.returncode,result.stdout
+
+
+def prepare(booking_id):
+    sys.path.insert(0,str(PACKAGE))
+    from lab_hours_exclusive_profile import load_profile
+    from lab_hours_reservations import ReservationStore
+    from lab_hours_exclusive_session import SessionStore,SessionError,IDENTITY
+    from host_exclusion import host_exclusion
+    from full_inference_lab_sources import (AcceptedBaseline,TrustedOwnerAttestation,
+        LocalProxmoxFullDrainSourceProducer,FIXED)
+    from retained_archive_integrity import (fixed_proxmox_inventory,fixed_resolve,
+        fixed_probe,capture,verify,save_root_owned,load_root_owned,SCHEMA,FIELDS)
+    from backup_receipt_adapter import verify_proxmox_artifacts
+    if os.geteuid()!=0 or os.uname().nodename!='proxmox': raise ValueError('PROXMOX_ROOT_REQUIRED')
+    if not IDENTITY.fullmatch(booking_id): raise ValueError('PREPARATION_BOOKING_IDENTITY')
+    load_profile(ROOT/'exclusive-activations'/(booking_id+'.json'),PACKAGE)
+    bookings=ReservationStore(ROOT/'reservations',expected_uid=0)
+    cycle,deadline=validate_window(bookings.get(booking_id),int(time.time()))
+    with host_exclusion(ROOT):
+        if any(p.exists() for p in (ROOT/'lease.json',ROOT/'lease.lock',
+                ROOT/'full-inference-drain.json',ROOT/'full-inference-drain.lock',
+                Path('/run/local-ai-lab-operation.lock'))):
+            raise ValueError('KNOWN_MAINTENANCE_OR_LAB_ACTIVE')
+        code,raw=runner(('/usr/local/sbin/local-ai-lease','status'),10)
+        if code or json.loads(raw) not in ('ready',{'state':'ready'}):
+            raise ValueError('SHARED_HOST_NOT_READY')
+        # Process comm only, never raw command lines that might contain keys.
+        for proc in Path('/proc').glob('[0-9]*'):
+            try: name=(proc/'comm').read_text().strip()
+            except FileNotFoundError: continue
+            if name in {'vzdump','zstd','rsync','pbs-client','proxmox-backup'}:
+                raise ValueError('COMPETING_BACKUP_IO')
+        state=SessionStore(ROOT/'exclusive-integrity'/booking_id,expected_uid=0)
+        fd=state.lock()
+        phase='attempt'
+        try:
+            state.write('attempt.json',{'schema':'aster-exclusive-integrity-attempt.v1',
+                'booking_id':booking_id,'started_epoch':int(time.time()),
+                'deadline_epoch':deadline},immutable=True)
+            phase='whole-backup-job'
+            producer=LocalProxmoxFullDrainSourceProducer(runner,AcceptedBaseline('','',''),
+                TrustedOwnerAttestation('b60-stream-a','booked-night-integrity'))
+            if producer._backup_current(cycle) is not True:
+                raise ValueError('WHOLE_BACKUP_JOB_UNPROVEN')
+            phase='current-archive-inventory'
+            inventory=fixed_proxmox_inventory()
+            artifacts=verify_proxmox_artifacts(inventory,date_prefix=cycle)
+            phase='first-truenas-pull'
+            code,raw=runner(FIXED['truenas'],10)
+            if code or not validate_first_pull(json.loads(raw),cycle,int(time.time()),
+                                               max(row.ctime for row in artifacts)):
+                raise ValueError('FIRST_TRUENAS_PULL_UNPROVEN')
+            phase='existing-integrity-receipt'
+            previous=load_root_owned() if (ROOT/'archive-integrity.json').exists() else None
+            if previous is not None and (set(previous)!=FIELDS or previous.get('schema')!=SCHEMA):
+                raise ValueError('EXISTING_INTEGRITY_RECEIPT_UNEXPECTED')
+            before=hashlib.sha256(json.dumps(previous,sort_keys=True).encode()).hexdigest()
+            if previous is not None: state.write('previous-receipt.json',previous,immutable=True)
+            # Preserve a peer producer's valid same-cycle receipt; do not scan
+            # or replace it merely to claim this preparation produced it.
+            reused=False
+            if previous is not None and previous.get('date')==cycle:
+                proof=verify(previous,inventory,date=cycle,now_epoch=int(time.time()),
+                             resolve=fixed_resolve,lstat=os.lstat)
+                receipt=previous; reused=True
+            else:
+                phase='archive-integrity-scan'
+                receipt=capture(inventory,date=cycle,resolve=fixed_resolve,lstat=os.lstat,
+                                probe=fixed_probe,deadline_epoch=deadline)
+                proof=verify(receipt,fixed_proxmox_inventory(),date=cycle,now_epoch=int(time.time()),
+                             resolve=fixed_resolve,lstat=os.lstat)
+            phase='receipt-publication'
+            state.write('receipt.json',receipt,immutable=True)
+            current=load_root_owned() if (ROOT/'archive-integrity.json').exists() else None
+            if hashlib.sha256(json.dumps(current,sort_keys=True).encode()).hexdigest()!=before:
+                raise ValueError('PEER_INTEGRITY_RECEIPT_CHANGED')
+            if not reused: save_root_owned(receipt)
+            state.write('terminal.json',{'schema':'aster-exclusive-integrity-result.v1',
+                'state':'complete','booking_id':booking_id,'archive_receipt':proof,
+                'finished_epoch':int(time.time()),'peer_receipt_reused':reused,
+                'ai_stack_effects':False},immutable=True)
+            return {'state':'complete','booking_id':booking_id,'ai_stack_effects':False}
+        except Exception:
+            if not (state.root/'terminal.json').exists():
+                state.write('terminal.json',{'schema':'aster-exclusive-integrity-result.v1',
+                    'state':'no_go','booking_id':booking_id,'first_failure_phase':phase,
+                    'ai_stack_effects':False},immutable=True)
+            raise
+        finally: os.close(fd)
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--booking-id',required=True); parser.add_argument('--self-sha256',required=True)
+    args=parser.parse_args()
+    try:
+        if hashlib.sha256(Path(__file__).read_bytes()).hexdigest()!=args.self_sha256:
+            raise ValueError('PREPARATION_SOURCE_DRIFT')
+        print(json.dumps(prepare(args.booking_id),sort_keys=True))
+    except Exception as error:
+        # Fixed types only: no source-local command output or private paths.
+        print(json.dumps({'state':'no_go','failure_type':type(error).__name__,
+                          'ai_stack_effects':False})); raise SystemExit(1)
