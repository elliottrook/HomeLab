+"""Fixed synthetic memory/tmpfs probe; no network, GPU, model or private input."""
+import argparse,hashlib,json,os,time
+from pathlib import Path
+B='b60-exclusive-20261105-day-r5'
+def main():
+ p=argparse.ArgumentParser();p.add_argument('--booking-id',choices=(B,),required=True);a=p.parse_args()
+ root=Path('/var/lib/b60-resource-'+B);assert root.is_dir() and root.stat().st_uid==0 and root.stat().st_mode&0o777==0o700
+ mount=Path('/run/b60-qualification');matches=[l for l in Path('/proc/self/mountinfo').read_text().splitlines() if l.split()[4]==str(mount)]
+ assert len(matches)==1 and ' - tmpfs ' in matches[0] and 'rw' in matches[0].split()[5].split(',')
+ block=bytearray(134217728)
+ for i in range(0,len(block),4096):block[i]=37
+ data=b'B60 synthetic recovery qualification\n';target=mount/'fixture'
+ with target.open('xb') as f:
+  for _ in range(8388608//len(data)):f.write(data)
+  remaining=8388608-f.tell()
+  f.write(b'x'*remaining);f.flush();os.fsync(f.fileno())
+ assert target.stat().st_size==8388608
+ receipt={'schema':'b60-bounded-resource-probe.v1','booking_id':B,'bytes_touched':len(block),'tmpfs_bytes':target.stat().st_size,'tmpfs_verified':True,'model_called':False,'pid':os.getpid()}
+ path=root/'probe.json';fd=os.open(path,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o600)
+ with os.fdopen(fd,'w') as f:json.dump(receipt,f,sort_keys=True);f.flush();os.fsync(f.fileno())
+ time.sleep(100) # Owner recovery must fence this still-live candidate cgroup.
+if __name__=='__main__':main()
