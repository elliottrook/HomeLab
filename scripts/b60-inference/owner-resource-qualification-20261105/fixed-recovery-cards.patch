+"""Two fixed booked recovery qualifications; no model/backend extension.
+
+Uses the accepted installed entry controller, not a generic command profile.
+R4 deliberately loses its owner after independent guardian arming/isolation.
+R5 exercises bounded memory/private tmpfs, exact candidate-scope fencing and
+checkpointed inactive-worker resource limits, conditional on R4's live proof.
+"""
+import argparse,hashlib,json,os,sys,time,subprocess
+from pathlib import Path
+SOURCE_MAP='e282a0e6a26a7e0302a70d2dbf953734048a5eb3697704d3cf0dce48803c3cd2'
+PACKAGE=Path('/usr/local/libexec/local-ai-lease/exclusive-session')
+ROOT=Path('/var/lib/local-ai-lab')
+BINDINGS={'owner-loss':('b60-exclusive-20261105-day-r4',1793927700,1793930400),
+          'resource':('b60-exclusive-20261105-day-r5',1793931300,1793934000)}
+RESOURCE_PROBE_SHA='4405832c82593e8beaaf941a4b6f6ca74f7fabb45acafa2bc934ec296087ba5d'
+SCRIPT_PATH=Path('/usr/local/libexec/local-ai-lease/recovery-qualification-20261105/b60_recovery_qualification.py')
+GUEST_PROBE='/usr/local/libexec/local-ai-lease/recovery-qualification-20261105/b60_resource_probe.py'
+
+def canonical(v):return json.dumps(v,sort_keys=True,separators=(',',':')).encode()
+
+def validate_binding(mode,booking,now,*,launch=False):
+    if mode not in BINDINGS:raise ValueError('QUALIFICATION_MODE')
+    b,start,end=BINDINGS[mode]
+    if (booking.get('booking_id')!=b or booking.get('owner')!='b60-stream-a'
+            or booking.get('kind')!='exclusive-stack' or booking.get('start_epoch')!=start
+            or booking.get('end_epoch')!=end or booking.get('state')!='reserved'
+            or (launch and not start<=now<=start+120)):
+        raise ValueError('EXACT_QUALIFICATION_BOOKING_REQUIRED')
+
+def owner_loss_verdict(intent,loss,fence,state,booking):
+    return (intent.get('owner_loss_requested') is True and intent.get('phase')=='isolated'
+        and loss.get('owner_empty') is True and loss.get('phase')=='isolated'
+        and loss.get('observed_epoch',10**20)<intent.get('trial_deadline',0)
+        and fence.get('owner_fenced') is True and state.get('phase')=='released'
+        and state.get('production_restored') is True and state.get('trial_failed') is True
+        and state.get('deadline_missed') is False and not state.get('manual_assistance_required',False)
+        and booking.get('state')=='failed' and booking.get('result_code')=='FAILED_RESTORED')
+
+def call(command,timeout=30):
+    p=subprocess.run(command,capture_output=True,text=True,timeout=timeout)
+    if p.returncode:raise RuntimeError('FIXED_QUALIFICATION_COMMAND_FAILED')
+    return p.stdout
+
+def initialize():
+    if os.geteuid()!=0 or os.uname().nodename!='proxmox':raise RuntimeError('PROXMOX_ROOT_REQUIRED')
+    sys.path.insert(0,str(PACKAGE))
+    from lab_hours_exclusive_profile import protected_bytes
+    pins={p.name:hashlib.sha256(protected_bytes(p,executable=True,maximum=262144)).hexdigest() for p in PACKAGE.glob('*.py')}
+    if len(pins)!=30 or hashlib.sha256(canonical(pins)).hexdigest()!=SOURCE_MAP:
+        raise RuntimeError('INSTALLED_SOURCE_MAP_DRIFT')
+    # The whole supplementary package is pinned, including this entry point.
+    manifest=json.loads(protected_bytes(SCRIPT_PATH.parent/'manifest.json'))
+    if set(manifest)!={'b60_recovery_qualification.py','b60_resource_probe.py'}:raise RuntimeError('QUALIFICATION_CLOSURE')
+    for n,h in manifest.items():
+        if hashlib.sha256(protected_bytes(SCRIPT_PATH.parent/n,executable=True)).hexdigest()!=h:
+            raise RuntimeError('QUALIFICATION_SOURCE_DRIFT')
+
+def context(mode):
+    from lab_hours_exclusive_cli import context as base
+    result=base(BINDINGS[mode][0])
+    if mode=='resource':
+        adapter=result[-1];original=adapter.restore
+        def restore(entry,deadline):
+            resource_namespace_cleanup(adapter,result[1],deadline)
+            return original(entry,deadline)
+        adapter.restore=restore
+    return result
+
+def arm(mode,scopes,state,store):
+    remaining=int(state['restore_deadline']-time.time())
+    if remaining<=900:raise RuntimeError('GUARDIAN_MARGIN')
+    call(['systemd-run','--quiet','--unit='+scopes.guardian,'--property=Type=exec',
+          '--property=KillMode=control-group','--property=Restart=no','--property=TimeoutStopSec=30',
+          '--property=RuntimeMaxSec='+str(remaining+600),'/usr/bin/python3','-B',str(SCRIPT_PATH),'watch','--mode',mode],15)
+    fields=dict(l.split('=',1) for l in call(['systemctl','show',scopes.guardian,'--property=ActiveState,MainPID,KillMode,Restart']).splitlines())
+    ok=fields.get('ActiveState')=='active' and int(fields.get('MainPID','0'))>0 and fields.get('KillMode')=='control-group' and fields.get('Restart')=='no'
+    if ok:store.write('qualification-guardian-arm.json',{'independent_guardian_armed':True,'guardian_pid':int(fields['MainPID']),'observed_epoch':int(time.time()),'mode':mode},immutable=True)
+    return ok
+
+def launch(mode):
+    profile,store,bookings,scopes,adapter=context(mode)
+    row=bookings.get(BINDINGS[mode][0]);validate_binding(mode,row,int(time.time()),launch=True)
+    call(['systemd-run','--quiet','--unit='+scopes.owner,'--property=Type=exec',
+          '--property=KillMode=control-group','--property=Restart=no','--property=TimeoutStopSec=30',
+          '--property=RuntimeMaxSec='+str(row['end_epoch']-int(time.time())+300),
+          '/usr/bin/python3','-B',str(SCRIPT_PATH),'run','--mode',mode],15)
+    return {'state':'owner-launched','mode':mode,'booking_id':row['booking_id']}
+
+def watch(mode):
+    from lab_hours_exclusive_guardian import guard
+    profile,store,bookings,scopes,adapter=context(mode)
+    def alive(state):
+        fields=scopes._show();present=(fields.get('LoadState')=='loaded' and fields.get('ActiveState') in {'active','activating'} and fields.get('MainPID','').isdigit() and int(fields['MainPID'])>0 and fields.get('TasksCurrent','').isdigit() and int(fields['TasksCurrent'])>0)
+        if not present and not (store.root/'qualification-loss-observed.json').exists():
+            empty=fields.get('ActiveState') in {'inactive','failed'} and fields.get('MainPID')=='0' and fields.get('TasksCurrent') in {'0','','[not set]'}
+            store.write('qualification-loss-observed.json',{'owner_empty':empty,'phase':state['phase'],'observed_epoch':int(time.time())},immutable=True)
+        return present
+    def fence(state):
+        ok=scopes.fence(state)
+        if not (store.root/'qualification-fence.json').exists():store.write('qualification-fence.json',{'owner_fenced':ok,'observed_epoch':int(time.time())},immutable=True)
+        return ok
+    try:
+        result=guard(store,adapter,owner=profile['owner'],owner_alive=alive,fence_owner=fence)
+        state=store.read('session.json');row=bookings.get(profile['booking_id'])
+        passed=(mode=='owner-loss' and result.get('state')=='rescued' and
+            owner_loss_verdict(store.read('qualification-intent.json'),store.read('qualification-loss-observed.json'),store.read('qualification-fence.json'),state,row))
+        if mode=='owner-loss':
+            store.write('qualification-terminal.json',{'schema':'b60-recovery-qualification-result.v1','mode':mode,'booking_id':profile['booking_id'],'qualified':passed,'guardian_result':result,'finished_epoch':int(time.time()),'no_model_experiment':True,'source_map_sha256':SOURCE_MAP},immutable=True)
+        return result
+    finally:adapter.boundary.close()
+
+def resource_baseline(adapter,store,deadline):
+    parent='/var/lib/local-ai-lab-entry/'+adapter.profile['booking_id']
+    code="import json,sys;from pathlib import Path;p=json.loads((Path(sys.argv[1])/'plan.json').read_text());required={'/run/systemd/system.control/epub-narration-worker.service.d/50-CPUQuota.conf','/run/systemd/system.control/epub-narration-worker.service.d/50-MemoryMax.conf'};assert required<=set(p['files']);print('resource-files-covered')"
+    adapter._call(('pct','exec','116','--','python3','-B','-c',code,parent),deadline,10)
+    raw=adapter._call(('pct','exec','116','--','systemctl','show','epub-narration-worker.service','--property=CPUQuotaPerSecUSec,MemoryMax,ActiveState,MainPID'),deadline,10)
+    fields=dict(l.split('=',1) for l in raw.splitlines())
+    if fields.get('ActiveState') not in {'inactive','failed'} or fields.get('MainPID')!='0':raise RuntimeError('RESOURCE_WORKER_NOT_QUIESCENT')
+    if fields.get('CPUQuotaPerSecUSec')=='100ms' or fields.get('MemoryMax')=='268435456':raise RuntimeError('RESOURCE_TEST_NO_DELTA')
+    check="from pathlib import Path;p=Path('/run/b60-qualification');q=Path('/var/lib/b60-resource-b60-exclusive-20261105-day-r5');assert not p.exists() and not p.is_symlink() and not q.exists();print('resource-namespace-entry-absent')"
+    adapter._call(('pct','exec','110','--','python3','-B','-c',check),deadline,10)
+    store.write('resource-baseline.json',{'properties':fields,'resource_files_covered':True,'global_probe_mount_absent':True},immutable=True)
+    adapter._call(('pct','exec','116','--','systemctl','set-property','--runtime','epub-narration-worker.service','CPUQuota=10%','MemoryMax=256M'),deadline,15)
+    after=adapter._call(('pct','exec','116','--','systemctl','show','epub-narration-worker.service','--property=CPUQuotaPerSecUSec,MemoryMax'),deadline,10)
+    values=dict(l.split('=',1) for l in after.splitlines())
+    if values!={'CPUQuotaPerSecUSec':'100ms','MemoryMax':'268435456'}:raise RuntimeError('RESOURCE_LIMIT_EFFECT_UNVERIFIED')
+    store.write('resource-limit-effect.json',{'properties':values,'observed_epoch':int(time.time()),'workload_started':False},immutable=True)
+
+def resource_namespace_cleanup(adapter,store,deadline):
+    # Called by owner AND guardian after the standard exact trial-scope fence,
+    # before any production service restoration. Never unmount a global path.
+    if not (store.root/'resource-baseline.json').exists():return
+    baseline=store.read('resource-baseline.json')
+    if baseline.get('global_probe_mount_absent') is not True:raise RuntimeError('RESOURCE_BASELINE_UNKNOWN')
+    code="from pathlib import Path;import os,json,stat;p=Path('/run/b60-qualification');assert not any(l.split()[4]==str(p) for l in Path('/proc/self/mountinfo').read_text().splitlines());\nif p.exists():\n s=p.lstat();assert stat.S_ISDIR(s.st_mode) and s.st_uid==0 and not p.is_symlink() and not list(p.iterdir());p.rmdir()\nassert not p.exists();print(json.dumps({'global_probe_mount_absent':True,'global_probe_directory_absent':True}))"
+    value=json.loads(adapter._call(('pct','exec','110','--','python3','-B','-c',code),deadline,10))
+    store.write('resource-namespace-restored.json',value)
+
+def resource_trial(adapter,store,state):
+    deadline=state['trial_deadline'];b=state['booking_id'];unit='b60-exclusive-trial-'+b+'.service'
+    expected=adapter._call(('pct','exec','110','--','sha256sum',GUEST_PROBE),deadline,10).split()[0]
+    if expected!=RESOURCE_PROBE_SHA:raise RuntimeError('RESOURCE_PROBE_SOURCE_DRIFT')
+    resource_baseline(adapter,store,deadline)
+    adapter._call(('pct','exec','110','--','systemd-run','--quiet','--unit='+unit,
+        '--property=Type=exec','--property=KillMode=control-group','--property=Restart=no',
+        '--property=RuntimeMaxSec=120','--property=TimeoutStopSec=5','--property=MemoryMax=384M',
+        '--property=MemorySwapMax=0','--property=CPUQuota=25%','--property=TasksMax=16',
+        '--property=NoNewPrivileges=yes','--property=PrivateNetwork=yes','--property=PrivateMounts=yes',
+        '--property=ProtectSystem=strict','--property=ProtectHome=yes','--property=PrivateTmp=yes',
+        '--property=TemporaryFileSystem=/run/b60-qualification:rw,size=16M,mode=0700',
+        '--property=StateDirectory=b60-resource-'+b,'--property=StateDirectoryMode=0700',
+        '/usr/bin/python3','-B',GUEST_PROBE,'--booking-id',b),deadline,20)
+    probe='/var/lib/b60-resource-'+b+'/probe.json'
+    for _ in range(20):
+        code,raw=adapter.runner(('pct','exec','110','--','python3','-B','-c',
+            "import pathlib,sys;print(pathlib.Path(sys.argv[1]).read_text())",probe),min(10,max(1,deadline-time.time())))
+        if code==0:break
+        if time.time()+15>=deadline:raise RuntimeError('RESOURCE_PROBE_DEADLINE')
+        time.sleep(.5)
+    else:raise RuntimeError('RESOURCE_PROBE_RECEIPT_ABSENT')
+    receipt=json.loads(raw)
+    if receipt.get('bytes_touched')!=134217728 or receipt.get('tmpfs_bytes')!=8388608 or receipt.get('tmpfs_verified') is not True or receipt.get('booking_id')!=b:
+        raise RuntimeError('RESOURCE_PROBE_RECEIPT_INVALID')
+    raw=adapter._call(('pct','exec','110','--','systemctl','show',unit,'--property=ActiveState,MainPID,MemoryPeak,MemoryMax,CPUQuotaPerSecUSec,TasksMax'),deadline,10)
+    fields=dict(l.split('=',1) for l in raw.splitlines())
+    if (fields.get('ActiveState')!='active' or int(fields.get('MainPID','0'))<1
+        or fields.get('MemoryMax')!='402653184' or fields.get('CPUQuotaPerSecUSec')!='250ms'
+        or fields.get('TasksMax')!='16' or not 134217728<=int(fields.get('MemoryPeak','0'))<=402653184):
+        raise RuntimeError('RESOURCE_CGROUP_LIMITS_UNVERIFIED')
+    store.write('resource-trial.json',{'probe':receipt,'cgroup':fields,'observed_epoch':int(time.time()),'no_model_experiment':True},immutable=True)
+
+def run(mode):
+    from lab_hours_exclusive_session import ExclusiveSession
+    profile,store,bookings,scopes,adapter=context(mode)
+    if scopes._show().get('MainPID')!=str(os.getpid()) or not scopes.alive({}):raise RuntimeError('EXACT_OWNER_SCOPE_REQUIRED')
+    if mode=='resource':
+        from lab_hours_exclusive_session import SessionStore
+        prior=SessionStore(ROOT/'exclusive-sessions'/BINDINGS['owner-loss'][0],expected_uid=0).read('qualification-terminal.json')
+        if prior.get('qualified') is not True or prior.get('source_map_sha256')!=SOURCE_MAP:raise RuntimeError('OWNER_LOSS_QUALIFICATION_REQUIRED')
+    adapter.arm=lambda state,profile:arm(mode,scopes,state,store)
+    session=ExclusiveSession(store,adapter)
+    try:
+        state=session.begin(bookings.get(profile['booking_id']),owner=profile['owner'],trial_seconds=300)
+        if mode=='owner-loss':
+            store.write('qualification-intent.json',{'mode':mode,'phase':'isolated','owner_loss_requested':True,'observed_epoch':int(time.time()),'trial_deadline':state['trial_deadline'],'no_model_experiment':True},immutable=True)
+            os._exit(86) # Abrupt loss: no finally/recovery in the owner process.
+        resource_trial(adapter,store,state)
+        result=session.run_trial(owner=profile['owner'])
+        baseline=store.read('resource-baseline.json')['properties']
+        raw=call(['pct','exec','116','--','systemctl','show','epub-narration-worker.service','--property=CPUQuotaPerSecUSec,MemoryMax'])
+        observed=dict(l.split('=',1) for l in raw.splitlines())
+        restored=observed=={k:baseline[k] for k in ('CPUQuotaPerSecUSec','MemoryMax')}
+        raw=call(['pct','exec','110','--','systemctl','show','b60-exclusive-trial-'+profile['booking_id']+'.service','--property=ActiveState,MainPID,TasksCurrent'])
+        fields=dict(l.split('=',1) for l in raw.splitlines());empty=fields.get('MainPID')=='0' and fields.get('TasksCurrent') in {'0','','[not set]'} and fields.get('ActiveState') in {'inactive','failed'}
+        passed=result['outcome']=='complete-restored' and restored and empty
+        store.write('qualification-terminal.json',{'schema':'b60-recovery-qualification-result.v1','mode':mode,'booking_id':profile['booking_id'],'qualified':passed,'resource_limits_restored':restored,'trial_scope_empty':empty,'finished_epoch':int(time.time()),'source_map_sha256':SOURCE_MAP,'no_model_experiment':True},immutable=True)
+        return {'qualified':passed,'mode':mode}
+    except Exception:
+        if (store.root/'session.json').exists():session.recover(owner=profile['owner'])
+        raise
+    finally:adapter.boundary.close()
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('action',choices=('launch','run','watch'));p.add_argument('--mode',choices=tuple(BINDINGS),required=True);a=p.parse_args()
+    try:
+        initialize()
+        result={'launch':launch,'run':run,'watch':watch}[a.action](a.mode)
+        print(json.dumps(result,sort_keys=True))
+    except Exception as error:
+        print(json.dumps({'state':'no_go','mode':a.mode,'failure_type':type(error).__name__},sort_keys=True));raise SystemExit(1)
+if __name__=='__main__':main()
