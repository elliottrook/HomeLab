@@ -0,0 +1,47 @@
+"""Arm exactly the two reviewed fixed recovery cards; no immediate transaction."""
+import hashlib,json,os,time
+from pathlib import Path
+from datetime import datetime
+from zoneinfo import ZoneInfo
+from host_exclusion import host_exclusion
+from lab_hours_exclusive_profile import load_profile,protected_bytes
+from lab_hours_exclusive_session import SessionError
+from lab_hours_reservations import ReservationStore
+from retained_archive_integrity import load_root_owned,verify,fixed_proxmox_inventory,fixed_resolve
+from install_b60_daytime_qualification import ROOT,PACKAGE,UNITS,call,unit_files,day_window_invalid
+from b60_recovery_qualification import BINDINGS,SCRIPT_PATH,validate_binding,initialize
+
+def recovery_files(mode,booking):
+    prefix='b60-exclusive-qualification-'+booking['booking_id']
+    files={n:v for n,v in unit_files(booking,'unused').items() if n.startswith(prefix+'.')}
+    old=str(PACKAGE/'lab_hours_exclusive_cli.py')+' launch --booking-id '+booking['booking_id']
+    new=str(SCRIPT_PATH)+' launch --mode '+mode
+    service=prefix+'.service'
+    if old not in files[service]:raise SessionError('RECOVERY_CLOCK_SOURCE_SHAPE')
+    files[service]=files[service].replace(old,new)
+    return files
+
+def install(mode):
+    initialize();booking_id=BINDINGS[mode][0]
+    with host_exclusion(ROOT):
+        if any(p.exists() or p.is_symlink() for p in [ROOT/'lease.json',ROOT/'lease.lock',ROOT/'full-inference-drain.json',ROOT/'full-inference-drain.lock',Path('/run/local-ai-lab-operation.lock')]):raise SessionError('SHARED_HOST_NOT_READY')
+        if json.loads(call(('/usr/local/sbin/local-ai-lease','status')))!={'state':'ready'}:raise SessionError('SHARED_HOST_NOT_READY')
+        booking=ReservationStore(ROOT/'reservations',expected_uid=0).get(booking_id)
+        validate_binding(mode,booking,int(time.time()))
+        if booking['start_epoch']<time.time()+300 or day_window_invalid(booking):raise SessionError('FUTURE_WINDOW_REQUIRED')
+        profile=load_profile(ROOT/'exclusive-activations'/(booking_id+'.json'),PACKAGE)
+        if profile['qualification_only'] is not True or profile['experiment'] is not None:raise SessionError('NO_MODEL_PROFILE_REQUIRED')
+        terminal=ROOT/'exclusive-integrity'/booking_id/'terminal.json';t=json.loads(protected_bytes(terminal));receipt=load_root_owned();items=fixed_proxmox_inventory()
+        cycle=datetime.fromtimestamp(time.time(),ZoneInfo('America/Vancouver')).strftime('%Y_%m_%d')
+        proof=verify(receipt,items,date=cycle,now_epoch=int(time.time()),resolve=fixed_resolve,lstat=os.lstat)
+        verify(receipt,items,date=cycle,now_epoch=booking['start_epoch']+120,resolve=fixed_resolve,lstat=os.lstat)
+        if t.get('booking_id')!=booking_id or t.get('state')!='complete' or t.get('ai_stack_effects') is not False or t.get('archive_receipt')!=proof:raise SessionError('FRESH_COMPLETED_INTEGRITY_REQUIRED')
+        files=recovery_files(mode,booking)
+        if any((UNITS/n).exists() or (UNITS/n).is_symlink() for n in files):raise SessionError('CLOCK_ALREADY_EXISTS')
+        for n,body in files.items():
+            fd=os.open(UNITS/n,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o644)
+            with os.fdopen(fd,'w') as f:f.write(body);f.flush();os.fsync(f.fileno())
