diff --git a/scripts/local-ai/lab_hours_file_checkpoint.py b/scripts/local-ai/lab_hours_file_checkpoint.py
new file mode 100644
index 000000000..3a35fb55a
--- /dev/null
+++ b/scripts/local-ai/lab_hours_file_checkpoint.py
@@ -0,0 +1,149 @@
+"""Source-local configuration checkpoint/restore; never emits file contents.
+
+Used for a declared mutation inventory, not model-weight copies or arbitrary
+root access. The host session must hold the booking, lease and recovery guard.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import stat
+
+
+class CheckpointError(RuntimeError):
+    pass
+
+
+def sha(path):
+    value=hashlib.sha256()
+    with path.open('rb') as stream:
+        for chunk in iter(lambda:stream.read(1024*1024), b''):
+            value.update(chunk)
+    return value.hexdigest()
+
+
+class FileCheckpoint:
+    def __init__(self, root, *, allowed_roots, expected_uid=None):
+        self.root=Path(root)
+        self.allowed=tuple(Path(p) for p in allowed_roots)
+        self.uid=os.geteuid() if expected_uid is None else expected_uid
+
+    def _target(self, raw):
+        path=Path(raw)
+        if (not path.is_absolute() or '..' in path.parts
+                or not any(path != parent and parent in path.parents for parent in self.allowed)):
+            raise CheckpointError('TARGET_OUTSIDE_DECLARED_SCOPE')
+        for component in (path, *path.parents):
+            if component.is_symlink():
+                raise CheckpointError('SYMLINK_TARGET_OR_PARENT')
+        return path
+
+    def _custody(self):
+        st=self.root.lstat()
+        if (not stat.S_ISDIR(st.st_mode) or st.st_uid!=self.uid or st.st_mode&0o077):
+            raise CheckpointError('CHECKPOINT_ROOT_CUSTODY')
+
+    def capture(self, targets):
+        if not isinstance(targets,list) or not 1<=len(targets)<=64 or len(set(targets))!=len(targets):
+            raise CheckpointError('MUTATION_INVENTORY_INVALID')
+        # Never replace a prior recovery checkpoint or follow a staging symlink.
+        self.root.mkdir(mode=0o700,parents=True,exist_ok=False)
+        self._custody()
+        entries=[]
+        for index, raw in enumerate(targets):
+            target=self._target(raw)
+            if not target.parent.is_dir():
+                raise CheckpointError('TARGET_PARENT_ABSENT')
+            row={'path':str(target),'present':target.exists()}
+            if row['present']:
+                fd=os.open(target,os.O_RDONLY|os.O_NOFOLLOW)
+                try:
+                    st=os.fstat(fd)
+                    if not stat.S_ISREG(st.st_mode) or st.st_nlink!=1 or st.st_size>16*1024*1024:
+                        raise CheckpointError('TARGET_NOT_BOUNDED_REGULAR_FILE')
+                    backup=self.root/f'file-{index:03d}'
+                    out=os.open(backup,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o600)
+                    with os.fdopen(out,'wb') as destination, os.fdopen(os.dup(fd),'rb') as source:
+                        shutil.copyfileobj(source,destination)
+                        destination.flush(); os.fsync(destination.fileno())
+                    before=sha(backup)
+                    after=os.stat(target,follow_symlinks=False)
+                    if ((after.st_dev,after.st_ino,after.st_size,after.st_mtime_ns,after.st_ctime_ns)
+                            != (st.st_dev,st.st_ino,st.st_size,st.st_mtime_ns,st.st_ctime_ns)
+                            or before!=sha(target)):
+                        raise CheckpointError('SOURCE_CHANGED_DURING_CAPTURE')
+                    row.update(backup=backup.name,sha256=before,uid=st.st_uid,gid=st.st_gid,
+                               mode=stat.S_IMODE(st.st_mode))
+                finally:
+                    os.close(fd)
+            entries.append(row)
+        manifest={'schema':'aster-private-file-checkpoint.v1','entries':entries}
+        data=json.dumps(manifest,sort_keys=True,separators=(',',':')).encode()
+        fd=os.open(self.root/'manifest.json',os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o600)
+        with os.fdopen(fd,'wb') as handle:
+            handle.write(data); handle.flush(); os.fsync(handle.fileno())
+        directory=os.open(self.root,os.O_RDONLY)
+        try: os.fsync(directory)
+        finally: os.close(directory)
+        return hashlib.sha256(data).hexdigest()
+
+    def manifest(self, expected_sha):
+        self._custody()
+        path=self.root/'manifest.json'
+        st=path.lstat()
+        if (not stat.S_ISREG(st.st_mode) or st.st_uid!=self.uid or st.st_nlink!=1
+                or stat.S_IMODE(st.st_mode)!=0o600 or st.st_size>65536 or sha(path)!=expected_sha):
+            raise CheckpointError('MANIFEST_IDENTITY_OR_CUSTODY')
+        value=json.loads(path.read_bytes())
+        if value.get('schema')!='aster-private-file-checkpoint.v1':
+            raise CheckpointError('MANIFEST_SCHEMA')
+        for row in value['entries']:
+            self._target(row['path'])
+            if row['present']:
+                if Path(row['backup']).name!=row['backup']:
+                    raise CheckpointError('BACKUP_PATH')
+                backup=self.root/row['backup']; st=backup.lstat()
+                if (not stat.S_ISREG(st.st_mode) or st.st_uid!=self.uid or st.st_nlink!=1
+                        or stat.S_IMODE(st.st_mode)!=0o600 or sha(backup)!=row['sha256']):
+                    raise CheckpointError('RECOVERY_COPY_INVALID')
+        return value
+
+    def restore(self, expected_sha):
+        # Verify every recovery copy before the first target mutation.
+        value=self.manifest(expected_sha)
+        for row in value['entries']:
+            target=self._target(row['path'])
+            if not row['present']:
+                if target.exists():
+                    st=target.lstat()
+                    if not stat.S_ISREG(st.st_mode) or st.st_nlink!=1 or st.st_uid!=self.uid:
+                        raise CheckpointError('NEW_TARGET_NOT_OWNED_REGULAR_FILE')
+                    target.unlink()
+            else:
+                temporary=target.with_name(target.name+'.lab-hours-restore')
+                fd=os.open(temporary,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o600)
+                with os.fdopen(fd,'wb') as destination, (self.root/row['backup']).open('rb') as source:
+                    shutil.copyfileobj(source,destination)
+                    os.fchmod(destination.fileno(),row['mode'])
+                    if os.geteuid()==0: os.fchown(destination.fileno(),row['uid'],row['gid'])
+                    destination.flush(); os.fsync(destination.fileno())
+                os.replace(temporary,target)
+            directory=os.open(target.parent,os.O_RDONLY)
+            try: os.fsync(directory)
+            finally: os.close(directory)
+        return self.verify(expected_sha)
+
+    def verify(self, expected_sha):
+        for row in self.manifest(expected_sha)['entries']:
+            target=self._target(row['path'])
+            if target.exists()!=row['present']: return False
+            if row['present']:
+                st=target.lstat()
+                if (not stat.S_ISREG(st.st_mode) or st.st_nlink!=1
+                        or st.st_uid!=row['uid'] or st.st_gid!=row['gid']
+                        or stat.S_IMODE(st.st_mode)!=row['mode'] or sha(target)!=row['sha256']):
+                    return False
+        return True
diff --git a/scripts/local-ai/lab_hours_unit_adapter.py b/scripts/local-ai/lab_hours_unit_adapter.py
new file mode 100644
index 000000000..622d23e28
--- /dev/null
+++ b/scripts/local-ai/lab_hours_unit_adapter.py
@@ -0,0 +1,131 @@
+"""Bounded Proxmox/systemd state adapter; no automatic execution or default runner."""
+from __future__ import annotations
+
+import time
+
+SCOPE = {
+    ('104','aster-agent.service'), ('110','aster-llama.service'),
+    ('116','aster-speech.service'), ('114','news-aggregator-ingest.timer'),
+    ('114','news-aggregator-digest.timer'), ('116','epub-narration-worker.timer'),
+    ('116','epub-narration-worker.service'), ('115','paperless-summary.timer'),
+    ('115','paperless-summary.service'), ('115','paperless-summary-broker.service'),
+}
+ENABLEMENT={'enabled','disabled','static','indirect','masked','masked-runtime','enabled-runtime'}
+
+
+class UnitStateError(RuntimeError): pass
+
+
+class ProxmoxUnitAdapter:
+    def __init__(self, runner, *, clock=time.time):
+        self.runner,self.clock=runner,clock
+
+    def call(self, guest, unit, args, deadline):
+        if (guest,unit) not in SCOPE:
+            raise UnitStateError('UNIT_OUTSIDE_AI_STACK')
+        remaining=deadline-self.clock()
+        if remaining<=0: raise UnitStateError('UNIT_OPERATION_DEADLINE')
+        suffix=() if args==('daemon-reload',) else (unit,)
+        return self.runner(('pct','exec',guest,'--','systemctl',*args,*suffix),min(30.,remaining))
+
+    def observe(self, guest, unit, deadline):
+        code,output=self.call(guest,unit,('show','--no-pager',
+            '--property=LoadState,ActiveState,UnitFileState,MainPID,TasksCurrent'),deadline)
+        if code or len(output)>4096: raise UnitStateError('UNIT_OBSERVATION_FAILED')
+        fields={}
+        for line in output.splitlines():
+            key,sep,value=line.partition('=')
+            if not sep or key in fields: raise UnitStateError('UNIT_OBSERVATION_MALFORMED')
+            fields[key]=value
+        if unit.endswith('.timer'):
+            # Timers have no processes. Their triggered service must separately
+            # appear in the validated caller inventory; never infer its absence.
+            fields.setdefault('MainPID','0')
+            fields.setdefault('TasksCurrent','0')
+        if (set(fields)!={'LoadState','ActiveState','UnitFileState','MainPID','TasksCurrent'}
+                or fields['LoadState'] not in {'loaded','masked'}
+                or fields['ActiveState'] not in {'active','inactive','failed','activating'}
+                or fields['UnitFileState'] not in ENABLEMENT):
+            raise UnitStateError('UNIT_OBSERVATION_UNSUPPORTED')
+        return fields
+
+    def capture(self, inventory, deadline):
+        if (not isinstance(inventory,list) or not inventory
+                or len(inventory)!=len(set(inventory))):
+            raise UnitStateError('UNIT_INVENTORY_INVALID')
+        rows=[]
+        for guest,unit in inventory:
+            fields=self.observe(guest,unit,deadline)
+            running_oneshot=(fields['UnitFileState']=='static'
+                and fields['ActiveState']=='activating'
+                and fields['MainPID'].isdigit() and int(fields['MainPID'])>0
+                and fields['TasksCurrent'].isdigit() and int(fields['TasksCurrent'])>0)
+            if fields['ActiveState'] not in {'active','inactive'} and not running_oneshot:
+                raise UnitStateError('ENTRY_UNIT_NOT_STABLE')
+            # A masked state is kept verbatim, including runtime-vs-persistent.
+            rows.append({'guest':guest,'unit':unit,'active':fields['ActiveState'],
+                         'enablement':fields['UnitFileState']})
+        return rows
+
+    def effect(self, row, args, deadline):
+        code,_=self.call(row['guest'],row['unit'],args,deadline)
+        if code: raise UnitStateError('UNIT_EFFECT_FAILED')
+
+    def isolate(self, entry, deadline):
+        # All callers/timers before the inference backend. Static workers are
+        # stopped, not runtime-masked (systemd oneshot masking is not portable).
+        order=sorted(entry,key=lambda r:r['unit']=='aster-llama.service')
+        for row in order:
+            current=self.observe(row['guest'],row['unit'],deadline)
+            if current['UnitFileState'] in {'static','indirect'}:
+                self.effect(row,('stop',),deadline)
+            elif current['UnitFileState'] in {'masked','masked-runtime'}:
+                self.effect(row,('stop',),deadline)
+            else:
+                self.effect(row,('mask','--runtime','--now'),deadline)
+            after=self.observe(row['guest'],row['unit'],deadline)
+            if (after['ActiveState'] not in {'inactive','failed'} or after['MainPID']!='0'
+                    or after['TasksCurrent'] not in {'0','','[not set]'}):
+                raise UnitStateError('UNIT_NOT_QUIESCENT')
+        return True
+
+    def restore(self, entry, deadline, *, configuration_restored,
+                timer_resume_safe):
+        if configuration_restored is not True:
+            raise UnitStateError('RESTORE_FILES_BEFORE_SERVICES')
+        if any(r['unit'].endswith('.timer') and r['active']=='active' for r in entry) and timer_resume_safe is not True:
+            raise UnitStateError('NO_REPLAY_TIMER_PROOF_REQUIRED')
+        # Explicitly reload recovered unit files before evaluating enablement.
+        for guest in sorted({r['guest'] for r in entry}):
+            unit=next(r['unit'] for r in entry if r['guest']==guest)
+            code,_=self.call(guest,unit,('daemon-reload',),deadline)
+            if code: raise UnitStateError('UNIT_RELOAD_FAILED')
+        # Restore backend and health before callers/timers. Health authentication
+        # is independently required by the enclosing session host adapter.
+        order=sorted(entry,key=lambda r:(r['unit']!='aster-llama.service',r['unit'].endswith('.timer')))
+        for row in order:
+            state=row['enablement']
+            current=self.observe(row['guest'],row['unit'],deadline)
+            if current['UnitFileState']=='masked-runtime' and state!='masked-runtime':
+                self.effect(row,('unmask','--runtime'),deadline)
+            if state=='masked-runtime':
+                self.effect(row,('mask','--runtime'),deadline)
+            elif state in {'enabled','disabled','enabled-runtime'}:
+                # Static/indirect/persistent masks are recovered from files;
+                # never convert them into enabled services by assumption.
+                args=('enable',) if state=='enabled' else (('disable',) if state=='disabled' else ('enable','--runtime'))
+                self.effect(row,args,deadline)
+            self.effect(row,('start','--no-block') if row['active']=='activating'
+                        else (('start',) if row['active']=='active' else ('stop',)),deadline)
+        return self.verify(entry,deadline)
+
+    def verify(self, entry, deadline):
+        for row in entry:
+            current=self.observe(row['guest'],row['unit'],deadline)
+            active_matches=(current['ActiveState']==row['active'] or
+                (row['enablement']=='static' and row['active']=='activating'
+                 and current['ActiveState'] in {'active','activating'}
+                 and current['MainPID'].isdigit() and int(current['MainPID'])>0))
+            if not active_matches or current['UnitFileState']!=row['enablement']:
+                return False
+        return True
diff --git a/scripts/local-ai/test_lab_hours_exclusive_guardian.py b/scripts/local-ai/test_lab_hours_exclusive_guardian.py
new file mode 100644
index 000000000..25a7b1cf6
--- /dev/null
+++ b/scripts/local-ai/test_lab_hours_exclusive_guardian.py
@@ -0,0 +1,49 @@
+import unittest
+
+from lab_hours_exclusive_guardian import guard
+from lab_hours_exclusive_session import SessionError
+import test_lab_hours_exclusive_session as fixtures
+
+
+class GuardianTests(unittest.TestCase):
+    # Reuse only the real temporary durable-store fixture, not its test methods.
+    setUp=fixtures.SessionTests.setUp
+    begin=fixtures.SessionTests.begin
+
+    def test_independent_guardian_fences_lost_owner_then_restores(self):
+        self.begin(); fenced=[]
+        result=guard(self.store,self.adapter,owner='b60-stream-a',
+            owner_alive=lambda state:False,fence_owner=lambda state:fenced.append(state['owner']) or True,
+            clock=lambda:self.now,sleep=lambda seconds:None)
+        self.assertEqual(fenced,['b60-stream-a'])
+        self.assertEqual(result['state'],'rescued')
+
+    def test_alive_owner_still_fenced_at_trial_cutoff(self):
+        self.begin()
+        def advance(seconds): self.now+=seconds
+        result=guard(self.store,self.adapter,owner='b60-stream-a',owner_alive=lambda state:True,
+            fence_owner=lambda state:True,clock=lambda:self.now,sleep=advance)
+        self.assertEqual(self.now,2800)
+        self.assertTrue(result['production_restored'])
+
+    def test_uncertain_owner_fence_prevents_recovery(self):
+        self.begin()
+        with self.assertRaisesRegex(SessionError,'OWNER_SCOPE_NOT_FENCED'):
+            guard(self.store,self.adapter,owner='b60-stream-a',owner_alive=lambda state:False,
+                fence_owner=lambda state:False,clock=lambda:self.now)
+        self.assertNotIn('restore',self.adapter.events)
+
+    def test_wrong_guardian_owner_cannot_touch_stack(self):
+        self.begin()
+        with self.assertRaisesRegex(SessionError,'GUARDIAN_IDENTITY_MISMATCH'):
+            guard(self.store,self.adapter,owner='other-owner',owner_alive=lambda state:False,
+                fence_owner=lambda state:True,clock=lambda:self.now)
+        self.assertNotIn('fence',self.adapter.events)
+
+    def test_already_released_session_is_not_replayed(self):
+        self.begin(); self.session.recover(owner='b60-stream-a')
+        count=len(self.adapter.events)
+        self.assertEqual(guard(self.store,self.adapter,owner='b60-stream-a',
+            owner_alive=lambda state:False,fence_owner=lambda state:True,
+            clock=lambda:self.now)['state'],'complete')
+        self.assertEqual(len(self.adapter.events),count)
