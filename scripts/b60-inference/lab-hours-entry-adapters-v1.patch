index 000000000..c8cc416b3
--- /dev/null
+++ b/scripts/local-ai/lab_hours_exclusive_guardian.py
@@ -0,0 +1,35 @@
+"""Independent-process guardian loop for durable exclusive sessions.
+
+No arbitrary command or model is accepted. The enclosing host adapter binds
+the exact owner scope and constructs recovery from root-custodied state.
+"""
+from __future__ import annotations
+
+import time
+
+from lab_hours_exclusive_session import ExclusiveSession, SessionError
+
+
+def guard(store, adapter, *, owner, owner_alive, fence_owner,
+          clock=time.time, sleep=time.sleep):
+    """A standalone guardian process needs no connection to chat or the mini.
+
+    Owner fencing must stop the entire exact scope, prove zero tasks, and be
+    idempotent. Failure retains state and refuses restoration over live work.
+    """
+    while True:
+        state=store.read('session.json')
+        if state.get('schema')!='aster-exclusive-session.v1' or state.get('owner')!=owner:
+            raise SessionError('GUARDIAN_IDENTITY_MISMATCH')
+        if state['phase']=='released':
+            return {'state':'complete','recovery_attempted':False}
+        if state['phase']=='released-late':
+            raise SessionError('RESTORED_AFTER_DEADLINE')
+        now=clock()
+        if now>=state['trial_deadline'] or owner_alive(state) is not True:
+            if fence_owner(state) is not True:
+                raise SessionError('OWNER_SCOPE_NOT_FENCED')
+            result=ExclusiveSession(store,adapter,clock=clock).recover(owner=owner)
+            return {'state':'rescued','recovery_attempted':True,
+                    'production_restored':result['production_restored']}
+        sleep(min(5.,max(0.1,state['trial_deadline']-now)))
