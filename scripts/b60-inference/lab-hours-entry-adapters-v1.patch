@@ -0,0 +1,59 @@
+"""Real process-loss/durable-file tests, with simulated stack effects only."""
+import multiprocessing
+import os
+from pathlib import Path
+import tempfile
+import time
+import unittest
+
+from lab_hours_exclusive_guardian import guard
+from lab_hours_exclusive_session import ExclusiveSession, SessionStore
+from test_lab_hours_exclusive_session import Adapter
+
+
+def owner_process(root, ready, stay_alive):
+    booking={'kind':'exclusive-stack','state':'reserved','owner':'b60-stream-a',
+        'booking_id':'b60-process-fixture','start_epoch':1000,'end_epoch':3700}
+    ExclusiveSession(SessionStore(root),Adapter(),clock=lambda:1000).begin(
+        booking,owner='b60-stream-a')
+    ready.set()
+    if not stay_alive:
+        # Deliberately skip Python finalizers to exercise the durable boundary.
+        os._exit(0)
+    while True:
+        time.sleep(0.1)
+
+
+class ProcessRecoveryTests(unittest.TestCase):
+    def exercise(self, stay_alive):
+        with tempfile.TemporaryDirectory() as temporary:
+            root=Path(temporary)/'session'
+            context=multiprocessing.get_context('spawn')
+            ready=context.Event()
+            process=context.Process(target=owner_process,args=(root,ready,stay_alive))
+            process.start()
+            try:
+                self.assertTrue(ready.wait(8),'owner never persisted its checkpoint')
+                if not stay_alive: process.join(8)
+                adapter=Adapter()
+                def fence(state):
+                    if process.is_alive(): process.terminate()
+                    process.join(8)
+                    return not process.is_alive()
+                result=guard(SessionStore(root),adapter,owner='b60-stream-a',
+                    owner_alive=lambda state:False,fence_owner=fence,clock=lambda:1100)
+                self.assertEqual(result['state'],'rescued')
+                self.assertTrue(SessionStore(root).read('session.json')['production_restored'])
+                self.assertEqual(adapter.events,['fence','restore','verify','release'])
+            finally:
+                if process.is_alive(): process.terminate()
+                process.join(8)
+
+    def test_abrupt_owner_exit_recovers_from_durable_state(self):
+        self.exercise(False)
+
+    def test_independent_guardian_fences_a_separate_live_owner(self):
+        self.exercise(True)
+
+
+if __name__=='__main__': unittest.main()
