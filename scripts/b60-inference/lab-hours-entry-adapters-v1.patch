+import unittest
+from lab_hours_unit_adapter import ProxmoxUnitAdapter, UnitStateError
+
+
+class Systemd:
+    def __init__(self):
+        self.calls=[]
+        self.units={('110','aster-llama.service'):['active','enabled'],
+                    ('114','news-aggregator-ingest.timer'):['inactive','disabled'],
+                    ('116','epub-narration-worker.service'):['active','static']}
+
+    def __call__(self,command,timeout):
+        self.calls.append((command,timeout)); guest=command[2]; unit=command[-1]
+        if command[-1]=='daemon-reload': return 0,''
+        args=command[5:-1]; state=self.units[(guest,unit)]
+        if args[0]=='show':
+            active,enabled=state
+            base=f'LoadState=loaded\nActiveState={active}\nUnitFileState={enabled}\n'
+            if unit.endswith('.timer'): return 0,base
+            return 0,base+f'MainPID={123 if active in {"active","activating"} else 0}\nTasksCurrent={1 if active in {"active","activating"} else 0}\n'
+        if args[0]=='mask':
+            state[1]='masked-runtime'
+            if '--now' in args: state[0]='inactive'
+        elif args[0]=='unmask': state[1]='disabled'
+        elif args[0]=='enable': state[1]='enabled-runtime' if '--runtime' in args else 'enabled'
+        elif args[0]=='disable': state[1]='disabled'
+        elif args[0]=='start': state[0]='active'
+        elif args[0]=='stop': state[0]='inactive'
+        return 0,''
+
+
+class UnitAdapterTests(unittest.TestCase):
+    def setUp(self):
+        self.runner=Systemd(); self.now=1000
+        self.adapter=ProxmoxUnitAdapter(self.runner,clock=lambda:self.now)
+        self.inventory=list(self.runner.units)
+
+    def test_round_trip_original_inactive_timer_and_static_worker(self):
+        entry=self.adapter.capture(self.inventory,1100)
+        self.assertTrue(self.adapter.isolate(entry,1100))
+        self.assertTrue(self.adapter.restore(entry,1100,configuration_restored=True,timer_resume_safe=True))
+        self.assertEqual(self.runner.units[('114','news-aggregator-ingest.timer')],['inactive','disabled'])
+        self.assertEqual(self.runner.units[('116','epub-narration-worker.service')],['active','static'])
+
+    def test_static_worker_is_never_runtime_masked(self):
+        entry=self.adapter.capture(self.inventory,1100); self.adapter.isolate(entry,1100)
+        self.assertFalse(any(c[-1]=='epub-narration-worker.service' and 'mask' in c for c,_ in self.runner.calls))
+
+    def test_original_runtime_mask_is_preserved(self):
+        self.runner.units[('114','news-aggregator-ingest.timer')]=['inactive','masked-runtime']
+        entry=self.adapter.capture(self.inventory,1100)
+        self.adapter.isolate(entry,1100)
+        self.assertTrue(self.adapter.restore(entry,1100,configuration_restored=True,timer_resume_safe=True))
+
+    def test_requires_file_recovery_before_service_restart(self):
+        entry=self.adapter.capture(self.inventory,1100)
+        with self.assertRaisesRegex(UnitStateError,'FILES_BEFORE'):
+            self.adapter.restore(entry,1100,configuration_restored=False,timer_resume_safe=True)
+
+    def test_active_timer_requires_no_replay_proof(self):
+        self.runner.units[('114','news-aggregator-ingest.timer')]=['active','enabled']
+        entry=self.adapter.capture(self.inventory,1100)
+        with self.assertRaisesRegex(UnitStateError,'NO_REPLAY'):
+            self.adapter.restore(entry,1100,configuration_restored=True,timer_resume_safe=False)
+
+    def test_deadline_and_scope_fail_before_command(self):
+        with self.assertRaisesRegex(UnitStateError,'DEADLINE'):
+            self.adapter.observe('110','aster-llama.service',999)
+        with self.assertRaisesRegex(UnitStateError,'OUTSIDE'):
+            self.adapter.observe('103','home-assistant.service',1100)
+        self.assertEqual(self.runner.calls,[])
+
+    def test_backend_is_isolated_last_and_restored_first(self):
+        entry=self.adapter.capture(self.inventory,1100); self.runner.calls=[]
+        self.adapter.isolate(entry,1100)
+        effects=[c for c,_ in self.runner.calls if c[5]!='show']
+        self.assertEqual(effects[-1][-1],'aster-llama.service')
+        self.runner.calls=[]
+        self.adapter.restore(entry,1100,configuration_restored=True,timer_resume_safe=True)
+        starts=[c for c,_ in self.runner.calls if c[5]=='start']
+        self.assertEqual(starts[0][-1],'aster-llama.service')
+
+    def test_each_command_receives_remaining_timeout(self):
+        self.adapter.capture(self.inventory,1004)
+        self.assertTrue(all(timeout==4 for _,timeout in self.runner.calls))
+
+    def test_daemon_reload_has_no_unit_argument(self):
+        entry=self.adapter.capture(self.inventory,1100)
+        self.adapter.isolate(entry,1100)
+        self.adapter.restore(entry,1100,configuration_restored=True,timer_resume_safe=True)
+        reloads=[c for c,_ in self.runner.calls if 'daemon-reload' in c]
+        self.assertTrue(reloads)
+        self.assertTrue(all(c[-1]=='daemon-reload' for c in reloads))
+
+    def test_real_timer_missing_process_fields_are_valid_only_for_timers(self):
+        value=self.adapter.observe('114','news-aggregator-ingest.timer',1100)
+        self.assertEqual(value['MainPID'],'0')
+
+    def test_running_static_oneshot_is_restored_without_blocking(self):
+        self.runner.units[('116','epub-narration-worker.service')]=['activating','static']
+        entry=self.adapter.capture(self.inventory,1100)
+        self.adapter.isolate(entry,1100)
+        self.assertTrue(self.adapter.restore(entry,1100,configuration_restored=True,timer_resume_safe=True))
+        self.assertTrue(any(c[-1]=='epub-narration-worker.service' and '--no-block' in c
+                            for c,_ in self.runner.calls))
+
+
+if __name__=='__main__': unittest.main()
