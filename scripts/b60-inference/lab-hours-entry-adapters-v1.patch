+import os
+from pathlib import Path
+import tempfile
+import unittest
+
+from lab_hours_file_checkpoint import FileCheckpoint, CheckpointError
+
+
+class FileCheckpointTests(unittest.TestCase):
+    def setUp(self):
+        self.temp=tempfile.TemporaryDirectory(); self.addCleanup(self.temp.cleanup)
+        self.base=Path(self.temp.name).resolve(); self.config=self.base/'configuration'
+        self.config.mkdir(); self.original=self.config/'service.conf'
+        self.original.write_bytes(b'private-bytes-stay-source-local')
+        self.original.chmod(0o640)
+        self.new=self.config/'candidate.conf'
+        self.check=FileCheckpoint(self.base/'checkpoint',allowed_roots=[self.config])
+
+    def capture(self): return self.check.capture([str(self.original),str(self.new)])
+
+    def test_real_files_round_trip_bytes_mode_and_original_absence(self):
+        identity=self.capture()
+        self.original.write_bytes(b'candidate'); self.original.chmod(0o600)
+        self.new.write_text('temporary candidate')
+        self.assertFalse(self.check.verify(identity))
+        self.assertTrue(self.check.restore(identity))
+        self.assertEqual(self.original.read_bytes(),b'private-bytes-stay-source-local')
+        self.assertEqual(self.original.stat().st_mode&0o777,0o640)
+        self.assertFalse(self.new.exists())
+
+    def test_recovery_reentry_from_fresh_object_is_idempotent(self):
+        identity=self.capture(); self.original.unlink()
+        recovery=FileCheckpoint(self.check.root,allowed_roots=[self.config])
+        self.assertTrue(recovery.restore(identity))
+        self.assertTrue(recovery.restore(identity))
+
+    def test_recovery_copy_corruption_prevents_any_target_mutation(self):
+        identity=self.capture(); self.original.write_text('candidate')
+        (self.check.root/'file-000').write_text('bad recovery copy')
+        with self.assertRaisesRegex(CheckpointError,'RECOVERY_COPY_INVALID'):
+            self.check.restore(identity)
+        self.assertEqual(self.original.read_text(),'candidate')
+
+    def test_checkpoint_is_not_overwritten(self):
+        self.capture()
+        with self.assertRaises(FileExistsError): self.capture()
+
+    def test_symlink_and_out_of_scope_targets_rejected(self):
+        self.original.unlink(); self.original.symlink_to(self.base/'elsewhere')
+        with self.assertRaisesRegex(CheckpointError,'SYMLINK'): self.capture()
+        with tempfile.TemporaryDirectory() as other:
+            check=FileCheckpoint(Path(other)/'checkpoint',allowed_roots=[self.config])
+            with self.assertRaisesRegex(CheckpointError,'OUTSIDE'):
+                check.capture([str(self.base/'not-declared')])
+
+    def test_manifest_is_content_free_and_custodied(self):
+        identity=self.capture()
+        manifest=self.check.root/'manifest.json'
+        self.assertNotIn('private-bytes',manifest.read_text())
+        self.assertEqual(manifest.stat().st_mode&0o777,0o600)
+        manifest.chmod(0o644)
+        with self.assertRaisesRegex(CheckpointError,'CUSTODY'): self.check.verify(identity)
+
+    def test_hardlinked_files_rejected(self):
+        os.link(self.original,self.config/'alias')
+        with self.assertRaisesRegex(CheckpointError,'BOUNDED_REGULAR'): self.capture()
+
+    def test_manifest_drift_rejected_before_restore(self):
+        identity=self.capture(); (self.check.root/'manifest.json').write_text('{}')
+        with self.assertRaisesRegex(CheckpointError,'IDENTITY'): self.check.restore(identity)
+
+    def test_preexisting_restore_temporary_is_never_overwritten(self):
+        identity=self.capture()
+        temporary=self.original.with_name(self.original.name+'.lab-hours-restore')
+        temporary.write_text('retained uncertainty')
+        with self.assertRaises(FileExistsError): self.check.restore(identity)
+        self.assertEqual(temporary.read_text(),'retained uncertainty')
+
+
+if __name__=='__main__': unittest.main()
