index 000000000..d4b273ac9
--- /dev/null
+++ b/scripts/local-ai/lab_hours_source_update_host.py
@@ -0,0 +1,156 @@
+"""Protected host source adapter; no model/service effects and no activation."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import stat
+import subprocess
+
+from host_exclusion import host_exclusion
+from install_lab_hours_exclusive_dormant import source_bundle, directory
+from lab_hours_exclusive_profile import protected_bytes
+from lab_hours_exclusive_session import SessionStore, SessionError, canonical
+from lab_hours_file_checkpoint import FileCheckpoint
+from lab_hours_source_update import SourceUpdate, CHANGED, transition
+
+ROOT=Path('/var/lib/local-ai-lab')
+TARGET=Path('/usr/local/libexec/local-ai-lease/exclusive-session')
+
+
+def call(command):
+    p=subprocess.run(command,capture_output=True,text=True,timeout=30)
+    if p.returncode or len(p.stdout)>262144: raise SessionError('SOURCE_HOST_PROBE_FAILED')
+    return p.stdout
+
+
+def idle():
+    for p in [ROOT/n for n in ('lease.json','lease.lock','full-inference-drain.json',
+                              'full-inference-drain.lock')]+[Path('/run/local-ai-lab-operation.lock')]:
+        if p.exists() or p.is_symlink(): return False
+    if json.loads(call(('/usr/local/sbin/local-ai-lease','status'))) not in ('ready',{'state':'ready'}):
+        return False
+    for kind in ('owner','guardian'):
+        raw=call(('systemctl','list-units','--all','--plain','--no-legend','--no-pager',
+                  'b60-exclusive-'+kind+'-*'))
+        for line in raw.splitlines():
+            columns=line.split()
+            if len(columns)<4 or columns[2] not in ('inactive','failed'): return False
+    raw=call(('systemctl','list-units','--all','--plain','--no-legend','--no-pager',
+              'b60-exclusive-*.timer'))
+    for line in raw.splitlines():
+        name=line.split()[0]
+        fields=call(('systemctl','show',name,'--property=NextElapseUSecRealtime'))
+        if fields.strip()!='NextElapseUSecRealtime=': return False
+    for p in (ROOT/'exclusive-sessions').glob('*/session.json'):
+        value=json.loads(protected_bytes(p))
+        if value.get('phase') not in ('released','released-late','aborted-before-claim'): return False
+    for p in (ROOT/'reservations/records').glob('*.json'):
+        if json.loads(protected_bytes(p)).get('state')=='claimed': return False
+    return True
+
+
+class HostSourceAdapter:
+    def __init__(self,target,candidate,checkpoint,old,new,*,guard,reader=protected_bytes,
+                 uid=0,imports=None):
+        self.target,self.candidate,self.root=map(Path,(target,candidate,checkpoint))
+        self.old,self.new,self.guard,self.reader=old,new,guard,reader
+        self.uid=uid; self.imports=imports
+        self.files=FileCheckpoint(self.root/'files',allowed_roots=(),
+            allowed_files=[self.target/n for n in CHANGED],expected_uid=uid)
+
+    def preflight(self,plan): return self.guard() is True
+
+    def observe_pins(self):
+        if set(p.name for p in self.target.iterdir())!=set(self.old):
+            raise SessionError('SOURCE_HOST_FILE_SET_DRIFT')
+        return {n:hashlib.sha256(self.reader(self.target/n,executable=True,
+                    maximum=262144)).hexdigest() for n in self.old}
+
+    def checkpoint(self,names,old):
+        if tuple(names)!=CHANGED or self.observe_pins()!=old:
+            raise SessionError('SOURCE_HOST_CHECKPOINT_SCOPE')
+        return self.files.capture([str(self.target/n) for n in names])
+
+    def verify_checkpoint(self,digest,old):
+        manifest=self.files.manifest(digest)
+        rows=manifest['entries']
+        return (len(rows)==2 and {r['path'] for r in rows}=={str(self.target/n) for n in CHANGED}
+            and all(r['present'] is True and r['sha256']==old[Path(r['path']).name]
+                    and r['uid']==self.uid and r['mode']==0o600 for r in rows))
+
+    def _replace(self,name,expected,data,mode=0o600,gid=None,tag='new'):
+        if name not in CHANGED or self.guard() is not True:
+            raise SessionError('SOURCE_HOST_EFFECT_SCOPE')
+        target=self.target/name
+        current=self.reader(target,executable=True,maximum=262144)
+        if hashlib.sha256(current).hexdigest()!=expected:
+            raise SessionError('SOURCE_HOST_COMPARE_FAILED')
+        if os.stat(self.root).st_dev!=os.stat(self.target).st_dev:
+            raise SessionError('SOURCE_HOST_ATOMIC_FILESYSTEM_REQUIRED')
+        temporary=self.root/(name+'.'+tag)
+        fd=os.open(temporary,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o600)
+        with os.fdopen(fd,'wb') as handle:
+            handle.write(data); os.fchmod(handle.fileno(),mode)
+            if os.geteuid()==0: os.fchown(handle.fileno(),self.uid,gid if gid is not None else 0)
+            handle.flush(); os.fsync(handle.fileno())
+        # Recheck immediately before compare/replace under the held host lock.
+        if hashlib.sha256(self.reader(target,executable=True,maximum=262144)).hexdigest()!=expected:
+            raise SessionError('SOURCE_HOST_COMPARE_FAILED')
+        os.replace(temporary,target)
+        fd=os.open(self.target,os.O_RDONLY)
+        try: os.fsync(fd)
+        finally: os.close(fd)
+        return True
+
+    def replace_source(self,name,old,new):
+        data=self.reader(self.candidate/name,executable=True,maximum=262144)
+        if new!=self.new.get(name) or hashlib.sha256(data).hexdigest()!=new:
+            raise SessionError('SOURCE_HOST_CANDIDATE_DRIFT')
+        return self._replace(name,old,data)
+
+    def restore_source(self,name,current,old,digest):
+        if old!=self.old.get(name) or not self.verify_checkpoint(digest,self.old):
+            raise SessionError('SOURCE_HOST_RECOVERY_DRIFT')
+        row=next(r for r in self.files.manifest(digest)['entries'] if r['path']==str(self.target/name))
+        data=self.reader(self.files.root/row['backup'],maximum=262144)
+        if hashlib.sha256(data).hexdigest()!=old: raise SessionError('SOURCE_HOST_RECOVERY_DRIFT')
+        return self._replace(name,current,data,row['mode'],row['gid'],'old')
+
+    def validate_imports(self,pins):
+        if self.observe_pins()!=pins: return False
+        if self.imports is not None: return self.imports(pins) is True
+        code='import sys;sys.path.insert(0,sys.argv[1]);[__import__(n[:-3]) for n in sys.argv[2:]]'
+        call(('/usr/bin/python3','-B','-I','-c',code,str(self.target),*sorted(pins)))
+        return self.observe_pins()==pins
+
+
+def operate(args):
+    if os.geteuid()!=0 or os.uname().nodename!='proxmox': raise SessionError('PROXMOX_ROOT_REQUIRED')
+    if args.attempt.parent!=ROOT/'source-updates' or args.attempt.name!='diagnostics-20261101-v1':
+        raise SessionError('SOURCE_HOST_ATTEMPT_IDENTITY')
+    old=source_bundle(args.old_bundle,args.old_sha256)
+    new=source_bundle(args.new_bundle,args.new_sha256)
+    transition(old,new)
+    with host_exclusion(ROOT):
+        if not idle(): raise SessionError('SOURCE_UPDATE_HOST_NOT_PROVEN_IDLE')
+        if args.action=='apply' and args.attempt.exists(): raise SessionError('SOURCE_UPDATE_ATTEMPT_ALREADY_EXISTS')
+        directory(args.attempt)
+        adapter=HostSourceAdapter(TARGET,args.new_bundle/'exclusive-session',args.attempt,
+                                  old,new,guard=idle)
+        core=SourceUpdate(SessionStore(args.attempt/'journal',expected_uid=0),adapter,old,new)
+        if args.action=='apply': return core.apply()
+        if args.action=='rollback': return core.rollback()
+        return core.resolve_pending_rollback()
+
+
+if __name__=='__main__':
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('action',choices=('apply','rollback','resolve-pending'))
+    for name in ('old-bundle','new-bundle','attempt'): p.add_argument('--'+name,type=Path,required=True)
+    for name in ('old-sha256','new-sha256'): p.add_argument('--'+name,required=True)
+    try:
+        print(json.dumps(operate(p.parse_args()),sort_keys=True))
+    except Exception as error:
+        print(json.dumps({'state':'no_go','failure_code':str(error) if isinstance(error,SessionError)
+                          else type(error).__name__},sort_keys=True)); raise SystemExit(1)
