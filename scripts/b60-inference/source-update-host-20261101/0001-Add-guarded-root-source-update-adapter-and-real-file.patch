index 000000000..61af521fb
--- /dev/null
+++ b/scripts/local-ai/test_lab_hours_source_update_host.py
@@ -0,0 +1,82 @@
+"""Real disposable file replacement and real child loss, fake host-idle proof."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import stat
+import tempfile
+import unittest
+
+from lab_hours_exclusive_session import SessionStore,SessionError
+from lab_hours_source_update import SourceUpdate,CHANGED
+from lab_hours_source_update_host import HostSourceAdapter
+
+OLD_BUNDLE=Path(os.environ.get('B60_OLD_SOURCE_BUNDLE',
+    '/private/tmp/b60-exclusive-source-bundle-20261029-v4'))
+NEW_BUNDLE=Path(os.environ.get('B60_NEW_SOURCE_BUNDLE',
+    '/private/tmp/b60-exclusive-diagnostics-20261031-nightly-v1'))
+
+
+class HostAdapterTests(unittest.TestCase):
+    def setUp(self):
+        if not OLD_BUNDLE.exists() or not NEW_BUNDLE.exists():
+            self.fail('EXACT_SOURCE_BUNDLES_REQUIRED')
+        temp=tempfile.TemporaryDirectory(); self.addCleanup(temp.cleanup)
+        self.root=Path(temp.name).resolve(); self.target=self.root/'target'
+        shutil.copytree(OLD_BUNDLE/'exclusive-session',self.target)
+        self.newdir=self.root/'candidate'; shutil.copytree(NEW_BUNDLE/'exclusive-session',self.newdir)
+        self.old=json.loads((OLD_BUNDLE/'source-manifest.json').read_bytes())['pins']
+        self.new=json.loads((NEW_BUNDLE/'source-manifest.json').read_bytes())['pins']
+        self.stage=self.root/'stage'; self.stage.mkdir(mode=0o700)
+        self.store=SessionStore(self.stage/'journal')
+        def reader(path,**kwargs):
+            p=Path(path); s=p.lstat()
+            if not stat.S_ISREG(s.st_mode) or p.is_symlink() or s.st_nlink!=1:
+                raise SessionError('FIXTURE_FILE_CUSTODY')
+            return p.read_bytes()
+        self.adapter=HostSourceAdapter(self.target,self.newdir,self.stage,self.old,self.new,
+            guard=lambda:True,reader=reader,uid=os.getuid(),imports=lambda pins:True)
+        self.core=SourceUpdate(self.store,self.adapter,self.old,self.new)
+
+    def test_real_file_round_trip_and_modes(self):
+        self.assertEqual(self.core.apply()['state'],'installed-not-activated')
+        self.assertEqual(self.adapter.observe_pins(),self.new)
+        self.core.rollback()
+        self.assertEqual(self.adapter.observe_pins(),self.old)
+        for name in CHANGED:self.assertEqual((self.target/name).stat().st_mode&0o777,0o600)
+
+    def test_real_candidate_corruption_rolls_back_without_unknown_overwrite(self):
+        (self.newdir/CHANGED[1]).write_bytes(b'corrupt candidate')
+        self.assertEqual(self.core.apply()['state'],'failed-rolled-back')
+        self.assertEqual(self.adapter.observe_pins(),self.old)
+
+    def test_real_import_failure_restores_old_bytes(self):
+        self.adapter.imports=lambda pins:pins==self.old
+        self.assertEqual(self.core.apply()['state'],'failed-rolled-back')
+        self.assertEqual(self.adapter.observe_pins(),self.old)
+
+    def test_real_child_loss_after_each_atomic_rename(self):
+        for index,name in enumerate(CHANGED):
+            stage=self.root/f'child-{index}';stage.mkdir(mode=0o700)
+            store=SessionStore(stage/'journal')
+            adapter=HostSourceAdapter(self.target,self.newdir,stage,self.old,self.new,
+                guard=lambda:True,reader=self.adapter.reader,uid=os.getuid(),imports=lambda pins:True)
+            replace=adapter.replace_source
+            def terminate(module,old,new):
+                result=replace(module,old,new)
+                if module==name:os._exit(71)
+                return result
+            adapter.replace_source=terminate
+            pid=os.fork()
+            if pid==0:
+                SourceUpdate(store,adapter,self.old,self.new).apply();os._exit(72)
+            _,status=os.waitpid(pid,0)
+            self.assertEqual(os.waitstatus_to_exitcode(status),71)
+            adapter.replace_source=replace
+            SourceUpdate(store,adapter,self.old,self.new).rollback()
+            self.assertEqual(adapter.observe_pins(),self.old)
+
+    def test_extra_source_or_symlink_is_not_accepted(self):
+        extra=self.target/'extra.py';extra.write_bytes(b'')
+        with self.assertRaisesRegex(SessionError,'FILE_SET_DRIFT'):self.core.apply()
