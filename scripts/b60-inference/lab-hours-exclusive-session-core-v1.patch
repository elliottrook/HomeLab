+++ b/scripts/local-ai/test_lab_hours_exclusive_session.py
@@ -0,0 +1,206 @@
+import copy
+import json
+import os
+from pathlib import Path
+import tempfile
+import unittest
+
+from lab_hours_exclusive_session import ExclusiveSession, SessionError, SessionStore, validate_snapshot
+
+
+def snapshot():
+    return {'schema':'aster-entry-snapshot.v1', 'model_sha256':'1'*64,
+        'runtime_sha256':'2'*64, 'configuration_sha256':'3'*64,
+        'checkpoint_sha256':'4'*64,
+        'units':[{'guest':'110','unit':'aster-llama.service','active':True,
+                  'enabled':False,'runtime_masked':False},
+                 {'guest':'114','unit':'news-aggregator-ingest.timer','active':False,
+                  'enabled':True,'runtime_masked':True}],
+        'mounts':[{'identity_sha256':'5'*64,'present':True,'readonly':True}]}
+
+
+class Adapter:
+    def __init__(self):
+        self.events=[]
+        self.entry=snapshot()
+        self.fault=None
+
+    def operation(self, name):
+        self.events.append(name)
+        return self.fault != name
+
+    def admit(self, booking): return self.operation('admit')
+    def capture(self):
+        self.operation('capture')
+        return self.entry
+    def verify_checkpoint(self, entry): return self.operation('checkpoint')
+    def arm_guardian(self, state): return self.operation('guardian')
+    def isolate(self, state): return self.operation('isolate')
+    def execute(self, state, deadline): return self.operation('execute')
+    def fence_experiments(self, state): return self.operation('fence')
+    def restore(self, entry, deadline):
+        self.restored=copy.deepcopy(entry)
+        return self.operation('restore')
+    def verify_entry(self, entry): return self.operation('verify')
+    def release(self, state): return self.operation('release')
+
+
+class SessionTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp=tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root=Path(self.tmp.name)/'session'
+        self.store=SessionStore(self.root)
+        self.adapter=Adapter()
+        self.now=1000
+        self.session=ExclusiveSession(self.store,self.adapter,clock=lambda:self.now)
+        self.booking={'kind':'exclusive-stack','state':'reserved','owner':'b60-stream-a',
+            'booking_id':'b60-exclusive-20261030','start_epoch':1000,'end_epoch':3700}
+
+    def begin(self): return self.session.begin(self.booking,owner='b60-stream-a')
+
+    def test_durable_checkpoint_precedes_guardian_and_isolation(self):
+        self.begin()
+        self.assertEqual(self.adapter.events,['admit','capture','checkpoint','guardian','isolate'])
+        self.assertEqual(self.store.read('entry.json'),snapshot())
+        self.assertEqual((self.root/'entry.json').stat().st_mode&0o777,0o600)
+
+    def test_restore_exact_entry_not_hardcoded_model_or_all_services_active(self):
+        self.adapter.entry['model_sha256']='a'*64
+        self.begin()
+        result=self.session.run_trial(owner='b60-stream-a')
+        self.assertEqual(result['outcome'],'complete-restored')
+        self.assertEqual(self.adapter.restored,self.adapter.entry)
+        self.assertFalse(self.adapter.restored['units'][1]['active'])
+        self.assertTrue(self.adapter.restored['units'][1]['runtime_masked'])
+        self.assertEqual(self.adapter.events[-4:],['fence','restore','verify','release'])
+
+    def test_failed_trial_restores_without_retry(self):
+        self.begin(); self.adapter.fault='execute'
+        self.assertEqual(self.session.run_trial(owner='b60-stream-a')['outcome'],'failed-restored')
+        self.assertEqual(self.adapter.events.count('execute'),1)
+        with self.assertRaisesRegex(SessionError,'TRIAL_OWNER_OR_PHASE'):
+            self.session.run_trial(owner='b60-stream-a')
+
+    def test_interrupted_owner_recovery_uses_only_durable_entry(self):
+        self.begin()
+        recovery=ExclusiveSession(SessionStore(self.root),self.adapter,clock=lambda:1100)
+        self.assertEqual(recovery.recover(owner='b60-stream-a')['phase'],'released')
+
+    def test_guardian_failure_prevents_isolation(self):
+        self.adapter.fault='guardian'
+        with self.assertRaisesRegex(SessionError,'GUARDIAN_NOT_ARMED'): self.begin()
+        self.assertNotIn('isolate',self.adapter.events)
+        self.assertFalse(self.store.read('session.json')['production_restored'])
+
+    def test_partial_isolation_failure_retains_recoverable_state(self):
+        self.adapter.fault='isolate'
+        with self.assertRaisesRegex(SessionError,'ISOLATION_UNCERTAIN'): self.begin()
+        self.adapter.fault=None
+        self.assertEqual(self.session.recover(owner='b60-stream-a')['phase'],'released')
+
+    def test_fence_uncertainty_never_restores_over_surviving_experiment(self):
+        self.begin(); self.adapter.fault='fence'
+        with self.assertRaisesRegex(SessionError,'FENCE_UNCERTAIN'):
+            self.session.recover(owner='b60-stream-a')
+        self.assertNotIn('restore',self.adapter.events)
+        self.assertNotIn('release',self.adapter.events)
+
+    def test_restore_or_verification_failure_retains_ownership(self):
+        for fault in ('restore','verify'):
+            with self.subTest(fault=fault):
+                if not (self.root/'session.json').exists(): self.begin()
+                self.adapter.fault=fault
+                with self.assertRaises(SessionError): self.session.recover(owner='b60-stream-a')
+                self.assertFalse(self.store.read('session.json')['production_restored'])
+                self.assertNotIn('release',self.adapter.events)
+
+    def test_release_failure_keeps_restored_state_for_reentry(self):
+        self.begin(); self.adapter.fault='release'
+        with self.assertRaisesRegex(SessionError,'RELEASE_UNCERTAIN'):
+            self.session.recover(owner='b60-stream-a')
+        self.assertEqual(self.store.read('session.json')['phase'],'restored')
+        self.adapter.fault=None
+        self.assertEqual(self.session.recover(owner='b60-stream-a')['phase'],'released')
+
+    def test_checkpoint_drift_wrong_owner_and_duplicate_entry_rejected(self):
+        self.begin()
+        with self.assertRaisesRegex(SessionError,'ALREADY_EXISTS'): self.begin()
+        with self.assertRaisesRegex(SessionError,'OWNER_MISMATCH'):
+            self.session.recover(owner='other-owner')
+        entry=self.store.read('entry.json'); entry['model_sha256']='a'*64
+        self.store.write('entry.json',entry)
+        with self.assertRaisesRegex(SessionError,'IDENTITY_CHANGED'):
+            self.session.recover(owner='b60-stream-a')
+
+    def test_budget_reserves_900_seconds_and_trial_never_exceeds_1800(self):
+        self.booking['end_epoch']=3699
+        with self.assertRaisesRegex(SessionError,'INSUFFICIENT_WINDOW'): self.begin()
+        self.booking['end_epoch']=4000
+        with self.assertRaisesRegex(SessionError,'INSUFFICIENT_WINDOW'):
+            self.session.begin(self.booking,owner='b60-stream-a',trial_seconds=1801)
+        self.assertEqual(self.adapter.events,[])
+
+    def test_expired_trial_skips_execute_and_recovers(self):
+        self.begin(); self.now=2800
+        self.assertEqual(self.session.run_trial(owner='b60-stream-a')['outcome'],'failed-restored')
+        self.assertNotIn('execute',self.adapter.events)
+
+    def test_missing_checkpoint_proof_prevents_effects(self):
+        self.adapter.fault='checkpoint'
+        with self.assertRaisesRegex(SessionError,'NOT_RECOVERABLE'): self.begin()
+        self.assertNotIn('guardian',self.adapter.events)
+
+    def test_raw_configuration_and_unsupported_unit_states_rejected(self):
+        value=snapshot(); value['token']='never-store-private-values'
+        with self.assertRaisesRegex(SessionError,'SNAPSHOT_SCHEMA'): validate_snapshot(value)
+        value=snapshot(); value['units'][0]['active']='failed'
+        with self.assertRaisesRegex(SessionError,'UNSUPPORTED'): validate_snapshot(value)
+
+    def test_snapshot_copy_does_not_alias_input(self):
+        value=snapshot(); frozen=validate_snapshot(value)
+        value['units'][0]['active']=False
+        self.assertTrue(frozen['units'][0]['active'])
+
+    def test_symlink_checkpoint_rejected(self):
+        self.begin()
+        (self.root/'entry.json').rename(self.root/'original.json')
+        (self.root/'entry.json').symlink_to(self.root/'original.json')
+        with self.assertRaises(OSError): self.session.recover(owner='b60-stream-a')
+
+    def test_trial_exception_is_sanitized_and_restored_without_retry(self):
+        self.begin()
+        def explode(state, deadline):
+            raise TimeoutError('private-output-must-not-be-persisted')
+        self.adapter.execute=explode
+        self.assertEqual(self.session.run_trial(owner='b60-stream-a')['outcome'],'failed-restored')
+        self.assertNotIn('private-output',(self.root/'session.json').read_text())
+
+    def test_preflight_overrun_does_not_isolate(self):
+        def arm(state):
+            self.now=2800
+            return True
+        self.adapter.arm_guardian=arm
+        with self.assertRaisesRegex(SessionError,'CONSUMED_TRIAL_WINDOW'): self.begin()
+        self.assertNotIn('isolate',self.adapter.events)
+
+    def test_verification_overrun_never_releases(self):
+        self.begin()
+        def verify(entry):
+            self.now=3700
+            return True
+        self.adapter.verify_entry=verify
+        with self.assertRaisesRegex(SessionError,'RESTORATION_NOT_VERIFIED'):
+            self.session.recover(owner='b60-stream-a')
+        self.assertNotIn('release',self.adapter.events)
+
+    def test_checkpoint_and_state_are_durable_when_guardian_arms(self):
+        def arm(state):
+            self.assertEqual(self.store.read('session.json')['phase'],'checkpointed')
+            self.assertEqual(self.store.read('entry.json'),snapshot())
+            return True
+        self.adapter.arm_guardian=arm
+        self.begin()
+
+
+if __name__=='__main__': unittest.main()
