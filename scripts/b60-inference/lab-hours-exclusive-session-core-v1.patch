+"""Durable exclusive-session core. No host adapter or automatic live entry point.
+
+Adapters must enforce the supplied deadline on every operation. Injected test
+adapters are not proof of live checkpoint, isolation or restoration correctness.
+"""
+from __future__ import annotations
+
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import stat
+import time
+
+IDENTITY = re.compile(r'[a-z0-9][a-z0-9-]{7,63}')
+SHA = re.compile(r'[0-9a-f]{64}')
+
+
+class SessionError(RuntimeError):
+    pass
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':')).encode()
+
+
+def validate_snapshot(value):
+    """Content-free identities only; recovery bytes stay in protected custody."""
+    if not isinstance(value, dict) or set(value) != {
+            'schema', 'model_sha256', 'runtime_sha256', 'configuration_sha256',
+            'checkpoint_sha256', 'units', 'mounts'}:
+        raise SessionError('SNAPSHOT_SCHEMA')
+    if value['schema'] != 'aster-entry-snapshot.v1':
+        raise SessionError('SNAPSHOT_VERSION')
+    for key in ('model_sha256', 'runtime_sha256', 'configuration_sha256', 'checkpoint_sha256'):
+        if not isinstance(value[key], str) or not SHA.fullmatch(value[key]):
+            raise SessionError('SNAPSHOT_IDENTITY')
+    if not isinstance(value['units'], list) or not 1 <= len(value['units']) <= 32:
+        raise SessionError('SNAPSHOT_UNITS')
+    seen = set()
+    for row in value['units']:
+        if not isinstance(row, dict) or set(row) != {'guest', 'unit', 'active', 'enabled', 'runtime_masked'}:
+            raise SessionError('UNIT_SCHEMA')
+        if row['guest'] not in {'104', '110', '114', '115', '116'}:
+            raise SessionError('UNIT_SCOPE')
+        if not isinstance(row['unit'], str) or not re.fullmatch(r'[a-zA-Z0-9_.@-]+\.(service|timer)', row['unit']):
+            raise SessionError('UNIT_IDENTITY')
+        if any(type(row[k]) is not bool for k in ('active', 'enabled', 'runtime_masked')):
+            raise SessionError('UNIT_STATE_UNSUPPORTED')
+        identity = (row['guest'], row['unit'])
+        if identity in seen:
+            raise SessionError('DUPLICATE_UNIT')
+        seen.add(identity)
+    if not isinstance(value['mounts'], list) or len(value['mounts']) > 16:
+        raise SessionError('SNAPSHOT_MOUNTS')
+    for row in value['mounts']:
+        if not isinstance(row, dict) or set(row) != {'identity_sha256', 'present', 'readonly'}:
+            raise SessionError('MOUNT_SCHEMA')
+        if not isinstance(row['identity_sha256'], str) or not SHA.fullmatch(row['identity_sha256']):
+            raise SessionError('MOUNT_IDENTITY')
+        if type(row['present']) is not bool or type(row['readonly']) is not bool:
+            raise SessionError('MOUNT_STATE')
+    return json.loads(canonical(value))
+
+
+class SessionStore:
+    def __init__(self, root, *, expected_uid=None):
+        self.root = Path(root)
+        self.uid = os.geteuid() if expected_uid is None else expected_uid
+
+    def lock(self):
+        self.root.mkdir(mode=0o700, parents=True, exist_ok=True)
+        st = self.root.lstat()
+        if not stat.S_ISDIR(st.st_mode) or st.st_uid != self.uid or st.st_mode & 0o077:
+            raise SessionError('SESSION_DIRECTORY_CUSTODY')
+        fd = os.open(self.root/'session.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
+        st = os.fstat(fd)
+        if not stat.S_ISREG(st.st_mode) or st.st_uid != self.uid or st.st_nlink != 1 or st.st_mode & 0o077:
+            os.close(fd)
+            raise SessionError('SESSION_LOCK_CUSTODY')
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BaseException:
+            os.close(fd)
+            raise
+        return fd
+
+    def read(self, name):
+        fd = os.open(self.root/name, os.O_RDONLY | os.O_NOFOLLOW)
+        try:
+            st = os.fstat(fd)
+            if (not stat.S_ISREG(st.st_mode) or st.st_uid != self.uid
+                    or st.st_nlink != 1 or st.st_mode & 0o777 != 0o600 or st.st_size > 32768):
+                raise SessionError('SESSION_FILE_CUSTODY')
+            data = os.read(fd, 32769)
+            return json.loads(data)
+        finally:
+            os.close(fd)
+
+    def write(self, name, value, *, immutable=False):
+        target = self.root/name
+        if immutable and target.exists():
+            raise SessionError('CHECKPOINT_ALREADY_EXISTS')
+        temporary = self.root/(name+'.next')
+        fd = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
+        try:
+            data = canonical(value)
+            with os.fdopen(fd, 'wb') as handle:
+                handle.write(data)
+                handle.flush()
+                os.fsync(handle.fileno())
+            os.replace(temporary, target)
+            directory = os.open(self.root, os.O_RDONLY)
+            try:
+                os.fsync(directory)
+            finally:
+                os.close(directory)
+        except BaseException:
+            # Retain uncertain partial evidence; never erase it to retry silently.
+            raise
+
+
+class ExclusiveSession:
+    """State machine: checkpoint -> guardian -> isolate -> trial -> restore.
+
+    The adapter owns host exclusion/lease and root checkpoint bytes; this core
+    orders their proofs and retains recovery state on every uncertain result.
+    """
+    def __init__(self, store, adapter, *, clock=time.time):
+        self.store, self.adapter, self.clock = store, adapter, clock
+
+    def _phase(self, state, phase):
+        state['phase'] = phase
+        state['updated_epoch'] = int(self.clock())
+        self.store.write('session.json', state)
+
+    def begin(self, booking, *, owner, trial_seconds=1800):
+        if (booking.get('kind') != 'exclusive-stack' or booking.get('state') != 'reserved'
+                or booking.get('owner') != owner or not IDENTITY.fullmatch(owner)
+                or not IDENTITY.fullmatch(booking.get('booking_id', ''))):
+            raise SessionError('BOOKING_IDENTITY')
+        now = int(self.clock())
+        if (type(trial_seconds) is not int or not 1 <= trial_seconds <= 1800
+                or type(booking.get('start_epoch')) is not int
+                or type(booking.get('end_epoch')) is not int
+                or not booking['start_epoch'] <= now <= booking['start_epoch']+120
+                or now+trial_seconds+900 > booking['end_epoch']):
+            raise SessionError('INSUFFICIENT_WINDOW')
+        fd = self.store.lock()
+        try:
+            if (self.store.root/'session.json').exists():
+                raise SessionError('SESSION_ALREADY_EXISTS')
+            if self.adapter.admit(booking) is not True:
+                raise SessionError('FRESH_ADMISSION_FAILED')
+            snapshot = validate_snapshot(self.adapter.capture())
+            if self.adapter.verify_checkpoint(snapshot) is not True:
+                raise SessionError('CHECKPOINT_NOT_RECOVERABLE')
+            self.store.write('entry.json', snapshot, immutable=True)
+            state = {'schema':'aster-exclusive-session.v1', 'booking_id':booking['booking_id'],
+                'owner':owner, 'entry_sha256':hashlib.sha256(canonical(snapshot)).hexdigest(),
+                'trial_deadline':now+trial_seconds, 'restore_deadline':booking['end_epoch'],
+                'phase':'checkpointed', 'production_restored':False}
+            self._phase(state, 'checkpointed')
+            if self.adapter.arm_guardian(state) is not True:
+                raise SessionError('GUARDIAN_NOT_ARMED')
+            self._phase(state, 'guardian-armed')
+            if int(self.clock()) >= state['trial_deadline']:
+                raise SessionError('PREFLIGHT_CONSUMED_TRIAL_WINDOW')
+            # An isolate failure can be partial: durable state already exists.
+            if self.adapter.isolate(state) is not True:
+                raise SessionError('ISOLATION_UNCERTAIN')
+            self._phase(state, 'isolated')
+            return state
+        finally:
+            os.close(fd)
+
+    def run_trial(self, *, owner):
+        """Run once; any failed/uncertain attempt goes to recovery, not retry."""
+        fd = self.store.lock()
+        failure = False
+        try:
+            state = self.store.read('session.json')
+            if state.get('owner') != owner or state.get('phase') != 'isolated':
+                raise SessionError('TRIAL_OWNER_OR_PHASE')
+            if int(self.clock()) >= state['trial_deadline']:
+                failure = True
+                self._phase(state, 'trial-expired')
+            else:
+                self._phase(state, 'trial-started')
+                try:
+                    failure = self.adapter.execute(state, state['trial_deadline']) is not True
+                except Exception:
+                    # Do not persist raw exceptions, which could contain secrets.
+                    failure = True
+                self._phase(state, 'trial-failed' if failure else 'trial-complete')
+        finally:
+            os.close(fd)
+        result = self.recover(owner=owner)
+        return {'outcome':'failed-restored' if failure else 'complete-restored',
+                'session':result}
+
+    def recover(self, *, owner):
+        fd = self.store.lock()
+        try:
+            state = self.store.read('session.json')
+            if state.get('schema') != 'aster-exclusive-session.v1' or state.get('owner') != owner:
+                raise SessionError('RECOVERY_OWNER_MISMATCH')
+            if state.get('phase') not in {'checkpointed', 'guardian-armed', 'isolated',
+                    'trial-expired', 'trial-started', 'trial-failed', 'trial-complete',
+                    'restoring', 'restored', 'released'}:
+                raise SessionError('RECOVERY_PHASE_INVALID')
+            entry = validate_snapshot(self.store.read('entry.json'))
+            if hashlib.sha256(canonical(entry)).hexdigest() != state.get('entry_sha256'):
+                raise SessionError('CHECKPOINT_IDENTITY_CHANGED')
+            if state.get('phase') == 'released':
+                return state
+            if int(self.clock()) >= state['restore_deadline']:
+                raise SessionError('RECOVERY_DEADLINE_EXCEEDED')
+            # Never restart production while an experiment process might survive.
+            if self.adapter.fence_experiments(state) is not True:
+                raise SessionError('EXPERIMENT_FENCE_UNCERTAIN')
+            self._phase(state, 'restoring')
+            if self.adapter.restore(entry, state['restore_deadline']) is not True:
+                raise SessionError('RESTORATION_INCOMPLETE')
+            if (self.adapter.verify_entry(entry) is not True
+                    or int(self.clock()) >= state['restore_deadline']):
+                raise SessionError('RESTORATION_NOT_VERIFIED')
+            state['production_restored'] = True
+            self._phase(state, 'restored')
+            if self.adapter.release(state) is not True:
+                raise SessionError('RELEASE_UNCERTAIN')
+            self._phase(state, 'released')
+            return state
+        finally:
+            os.close(fd)
diff --git a/scripts/local-ai/test_lab_hours_exclusive_session.py b/scripts/local-ai/test_lab_hours_exclusive_session.py
