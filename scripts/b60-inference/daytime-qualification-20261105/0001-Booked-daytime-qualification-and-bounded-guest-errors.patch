+"""Root-private disposable target tests; no production target path is used."""
+import os
+from pathlib import Path
+import shutil
+import tempfile
+import unittest
+from lab_hours_daytime_plan_helper_update import update,OLD,NEW,NAME,digest
+from lab_hours_file_checkpoint import CheckpointError
+
+
+class GuestHelperTargetTests(unittest.TestCase):
+    def setUp(self):
+        root=Path(os.environ['B60_TARGET_FIXTURE_ROOT'])
+        self.tmp=tempfile.TemporaryDirectory(dir=root);self.addCleanup(self.tmp.cleanup)
+        self.root=Path(self.tmp.name);self.target=self.root/NAME
+        self.candidate=self.root/'new.py';self.checkpoint=self.root/'checkpoint'
+        shutil.copyfile(Path(os.environ['B60_DAYTIME_OLD_SOURCE_BUNDLE'])/'exclusive-session'/NAME,self.target)
+        shutil.copyfile(Path(os.environ['B60_DAYTIME_NEW_SOURCE_BUNDLE'])/'exclusive-session'/NAME,self.candidate)
+        self.target.chmod(0o600);self.candidate.chmod(0o600)
+
+    def apply(self,validate=lambda p:True):
+        return update(self.target,self.candidate,self.checkpoint,uid=os.getuid(),validate=validate)
+
+    def test_exact_replacement_retains_source_checkpoint(self):
+        result=self.apply();self.assertEqual(result['state'],'helper-installed')
+        self.assertEqual(digest(self.target),NEW);self.assertTrue((self.checkpoint/'files/manifest.json').exists())
+
+    def test_failed_import_restores_original_source(self):
+        with self.assertRaisesRegex(CheckpointError,'IMPORT'):self.apply(lambda p:False)
+        self.assertEqual(digest(self.target),OLD)
+
+    def test_drift_cannot_be_overwritten(self):
+        self.target.write_bytes(b'foreign')
+        with self.assertRaisesRegex(CheckpointError,'DRIFT'):self.apply()
+        self.assertEqual(self.target.read_bytes(),b'foreign');self.assertFalse(self.checkpoint.exists())
+
+    def test_bad_candidate_cannot_create_checkpoint(self):
+        self.candidate.write_bytes(b'corrupt')
+        with self.assertRaisesRegex(CheckpointError,'DRIFT'):self.apply()
+        self.assertEqual(digest(self.target),OLD);self.assertFalse(self.checkpoint.exists())
+
+
+if __name__=='__main__':unittest.main()
