+
+def digest(path):
+    info=path.lstat()
+    if path.is_symlink() or not path.is_file() or info.st_nlink!=1:
+        raise CheckpointError('HELPER_CUSTODY')
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def update(target, candidate, checkpoint, *, uid, validate):
+    target,candidate,checkpoint=map(Path,(target,candidate,checkpoint))
+    for p in (target,candidate):
+        for parent in (p.parent,*p.parents[1:]):
+            if parent.is_symlink() or not parent.is_dir() or parent.stat().st_uid!=uid or parent.stat().st_mode&0o022:
+                raise CheckpointError('HELPER_PARENT_CUSTODY')
+        if p.stat().st_uid!=uid or p.stat().st_mode&0o777!=0o600:
+            raise CheckpointError('HELPER_CUSTODY')
+    if digest(target)!=OLD or digest(candidate)!=NEW or checkpoint.exists():
+        raise CheckpointError('HELPER_SOURCE_OR_ATTEMPT_DRIFT')
+    checkpoint.mkdir(mode=0o700,parents=True)
+    files=FileCheckpoint(checkpoint/'files',allowed_roots=(),allowed_files=(target,),expected_uid=uid)
+    receipt=files.capture([str(target)])
+    if not files.verify(receipt):raise CheckpointError('HELPER_CHECKPOINT_UNVERIFIED')
+    temp=checkpoint/'candidate.py'
+    fd=os.open(temp,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o600)
+    with os.fdopen(fd,'wb') as stream:
+        stream.write(candidate.read_bytes());stream.flush();os.fsync(stream.fileno())
+    if digest(temp)!=NEW or digest(target)!=OLD or temp.stat().st_dev!=target.stat().st_dev:
+        raise CheckpointError('HELPER_COMPARE_FAILED')
+    os.replace(temp,target)
+    try:
+        if digest(target)!=NEW or validate(target.parent) is not True:
+            raise CheckpointError('HELPER_IMPORT_FAILED')
+    except BaseException:
+        if digest(target)!=NEW:raise CheckpointError('HELPER_UNKNOWN_DRIFT_RETAINED')
+        files.restore(receipt)
+        if digest(target)!=OLD:raise CheckpointError('HELPER_ROLLBACK_FAILED')
+        raise
+    fd=os.open(target.parent,os.O_RDONLY)
+    try:os.fsync(fd)
+    finally:os.close(fd)
+    return {'state':'helper-installed','checkpoint_sha256':receipt,'sha256':NEW}
+
+
+def main():
+    import json
+    target=Path('/usr/local/libexec/local-ai-lease/entry-checkpoint')/NAME
+    stage=Path('/root/b60-daytime-plan-helper-20261105-v1')
