diff --git a/scripts/local-ai/b60_daytime_integrity_prepare.py b/scripts/local-ai/b60_daytime_integrity_prepare.py
new file mode 100644
index 0000000..54c51d4
--- /dev/null
+++ b/scripts/local-ai/b60_daytime_integrity_prepare.py
@@ -0,0 +1,161 @@
+"""One booked-night low-priority archive-integrity preparation, not a lease.
+
+This does not call a model, stop AI units, mount anything, or change backups.
+It verifies existing same-night archives and publishes the platform's standard
+root-local integrity receipt. The later owner independently rebinds all sources.
+"""
+from __future__ import annotations
+import argparse
+from datetime import datetime
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+from zoneinfo import ZoneInfo
+
+PACKAGE=Path('/usr/local/libexec/local-ai-lease/exclusive-session')
+ROOT=Path('/var/lib/local-ai-lab')
+ZONE=ZoneInfo('America/Vancouver')
+
+
+def validate_window(booking,now):
+    local=datetime.fromtimestamp(now,ZONE)
+    day=datetime.fromtimestamp(booking['start_epoch'],ZONE)
+    begin=booking['start_epoch']-3300
+    deadline=booking['start_epoch']-900
+    if (booking.get('owner')!='b60-stream-a' or booking.get('kind')!='exclusive-stack'
+            or booking.get('state')!='reserved' or local.date()!=day.date()
+            or day.strftime('%H:%M:%S')<'07:30:00'
+            or datetime.fromtimestamp(booking['end_epoch']+900,ZONE).strftime('%H:%M:%S')>'22:00:00'
+            or not begin<=now<=begin+120 or deadline-now<1140):
+        raise ValueError('INTEGRITY_PREPARATION_WINDOW')
+    return day.strftime('%Y_%m_%d'),deadline
+
+
+def validate_first_pull(rows,cycle,now,latest_archive):
+    matches=[row for row in rows if row.get('id')==1]
+    if len(matches)!=1: return False
+    row=matches[0]; schedule=row.get('schedule',{}); job=row.get('job',{})
+    started=job.get('time_started',{}).get('$date')
+    finished=job.get('time_finished',{}).get('$date')
+    hour,minute=str(schedule.get('hour','')),str(schedule.get('minute',''))
+    return (row.get('enabled') is True and hour.isdigit() and int(hour)==1
+        and minute.isdigit() and int(minute)==0 and job.get('state')=='SUCCESS'
+        and job.get('arguments')==[1] and type(started) is int and type(finished) is int
+        and latest_archive<=started/1000<=finished/1000<=now
+        and datetime.fromtimestamp(started/1000,ZONE).strftime('%Y_%m_%d')==cycle
+        and datetime.fromtimestamp(finished/1000,ZONE).strftime('%Y_%m_%d')==cycle
+        and datetime.fromtimestamp(started/1000,ZONE).hour>=1)
+
+
+def runner(command,timeout):
+    result=subprocess.run(command,capture_output=True,text=True,timeout=timeout,check=False)
+    return result.returncode,result.stdout
+
+
+def prepare(booking_id):
+    sys.path.insert(0,str(PACKAGE))
+    from lab_hours_exclusive_profile import load_profile
+    from lab_hours_reservations import ReservationStore
+    from lab_hours_exclusive_session import SessionStore,SessionError,IDENTITY
+    from host_exclusion import host_exclusion
+    from full_inference_lab_sources import (AcceptedBaseline,TrustedOwnerAttestation,
+        LocalProxmoxFullDrainSourceProducer,FIXED)
+    from retained_archive_integrity import (fixed_proxmox_inventory,fixed_resolve,
+        fixed_probe,capture,verify,save_root_owned,load_root_owned,SCHEMA,FIELDS)
+    from backup_receipt_adapter import verify_proxmox_artifacts
+    if os.geteuid()!=0 or os.uname().nodename!='proxmox': raise ValueError('PROXMOX_ROOT_REQUIRED')
+    if not IDENTITY.fullmatch(booking_id): raise ValueError('PREPARATION_BOOKING_IDENTITY')
+    load_profile(ROOT/'exclusive-activations'/(booking_id+'.json'),PACKAGE)
+    bookings=ReservationStore(ROOT/'reservations',expected_uid=0)
+    cycle,deadline=validate_window(bookings.get(booking_id),int(time.time()))
+    with host_exclusion(ROOT):
+        if any(p.exists() for p in (ROOT/'lease.json',ROOT/'lease.lock',
+                ROOT/'full-inference-drain.json',ROOT/'full-inference-drain.lock',
+                Path('/run/local-ai-lab-operation.lock'))):
+            raise ValueError('KNOWN_MAINTENANCE_OR_LAB_ACTIVE')
+        code,raw=runner(('/usr/local/sbin/local-ai-lease','status'),10)
+        if code or json.loads(raw) not in ('ready',{'state':'ready'}):
+            raise ValueError('SHARED_HOST_NOT_READY')
+        # Process comm only, never raw command lines that might contain keys.
+        for proc in Path('/proc').glob('[0-9]*'):
+            try: name=(proc/'comm').read_text().strip()
+            except FileNotFoundError: continue
+            if name in {'vzdump','zstd','rsync','pbs-client','proxmox-backup'}:
+                raise ValueError('COMPETING_BACKUP_IO')
+        state=SessionStore(ROOT/'exclusive-integrity'/booking_id,expected_uid=0)
+        fd=state.lock()
+        phase='attempt'
+        try:
+            state.write('attempt.json',{'schema':'aster-exclusive-integrity-attempt.v1',
+                'booking_id':booking_id,'started_epoch':int(time.time()),
+                'deadline_epoch':deadline},immutable=True)
+            phase='whole-backup-job'
+            producer=LocalProxmoxFullDrainSourceProducer(runner,AcceptedBaseline('','',''),
+                TrustedOwnerAttestation('b60-stream-a','booked-night-integrity'))
+            if producer._backup_current(cycle) is not True:
+                raise ValueError('WHOLE_BACKUP_JOB_UNPROVEN')
+            phase='current-archive-inventory'
+            inventory=fixed_proxmox_inventory()
+            artifacts=verify_proxmox_artifacts(inventory,date_prefix=cycle)
+            phase='first-truenas-pull'
+            code,raw=runner(FIXED['truenas'],10)
+            if code or not validate_first_pull(json.loads(raw),cycle,int(time.time()),
+                                               max(row.ctime for row in artifacts)):
+                raise ValueError('FIRST_TRUENAS_PULL_UNPROVEN')
+            phase='existing-integrity-receipt'
+            previous=load_root_owned() if (ROOT/'archive-integrity.json').exists() else None
+            if previous is not None and (set(previous)!=FIELDS or previous.get('schema')!=SCHEMA):
+                raise ValueError('EXISTING_INTEGRITY_RECEIPT_UNEXPECTED')
+            before=hashlib.sha256(json.dumps(previous,sort_keys=True).encode()).hexdigest()
+            if previous is not None: state.write('previous-receipt.json',previous,immutable=True)
+            # Preserve a peer producer's valid same-cycle receipt; do not scan
+            # or replace it merely to claim this preparation produced it.
+            reused=False
+            if (previous is not None and previous.get('date')==cycle
+                    and type(previous.get('finished_epoch')) is int
+                    and 0<=int(time.time())-previous['finished_epoch']<=10800):
+                proof=verify(previous,inventory,date=cycle,now_epoch=int(time.time()),
+                             resolve=fixed_resolve,lstat=os.lstat)
+                receipt=previous; reused=True
+            else:
+                phase='archive-integrity-scan'
+                receipt=capture(inventory,date=cycle,resolve=fixed_resolve,lstat=os.lstat,
+                                probe=fixed_probe,deadline_epoch=deadline)
+                proof=verify(receipt,fixed_proxmox_inventory(),date=cycle,now_epoch=int(time.time()),
+                             resolve=fixed_resolve,lstat=os.lstat)
+            phase='receipt-publication'
+            state.write('receipt.json',receipt,immutable=True)
+            current=load_root_owned() if (ROOT/'archive-integrity.json').exists() else None
+            if hashlib.sha256(json.dumps(current,sort_keys=True).encode()).hexdigest()!=before:
+                raise ValueError('PEER_INTEGRITY_RECEIPT_CHANGED')
+            if not reused: save_root_owned(receipt)
+            state.write('terminal.json',{'schema':'aster-exclusive-integrity-result.v1',
+                'state':'complete','booking_id':booking_id,'archive_receipt':proof,
+                'finished_epoch':int(time.time()),'peer_receipt_reused':reused,
+                'ai_stack_effects':False},immutable=True)
+            return {'state':'complete','booking_id':booking_id,'ai_stack_effects':False}
+        except Exception:
+            if not (state.root/'terminal.json').exists():
+                state.write('terminal.json',{'schema':'aster-exclusive-integrity-result.v1',
+                    'state':'no_go','booking_id':booking_id,'first_failure_phase':phase,
+                    'ai_stack_effects':False},immutable=True)
+            raise
+        finally: os.close(fd)
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--booking-id',required=True); parser.add_argument('--self-sha256',required=True)
+    args=parser.parse_args()
+    try:
+        if hashlib.sha256(Path(__file__).read_bytes()).hexdigest()!=args.self_sha256:
+            raise ValueError('PREPARATION_SOURCE_DRIFT')
+        print(json.dumps(prepare(args.booking_id),sort_keys=True))
+    except Exception as error:
+        # Fixed types only: no source-local command output or private paths.
+        print(json.dumps({'state':'no_go','failure_type':type(error).__name__,
+                          'ai_stack_effects':False})); raise SystemExit(1)
diff --git a/scripts/local-ai/install_b60_daytime_qualification.py b/scripts/local-ai/install_b60_daytime_qualification.py
new file mode 100644
index 0000000..fb75864
--- /dev/null
+++ b/scripts/local-ai/install_b60_daytime_qualification.py
@@ -0,0 +1,121 @@
+"""Install exactly one future restore-only qualification and its integrity prep.
+
+No model experiment is scheduled. Never edits an existing platform unit. Only
+the two new future one-shot timers are started; no existing service is stopped.
+"""
+from __future__ import annotations
+import argparse
+from datetime import datetime
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import time
+from zoneinfo import ZoneInfo
+
+from host_exclusion import host_exclusion
+from lab_hours_exclusive_profile import load_profile,protected_bytes
+from lab_hours_exclusive_session import IDENTITY,SessionError
+from lab_hours_reservations import ReservationStore
+
+ROOT=Path('/var/lib/local-ai-lab')
+PACKAGE=Path('/usr/local/libexec/local-ai-lease/exclusive-session')
+PREP=Path('/usr/local/libexec/local-ai-lease/b60-exclusive-integrity')
+UNITS=Path('/etc/systemd/system')
+
+
+def unit_files(booking,preparation_sha):
+    day=datetime.fromtimestamp(booking['start_epoch'],ZoneInfo('America/Vancouver'))
+    date=day.strftime('%Y%m%d'); calendar=day.strftime('%Y-%m-%d')
+    preparation='b60-exclusive-integrity-'+booking['booking_id']
+    qualification='b60-exclusive-qualification-'+booking['booking_id']
+    preparation_package=PREP.parent/(PREP.name+'-'+booking['booking_id'])
+    service_prefix='[Unit]\nDescription=B60 booked entry-restore qualification\n\n[Service]\nType=oneshot\nUser=root\nRestart=no\nKillMode=control-group\n'
+    prep_service=(service_prefix+'Nice=19\nIOSchedulingClass=idle\nTimeoutStartSec=1500\n'
+        +'ExecStart=/usr/bin/python3 -B '+str(preparation_package/'lab_hours_exclusive_integrity_prepare.py')
+        +' --booking-id '+booking['booking_id']+' --self-sha256 '+preparation_sha+'\n')
+    owner_service=(service_prefix+'TimeoutStartSec=30\nExecStart=/usr/bin/python3 -B '
+        +str(PACKAGE/'lab_hours_exclusive_cli.py')+' launch --booking-id '+booking['booking_id']+'\n')
+    def timer(name,clock):
+        return ('[Unit]\nDescription=B60 single booked qualification clock\n\n[Timer]\n'
+            +'OnCalendar='+calendar+' '+clock+' America/Vancouver\n'
+            +'Persistent=false\nAccuracySec=1s\nRandomizedDelaySec=0\nUnit='+name+'.service\n'
+            +'\n[Install]\nWantedBy=timers.target\n')
+    return {preparation+'.service':prep_service,preparation+'.timer':timer(preparation,datetime.fromtimestamp(booking['start_epoch']-3300,ZoneInfo('America/Vancouver')).strftime('%H:%M:%S')),
+            qualification+'.service':owner_service,
+            qualification+'.timer':timer(qualification,day.strftime('%H:%M:%S'))}
+
+
+def call(command):
+    result=subprocess.run(command,capture_output=True,text=True,timeout=30,check=False)
+    if result.returncode: raise SessionError('QUALIFICATION_SCHEDULE_COMMAND_FAILED')
+    return result.stdout
+
+
+def day_window_invalid(booking):
+    zone=ZoneInfo('America/Vancouver')
+    start=datetime.fromtimestamp(booking['start_epoch'],zone)
+    finish=datetime.fromtimestamp(booking['end_epoch']+900,zone)
+    return (start.date()!=finish.date() or start.strftime('%H:%M:%S')<'07:30:00'
+            or finish.strftime('%H:%M:%S')>'22:00:00'
+            or not 1200<=booking['end_epoch']-booking['start_epoch']<=5400)
+
+
+def install(booking_id,source,source_sha):
+    if os.geteuid()!=0 or os.uname().nodename!='proxmox' or not IDENTITY.fullmatch(booking_id):
+        raise SessionError('QUALIFICATION_SCHEDULE_IDENTITY')
+    raw=protected_bytes(source,executable=True,maximum=262144)
+    if hashlib.sha256(raw).hexdigest()!=source_sha: raise SessionError('INTEGRITY_SOURCE_DRIFT')
+    with host_exclusion(ROOT):
+        if any(p.exists() for p in (ROOT/'lease.json',ROOT/'lease.lock',
+                ROOT/'full-inference-drain.json',ROOT/'full-inference-drain.lock',
+                Path('/run/local-ai-lab-operation.lock'))):
+            raise SessionError('SHARED_HOST_NOT_READY')
+        status=json.loads(call(('/usr/local/sbin/local-ai-lease','status')))
+        if status not in ('ready',{'state':'ready'}): raise SessionError('SHARED_HOST_NOT_READY')
+        profile=load_profile(ROOT/'exclusive-activations'/(booking_id+'.json'),PACKAGE)
+        booking=ReservationStore(ROOT/'reservations',expected_uid=0).get(booking_id)
+        if (profile['qualification_only'] is not True or profile['experiment'] is not None
+                or profile['booking_id']!=booking_id or booking.get('booking_id')!=booking_id
+                or booking.get('owner')!=profile['owner'] or booking.get('kind')!='exclusive-stack'
+                or booking.get('state')!='reserved' or booking['start_epoch']-3300<time.time()+120
+                or day_window_invalid(booking)):
+            raise SessionError('FUTURE_RESTORE_ONLY_BOOKING_REQUIRED')
+        files=unit_files(booking,source_sha)
+        day=datetime.fromtimestamp(booking['start_epoch'],ZoneInfo('America/Vancouver'))
+        preparation_package=PREP.parent/(PREP.name+'-'+booking_id)
+        # Never replace existing units or code, even after a partial install.
+        if any((UNITS/name).exists() or (UNITS/name).is_symlink() for name in files):
+            raise SessionError('QUALIFICATION_UNIT_ALREADY_EXISTS')
+        if preparation_package.exists(): raise SessionError('INTEGRITY_PACKAGE_ALREADY_EXISTS')
+        preparation_package.mkdir(mode=0o700)
+        target=preparation_package/'lab_hours_exclusive_integrity_prepare.py'
+        fd=os.open(target,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o600)
+        with os.fdopen(fd,'wb') as stream:
+            stream.write(raw); stream.flush(); os.fsync(stream.fileno())
+        for name,body in files.items():
+            fd=os.open(UNITS/name,os.O_CREAT|os.O_EXCL|os.O_WRONLY|os.O_NOFOLLOW,0o644)
+            with os.fdopen(fd,'w') as stream:
+                stream.write(body); stream.flush(); os.fsync(stream.fileno())
+        call(('systemd-analyze','verify',*(str(UNITS/name) for name in files)))
+        call(('systemctl','daemon-reload'))
+        timers=sorted(name for name in files if name.endswith('.timer'))
+        call(('systemctl','enable','--now',*timers))
+        return {'state':'qualification-scheduled','booking_id':booking_id,
+                'timers':timers,'model_experiment_scheduled':False,
+                'expected_stack_effects_only_during_booking':True}
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--booking-id',required=True)
+    parser.add_argument('--preparation-source',type=Path,required=True)
+    parser.add_argument('--preparation-sha256',required=True)
+    parser.add_argument('--schedule-qualification',action='store_true',required=True)
+    args=parser.parse_args()
+    try:
+        print(json.dumps(install(args.booking_id,args.preparation_source,args.preparation_sha256),sort_keys=True))
+    except Exception as error:
+        code=str(error) if isinstance(error,SessionError) else type(error).__name__
+        print(json.dumps({'state':'no_go','failure_code':code})); raise SystemExit(1)
