diff --git a/scripts/local-ai/test_b60_daytime_qualification.py b/scripts/local-ai/test_b60_daytime_qualification.py
new file mode 100644
index 0000000..eb781f6
--- /dev/null
+++ b/scripts/local-ai/test_b60_daytime_qualification.py
@@ -0,0 +1,44 @@
+from datetime import datetime
+from zoneinfo import ZoneInfo
+import unittest
+from b60_daytime_integrity_prepare import validate_window
+from install_b60_daytime_qualification import unit_files,day_window_invalid
+
+class DaytimeQualificationTests(unittest.TestCase):
+    def setUp(self):
+        self.start=int(datetime(2026,11,5,12,30,tzinfo=ZoneInfo('America/Vancouver')).timestamp())
+        self.booking={'booking_id':'b60-exclusive-20261105-day-r1','owner':'b60-stream-a',
+                      'kind':'exclusive-stack','state':'reserved','start_epoch':self.start,
+                      'end_epoch':self.start+2700}
+
