From 546d85b2ce18ead0eab42011e5c2d726be48c20a Mon Sep 17 00:00:00 2001
From: elliottrook <jason@yampy.ca>
Date: Sat, 31 Oct 2026 11:54:10 -0700
Subject: [PATCH] Characterize November cross-host backup clock mismatch
 without relaxing admission

---
 .../test_lab_hours_mirror_schedule_drift.py   | 30 +++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/scripts/local-ai/test_lab_hours_mirror_schedule_drift.py b/scripts/local-ai/test_lab_hours_mirror_schedule_drift.py
index 25f0eb176..25a7cdaa5 100644
--- a/scripts/local-ai/test_lab_hours_mirror_schedule_drift.py
+++ b/scripts/local-ai/test_lab_hours_mirror_schedule_drift.py
@@ -8,6 +8,7 @@ import unittest
 from zoneinfo import ZoneInfo
 
 from fixed_source_adapters import _schedule_ok
+from full_inference_lab_sources import validate_backup_sources
 
 
 class MirrorScheduleDriftTests(unittest.TestCase):
@@ -52,6 +53,35 @@ class MirrorScheduleDriftTests(unittest.TestCase):
         self.rows[1]['job']['time_finished']['$date'] = self.epoch(4, 26)
         self.assertFalse(self.check(6, 30))
 
+    def november_rows(self):
+        # Sanitized observed schedule labels, synthetic future completions.
+        # Proxmox/Mac timezone databases keep Vancouver at -07; TrueNAS
+        # currently schedules in Los Angeles, which changes to -08.
+        zone = ZoneInfo('America/Los_Angeles')
+        rows = []
+        for identity, hour in ((1, 1), (3, 2), (2, 3)):
+            started = int(datetime(2026,11,1,hour,0,tzinfo=zone,fold=0).timestamp()*1000)
+            rows.append(dict(id=identity,enabled=True,
+                schedule=dict(hour=str(hour),minute='0'),job=dict(
+                    state='SUCCESS',arguments=[identity],
+                    time_started={'$date':started},time_finished={'$date':started+60000})))
+        return rows
+
+    def test_november1_mac_pull_is_after_reserved_0310_not_admission(self):
+        now = int(datetime(2026,11,1,3,10,tzinfo=self.zone).timestamp())
+        archive = int(datetime(2026,11,1,0,50,tzinfo=self.zone).timestamp())
+        rows = self.november_rows()
+        self.assertGreater(rows[-1]['job']['time_started']['$date']/1000, now)
+        self.assertFalse(_schedule_ok(rows,date_prefix='2026_11_01',
+                                     artifact_ctimes=(archive,),lease_issued_epoch=now))
+
+    def test_full_source_gate_also_rejects_future_success_at_0310(self):
+        now = int(datetime(2026,11,1,3,10,tzinfo=self.zone).timestamp())
+        archive = int(datetime(2026,11,1,0,50,tzinfo=self.zone).timestamp())
+        artifacts = [dict(vmid=guest,ctime=archive,size=1) for guest in (104,110,116)]
+        self.assertFalse(validate_backup_sources(artifacts,self.november_rows(),
+                                                 cycle='2026-11-01',now_epoch=now))
+
 
 if __name__ == '__main__':
     unittest.main()
-- 
