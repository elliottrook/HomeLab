 class FakeSource:
@@ -61,6 +61,17 @@ class SourceUpdateTests(unittest.TestCase):
         with self.assertRaisesRegex(SessionError, 'NOT_REVIEWED'):
             transition(self.old, changed)
 
+    def test_claim_migration_is_exact_and_cannot_skip_its_installed_baseline(self):
+        path=Path(os.environ.get('B60_CLAIM_SOURCE_BUNDLE',
+            '/private/tmp/b60-claim-candidate-20261102-v1'))/'source-manifest.json'
+        claim=json.loads(path.read_bytes())['pins']
+        scope,identity=transition_identity(self.new,claim)
+        self.assertEqual(scope,('lab_hours_exclusive_boundary.py',
+                               'lab_hours_proxmox_adapter.py','lab_hours_reservations.py'))
+        self.assertEqual(identity,'claim-window-20261102-v1')
+        with self.assertRaisesRegex(SessionError,'NOT_REVIEWED'):transition(self.old,claim)
+        with self.assertRaisesRegex(SessionError,'NOT_REVIEWED'):transition(claim,self.new)
+
     def test_apply_then_explicit_rollback_preserves_exact_dependency_maps(self):
         self.assertEqual(self.update.apply()['state'], 'installed-not-activated')
         self.assertEqual(self.adapter.pins, self.new)
