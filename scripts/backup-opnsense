#!/bin/bash

set -euo pipefail

BACKUP_DIR="$HOME/lab/private-backups/opnsense"
TIMESTAMP="$(date +%Y-%m-%d_%H-%M-%S)"
BACKUP_FILE="$BACKUP_DIR/opnsense-config-$TIMESTAMP.xml"

mkdir -p "$BACKUP_DIR"
chmod 700 "$HOME/lab/private-backups"
chmod 700 "$BACKUP_DIR"

echo "Backing up OPNsense configuration..."

scp opnsense:/conf/config.xml "$BACKUP_FILE"

chmod 600 "$BACKUP_FILE"
shasum -a 256 "$BACKUP_FILE" > "$BACKUP_FILE.sha256"

echo "Backup created:"
echo "$BACKUP_FILE"
