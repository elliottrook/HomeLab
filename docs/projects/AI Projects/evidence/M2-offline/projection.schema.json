{
  "$defs": {
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "effects": {
          "const": "none",
          "default": "none",
          "title": "Effects",
          "type": "string"
        },
        "implementation": {
          "enum": [
            "get_current_time",
            "get_ha_report",
            "get_forgejo_report",
            "get_netbox_report"
          ],
          "title": "Implementation",
          "type": "string"
        },
        "input_schema": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Input Schema",
          "type": "string"
        },
        "locality": {
          "const": "fixture-only",
          "default": "fixture-only",
          "title": "Locality",
          "type": "string"
        },
        "output_schema": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Output Schema",
          "type": "string"
        },
        "owner": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Owner",
          "type": "string"
        },
        "permission_ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Permission Ref",
          "type": "string"
        },
        "schema_version": {
          "const": "capability.v1",
          "default": "capability.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "implementation",
        "owner",
        "permission_ref",
        "input_schema",
        "output_schema"
      ],
      "title": "Capability",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority": {
      "const": "not-granted",
      "default": "not-granted",
      "title": "Authority",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "expires_at": {
      "minimum": 1,
      "title": "Expires At",
      "type": "integer"
    },
    "policy_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Policy Digest",
      "type": "string"
    },
    "principal_ref": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
      "title": "Principal Ref",
      "type": "string"
    },
    "registry_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Registry Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "projection.v1",
      "default": "projection.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "principal_ref",
    "policy_digest",
    "registry_digest",
    "expires_at",
    "capabilities"
  ],
  "title": "Projection",
  "type": "object"
}
