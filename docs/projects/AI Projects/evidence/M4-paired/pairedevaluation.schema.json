{
  "$defs": {
    "Pair": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Case Id",
          "type": "string"
        },
        "repetition": {
          "maximum": 99,
          "minimum": 0,
          "title": "Repetition",
          "type": "integer"
        },
        "baseline_outcome": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Baseline Outcome",
          "type": "string"
        },
        "candidate_outcome": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Candidate Outcome",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "repetition",
        "baseline_outcome",
        "candidate_outcome"
      ],
      "title": "Pair",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "paired-evaluation.v1",
      "default": "paired-evaluation.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "experiment_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
      "title": "Experiment Id",
      "type": "string"
    },
    "plan_event_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Plan Event Digest",
      "type": "string"
    },
    "pairs": {
      "items": {
        "$ref": "#/$defs/Pair"
      },
      "maxItems": 4000,
      "minItems": 1,
      "title": "Pairs",
      "type": "array"
    },
    "family_count": {
      "minimum": 1,
      "title": "Family Count",
      "type": "integer"
    },
    "passed_families": {
      "minimum": 0,
      "title": "Passed Families",
      "type": "integer"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "quality": {
      "const": "not-evaluated",
      "default": "not-evaluated",
      "title": "Quality",
      "type": "string"
    },
    "promotion_authority": {
      "const": "none",
      "default": "none",
      "title": "Promotion Authority",
      "type": "string"
    }
  },
  "required": [
    "experiment_id",
    "plan_event_digest",
    "pairs",
    "family_count",
    "passed_families",
    "verdict"
  ],
  "title": "PairedEvaluation",
  "type": "object"
}
