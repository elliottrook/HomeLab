#cloud-config
package_update: false
package_upgrade: false
ssh_pwauth: false
disable_root: true
users:
  - name: aster-s0
    system: true
    lock_passwd: true
    no_create_home: true
    shell: /usr/sbin/nologin
write_files:
  - path: /usr/local/lib/aster-s0/routing_smoke.py
    owner: root:root
    permissions: '0444'
    encoding: b64
    content: 
  - path: /usr/local/lib/aster-s0/s0_descriptive.py
    owner: root:root
    permissions: '0444'
    encoding: b64
    content: 
  - path: /usr/local/lib/aster-s0/s0_vm_corpus_worker.py
    owner: root:root
    permissions: '0444'
    encoding: b64
    content: 
  - path: /usr/local/lib/aster-s0/validate_label_batch.py
    owner: root:root
    permissions: '0444'
    encoding: b64
    content: 
  - path: /usr/local/lib/aster-s0/corpus_entry.py
    owner: root:root
    permissions: '0444'
    encoding: b64
    content: 
  - path: /usr/local/lib/aster-s0/payload-manifest.json
    owner: root:root
    permissions: '0444'
    encoding: b64
    content: 
  - path: /etc/systemd/system/aster-s0-corpus.service
    owner: root:root
    permissions: '0444'
    encoding: b64
    content: 
  - path: /usr/local/share/aster-s0/corpus/batch-1/acceptance.json
    owner: root:root
    permissions: '0444'
    encoding: b64
    content: 
  - path: /usr/local/share/aster-s0/corpus/batch-1/effort.json
    owner: root:root
    permissions: '0444'
    encoding: b64
    content: 
  - path: /usr/local/share/aster-s0/corpus/batch-1/reviewed-proposal.json
    owner: root:root
    permissions: '0444'
    encoding: b64
    content: 
  - path: /usr/local/share/aster-s0/corpus/batch-2/acceptance.json
    owner: root:root
    permissions: '0444'
    encoding: b64
    content: 
  - path: /usr/local/share/aster-s0/corpus/batch-2/effort.json
    owner: root:root
    permissions: '0444'
    encoding: b64
    content: 
  - path: /usr/local/share/aster-s0/corpus/batch-2/reviewed-proposal.json
    owner: root:root
    permissions: '0444'
    encoding: b64
    content: 
  - path: /usr/local/share/aster-s0/corpus/batch-3/acceptance.json
    owner: root:root
    permissions: '0444'
    encoding: b64
    content: 
  - path: /usr/local/share/aster-s0/corpus/batch-3/effort.json
    owner: root:root
    permissions: '0444'
    encoding: b64
    content: 
  - path: /usr/local/share/aster-s0/corpus/batch-3/reviewed-proposal.json
    owner: root:root
    permissions: '0444'
    encoding: b64
    content: 
runcmd:
  - [install, -d, -o, aster-s0, -g, aster-s0, -m, '0700', /var/lib/aster-s0/output]
  - [systemctl, daemon-reload]
  - [sh, -c, 'systemctl start aster-s0-corpus.service; rc=$?; if test -s /var/lib/aster-s0/output/protocol.txt; then cat /var/lib/aster-s0/output/protocol.txt > /dev/ttyS0 || rc=$?; fi; sync; systemctl poweroff; exit "$rc"']
final_message: 'aster-s0 corpus candidate completed'
