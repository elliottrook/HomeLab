{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homelab.invalid/schemas/b60-inference-experiment-v1.json",
  "title": "B60 inference experiment ledger record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "recorded_at",
    "status",
    "hypothesis",
    "prediction",
    "change",
    "rollback",
    "success_thresholds",
    "environment",
    "fixture",
    "raw_evidence"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "experiment_id": { "type": "string", "pattern": "^B60-[0-9]{8}-[0-9]{3}$" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "status": {
      "enum": ["planned", "running", "passed", "failed", "aborted", "invalid"]
    },
    "role_owner": { "type": "string" },
    "auditor": { "type": ["string", "null"] },
    "hypothesis": { "type": "string", "minLength": 1 },
    "prediction": { "type": "string", "minLength": 1 },
    "change": { "type": "string", "minLength": 1 },
    "rollback": { "type": "string", "minLength": 1 },
    "success_thresholds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "kernel", "gpu", "bar_bytes", "runtime", "model_sha256", "config_sha256"],
      "properties": {
        "host": { "type": "string" },
        "bios": { "type": "string" },
        "kernel": { "type": "string" },
        "gpu": { "type": "string" },
        "gpu_driver": { "type": "string" },
        "mesa": { "type": "string" },
        "firmware": { "type": "string" },
        "bar_bytes": { "type": "integer", "minimum": 1 },
        "pcie_path": { "type": "string" },
        "runtime": { "type": "string" },
        "runtime_revision": { "type": "string" },
        "build_flags": { "type": "array", "items": { "type": "string" } },
        "model_sha256": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
        "config_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "prompt_sha256", "context_position", "cache_state", "repetitions"],
      "properties": {
        "name": { "type": "string" },
        "prompt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "context_position": { "type": "integer", "minimum": 0 },
        "cache_state": { "enum": ["cold", "warm", "mixed"] },
        "repetitions": { "type": "integer", "minimum": 5 },
        "correctness_assertions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "tokens", "seconds", "tokens_per_second"],
        "properties": {
          "run_index": { "type": "integer", "minimum": 0 },
          "control_role": { "enum": ["pre_control", "warmup", "measured", "post_control"] },
          "phase": { "enum": ["prefill", "ttft", "decode", "end_to_end", "idle"] },
          "tokens": { "type": "integer", "minimum": 0 },
          "seconds": { "type": "number", "minimum": 0 },
          "tokens_per_second": { "type": ["number", "null"], "minimum": 0 },
          "gpu_resident": { "type": "boolean" },
          "cpu_fallback_detected": { "type": "boolean" },
          "prompt_cache_hit": { "type": ["boolean", "null"] },
          "gpu_frequency_mhz": { "type": ["number", "null"], "minimum": 0 },
          "gpu_temperature_c": { "type": ["number", "null"], "minimum": 0 },
          "gpu_power_w": { "type": ["number", "null"], "minimum": 0 },
          "vram_used_bytes": { "type": ["integer", "null"], "minimum": 0 },
          "ram_used_bytes": { "type": ["integer", "null"], "minimum": 0 },
          "correct": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "median_tokens_per_second": { "type": "number", "minimum": 0 },
        "spread_method": { "type": "string" },
        "spread": { "type": "number", "minimum": 0 },
        "effect_percent": { "type": "number" },
        "correctness_passed": { "type": "boolean" },
        "health_passed": { "type": "boolean" },
        "rollback_passed": { "type": "boolean" }
      }
    },
    "raw_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sanitized": { "type": "boolean" }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } },
    "decision": { "enum": ["pending", "promote", "reject", "refine", "stop"] }
  }
}
