#!/bin/sh
# Proxmox host: return freed blocks from running LXC root filesystems to the
# pve/data thin pool. The host's own fstrim.timer cannot see container
# rootfs mounts. Bind mounts are skipped (--ignore-mountpoints).
# Deployed to /usr/local/sbin/pct-fstrim-all; run by pct-fstrim.timer.
set -u
pool_pct() { lvs --noheadings -o data_percent pve/data | tr -d ' '; }
before=$(pool_pct)
fail=0
for id in $(pct list | awk 'NR>1 && $2=="running" {print $1}'); do
    if out=$(pct fstrim "$id" --ignore-mountpoints 1 2>&1); then
        echo "LXC $id: $(printf '%s\n' "$out" | sed -n 's/.*: \(.*\) trimmed/\1/p' | head -1) trimmed"
    else
        echo "LXC $id: fstrim FAILED: $out" >&2
        fail=1
    fi
done
echo "pve/data data% ${before} -> $(pool_pct)"
exit $fail
