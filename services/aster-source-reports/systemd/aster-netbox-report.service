[Unit]
Description=Produce sanitized NetBox inventory for Aster
After=docker.service

[Service]
Type=oneshot
User=aster-netbox-report
Group=aster-netbox-report
UMask=0077
WorkingDirectory=/opt/aster-source-reports
ExecStart=/usr/bin/python3 /opt/aster-source-reports/netbox_report.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/aster-netbox-report/token
ReadWritePaths=/var/lib/aster-netbox-report
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
