[Unit]
Description=HomeLab AI-PAM independent approval socket candidate

[Service]
Type=simple
User=hlabroker
Group=hlabroker
SupplementaryGroups=aster-approval
UMask=0077
StateDirectory=homelab-broker
StateDirectoryMode=0700
RuntimeDirectory=homelab-broker-approval
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
EnvironmentFile=/etc/aster/approval-ingress.env
ExecStartPre=/usr/bin/chgrp aster-approval /run/homelab-broker-approval
ExecStartPre=/usr/bin/chmod 0750 /run/homelab-broker-approval
ExecStart=/usr/bin/python3 /opt/homelab-broker/broker_approval_service.py --database /var/lib/homelab-broker/broker.db --socket /run/homelab-broker-approval/approval.sock --approver-user aster-approval --socket-group aster-approval --approver-subject-hash ${ASTER_APPROVAL_SUBJECT_HASHES}
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

# Candidate deliberately has no enablement section. It must replace, never run
# beside, the current AI-facing approval peer during a reviewed cutover.
