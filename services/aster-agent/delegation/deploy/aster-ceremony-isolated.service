[Unit]
Description=Approved disposable two-share OpenBao ceremony rehearsal

[Service]
Type=exec
DynamicUser=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
InaccessiblePaths=-/etc/openbao -/opt/openbao -/var/lib/openbao -/run/aster-worker-provision -/etc/credstore.encrypted
MemoryMax=512M
MemorySwapMax=0
CPUQuota=50%
TasksMax=128
LimitCORE=0
RuntimeMaxSec=120
TimeoutStopSec=10
KillMode=control-group
WorkingDirectory=/tmp
Environment=ASTER_ISOLATED_FIXTURE=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B /opt/aster-ceremony-isolated-20261008/isolated_ceremony_rehearsal.py --run
# No Install section: never enable or schedule.
