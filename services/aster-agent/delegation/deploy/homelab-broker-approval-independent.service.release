[Unit]
Description=HomeLab AI-PAM independent approval socket
After=local-fs.target
Before=aster-approval-ingress.service
Conflicts=homelab-broker-approval.service

[Service]
Type=simple
User=hlabroker
Group=hlabroker
SupplementaryGroups=aster-approval
UMask=0077
StateDirectory=homelab-broker
StateDirectoryMode=0700
RuntimeDirectory=homelab-broker-approval
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=yes
EnvironmentFile=/etc/aster/approval-ingress.env
ExecStart=/usr/bin/python3 /opt/homelab-broker/broker_approval_service.py --database /var/lib/homelab-broker/broker.db --socket /run/homelab-broker-approval/approval.sock --approver-user aster-approval --socket-group aster-approval --approver-subject-hash ${ASTER_APPROVAL_SUBJECT_HASHES}
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
