[Unit]
Description=Aster Local Agent API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aster
Group=aster
UMask=0077
WorkingDirectory=/opt/aster-agent
EnvironmentFile=/etc/aster/aster.env
ExecStart=/opt/aster-agent/venv/bin/uvicorn aster_agent:app --host 192.168.70.10 --port 9120 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/aster/knowledge
ReadOnlyPaths=/var/lib/aster/health
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
