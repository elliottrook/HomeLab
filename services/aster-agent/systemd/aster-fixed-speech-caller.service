[Unit]
Description=Aster fixed Speech dedicated caller
After=homelab-broker.service
Requires=homelab-broker.service

[Service]
Type=simple
User=aster-speech-caller
Group=aster-speech-caller
SupplementaryGroups=hlabroker-clients aster-speech-client
UMask=0077
WorkingDirectory=/opt/aster-agent
RuntimeDirectory=aster-fixed-speech-caller
RuntimeDirectoryMode=0755
ExecStart=/opt/aster-agent/venv/bin/python /opt/aster-agent/fixed_speech_caller.py --socket /run/aster-fixed-speech-caller/caller.sock --socket-group aster-speech-client --aster-user aster --broker-socket /run/homelab-broker/mcp.sock
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
