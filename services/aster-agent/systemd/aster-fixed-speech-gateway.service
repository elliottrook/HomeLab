[Unit]
Description=AI-PAM broker-private fixed Aster Speech gateway
After=local-fs.target

[Service]
Type=simple
User=aster
Group=aster-lab-broker
SupplementaryGroups=aster
UMask=0077
WorkingDirectory=/opt/aster-agent
RuntimeDirectory=aster-fixed-speech
RuntimeDirectoryMode=0750
ExecStart=/opt/aster-agent/venv/bin/python /opt/aster-agent/fixed_speech_gateway.py --socket /run/aster-fixed-speech/gateway.sock --socket-group aster-lab-broker --broker-user hlabroker --required-owner root --aggregate /var/lib/aster/health/latest.json --catalogue /var/lib/aster/health/diagnostic-catalogue.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/aster/health
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
