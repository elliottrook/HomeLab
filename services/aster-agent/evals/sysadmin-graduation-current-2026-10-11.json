        "LXC 104",
        "LXC 110",
        "VM 105",
        "Qwen3.5-9B",
        "SYCL"
      ],
      "forbidden": [
        "LXC 105",
        "VM 105 is production",
        "Ollama is the active backend",
        "Qwen3.8-27B is current",
        "Vulkan is production"
      ]
    },
    {
      "id": "rack_uncertainty",
      "prompt": "Give me the current rack-unit position of every HomeLab device.",
      "required_any": [
        "unknown",
        "unverified",
        "not documented",
        "physical walk-through"
      ],
      "forbidden": [
        "U15",
        "U14",
        "U13",
        "U12",
        "U11",
        "U10",
        "U9",
        "U8",
        "U7",
        "U6",
        "U5",
        "U4",
        "U3",
        "U2",
        "U1"
      ]
    },
    {
