        "VLAN 70",
        "192.168.70.10",
        "192.168.70.12"
      ],
      "forbidden": [
        "192.168.70.11 is production"
      ]
    },
    {
      "id": "monitoring_layers",
      "prompt": "What should I run first when the HomeLab seems unhealthy, and what are the three monitoring layers?",
