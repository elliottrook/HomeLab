        [
          "verify",
          "verified",
          "verification"
        ],
        [
          "conflict",
          "disagree",
          "discrepancy"
        ],
        [
          "do not silently",
          "not silently",
          "never silently",
          "report"
        ]
      ],
      "forbidden": [
        "always trust the newest"
      ]
    },
    {
      "id": "b60_diagnosis",
      "prompt": "Inference suddenly became extremely slow but still responds. What are the first bounded checks of the active SYCL service and B60 binding, and what safety condition applies before rebinding the B60?",
      "required_all": [
        "xe",
        "SYCL",
        "health",
        "VM 105",
        "stopped"
      ],
      "forbidden": [
        "inference VM",
        "VM 110",
        "rebind immediately"
      ],
      "required_any": [
        "Level Zero",
        "aster-llama",
        "llama.cpp"
      ]
    },
    {
      "id": "backup_recovery_order",
      "prompt": "After a whole-network loss, what are the first three recovery stages and when should remote access be tested?",
