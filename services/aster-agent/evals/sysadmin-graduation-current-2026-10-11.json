{
  "schema_version": 1,
  "description": "Critical read-only sysadmin graduation cases for Aster — current-runtime revision (2026-10-11); original suite preserved",
  "cases": [
    {
      "id": "runtime_roles",
      "prompt": "What currently runs in LXC 104 and LXC 110, and what is VM 105 for? Name the active model and backend.",
