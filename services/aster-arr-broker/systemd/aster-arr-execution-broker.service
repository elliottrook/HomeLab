[Unit]
Description=Aster single-operation ARR execution broker
After=network-online.target
Wants=network-online.target
ConditionPathExists=/mnt/Media/data/tools/aster-arr-broker/aster-arr-broker.env

[Service]
Type=simple
User=aster-arr-broker
Group=aster-arr-broker
UMask=0077
EnvironmentFile=/mnt/Media/data/tools/aster-arr-broker/aster-arr-broker.env
Environment=ASTER_ARR_BROKER_HOST=127.0.0.1
Environment=ASTER_ARR_BROKER_PORT=9421
Environment=ASTER_ARR_BROKER_STATE_ROOT=/mnt/Media/data/tools/aster-arr-broker/state
Environment=ASTER_ARR_EXECUTION_ENABLED=false
WorkingDirectory=/mnt/Media/data/tools/aster-arr-broker
ExecStart=/usr/bin/python3 /mnt/Media/data/tools/aster-arr-broker/execution_server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectHostname=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
DevicePolicy=closed
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/mnt/Media/data/tools/aster-arr-broker/state

[Install]
WantedBy=multi-user.target
