[Unit]
Description=Single-attempt EPUB narration compiler worker
After=network-online.target aster-speech.service aster-voice-candidate.service
Wants=network-online.target
ConditionPathIsMountPoint=/mnt/calibre-books
ConditionPathIsMountPoint=/mnt/aster-reader

[Service]
Type=oneshot
User=epub-narration
Group=epub-narration
UMask=0077
WorkingDirectory=/opt/epub-narration
Environment=PYTHONPATH=/opt/epub-narration
ExecStart=/opt/aster-voice-candidate/venv/bin/python /opt/epub-narration/tools/run_worker.py --database /mnt/calibre-books/metadata.db --library-root /mnt/calibre-books --data-root /mnt/aster-reader --model /opt/aster-voice/models/kokoro-v1.0.fp16.onnx --voices /opt/aster-voice/models/voices-v1.0.bin --cleanup /opt/epub-narration/vendor/digest_text.py
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/epub-narration /opt/aster-voice/models /mnt/calibre-books
ReadWritePaths=/mnt/aster-reader
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryMax=3G
CPUQuota=300%
TimeoutStartSec=12h
