[Unit]
Description=Private EPUB narration state and output dataset
After=network-online.target
Wants=network-online.target
Before=pve-guests.service

[Mount]
What=192.168.20.40:/mnt/Media/AsterReader
Where=/mnt/epub-aster-reader
Type=nfs4
Options=rw,nosuid,nodev,noexec,_netdev,vers=4.2,hard,timeo=600,retrans=2

[Install]
WantedBy=multi-user.target
