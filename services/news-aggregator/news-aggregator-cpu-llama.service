[Unit]
Description=News Aggregator local Qwen3.5 9B CPU inference
After=network.target
Before=news-aggregator-ingest.service news-aggregator-digest.service

[Service]
Type=simple
User=news-llm
Group=news-llm
Environment=LD_LIBRARY_PATH=/opt/news-llm/llama.cpp-b11429
ExecStart=/opt/news-llm/llama.cpp-b11429/llama-server -m /opt/news-llm/models/Qwen3.5-9B-Q4_K_M.gguf -ngl 0 -c 4096 -np 1 -t 8 -tb 8 -b 256 -ub 128 --jinja --reasoning off --reasoning-budget 0 --host 127.0.0.1 --port 11436 --api-key-file /etc/news-aggregator/cpu-llama-api-key --metrics --log-verbosity 2
ExecStartPost=/usr/local/libexec/news-aggregator-cpu-llama-wait-ready
Restart=on-failure
RestartSec=10s
TimeoutStartSec=180s
TimeoutStopSec=30s
MemoryMax=10G
MemorySwapMax=0
CPUQuota=800%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
