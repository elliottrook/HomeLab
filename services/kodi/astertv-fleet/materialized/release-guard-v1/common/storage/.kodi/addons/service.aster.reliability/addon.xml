<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.aster.reliability" name="AsterTV Reliability Guard" version="1.0.0" provider-name="Aster">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.service" library="service.py" start="startup"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Conservative recovery-state reconciliation for AsterTV</summary>
    <description lang="en_GB">Clears only provably orphaned volatile recovery latches. It never stops playback or clears a playlist.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
