#!/bin/sh
set -eu

# Bedroom LG OLED wake helper. The forced SSH key accepts no caller-supplied
# arguments, and this helper is permanently bound to the IoT interface and the
# owner-observed LG Wi-Fi MAC.
/usr/sbin/wake vlan0.30 74:90:bc:ab:a6:c8
/usr/local/bin/python3 -c '
import socket
import time

mac = bytes.fromhex("7490bcaba6c8")
packet = b"\xff" * 6 + mac * 16
sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
sock.bind(("192.168.30.1", 0))
for _ in range(6):
    sock.sendto(packet, ("192.168.30.255", 9))
    time.sleep(0.25)
'
