{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astertv-overlay-v1",
  "type": "object",
  "required": ["schema_version", "kind", "id", "owner", "layer", "compatible_releases", "dependencies", "targets", "owns", "secret_refs", "rollback_ref", "tests"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "overlay"},
    "id": {"type": "string"},
    "owner": {"type": "string"},
    "layer": {"type": "string"},
    "compatible_releases": {"type": "array", "uniqueItems": true},
    "dependencies": {"type": "array", "uniqueItems": true},
    "targets": {"type": "array", "uniqueItems": true},
    "owns": {"type": "array", "uniqueItems": true},
    "secret_refs": {"type": "array", "uniqueItems": true},
    "rollback_ref": {"type": "string"},
    "tests": {"type": "array", "minItems": 1}
  }
}
