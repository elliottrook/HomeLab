    <include name="AsterGenreTile">
        <definition>
            <control type="panel" id="$PARAM[id]">
                <left>$PARAM[left]</left><top>1100</top><width>240</width><height>360</height>
                <orientation>horizontal</orientation><scrolltime>180</scrolltime>
                <onleft>$PARAM[lefttarget]</onleft><onright>$PARAM[righttarget]</onright>
                <onup>$PARAM[uptarget]</onup><ondown>$PARAM[id]</ondown>
                <onclick>ActivateWindow(Videos,$PARAM[browse],return)</onclick>
                <itemlayout width="240" height="360">
                    <control type="image"><left>15</left><top>8</top><width>210</width><height>315</height><texture background="true" diffuse="special://skin/media/ui-poster-mask.png">$VAR[AsterPosterArt]</texture><aspectratio scalediffuse="false">scale</aspectratio></control>
                    <control type="image"><left>15</left><top>8</top><width>210</width><height>315</height><texture border="28" colordiffuse="48f2ede4">special://skin/media/ui-panel.png</texture></control>
                    <control type="label"><left>15</left><top>330</top><width>210</width><height>30</height><label>$PARAM[label]</label><font>font20</font><textcolor>asterInk</textcolor><align>center</align><aligny>center</aligny></control>
                </itemlayout>
                <focusedlayout width="240" height="360">
                    <control type="image"><left>15</left><top>8</top><width>210</width><height>315</height><texture background="true" diffuse="special://skin/media/ui-poster-mask.png">$VAR[AsterPosterArt]</texture><aspectratio scalediffuse="false">scale</aspectratio></control>
                    <control type="image"><left>15</left><top>8</top><width>210</width><height>315</height><texture colordiffuse="asterSage">special://skin/media/ui-poster-ring.png</texture></control>
                    <control type="label"><left>15</left><top>330</top><width>210</width><height>30</height><label>$PARAM[label]</label><font>font20</font><textcolor>asterInk</textcolor><align>center</align><aligny>center</aligny></control>
                </focusedlayout>
                <content target="videos">$PARAM[preview]</content>
            </control>
        </definition>
    </include>
