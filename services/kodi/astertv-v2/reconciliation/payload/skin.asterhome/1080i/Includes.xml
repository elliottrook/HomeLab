    <include name="AsterWatchBadges">
        <control type="image">
            <left>$PARAM[left]</left><top>$PARAM[top]</top><width>56</width><height>42</height>
            <texture border="18" colordiffuse="asterGreen">special://skin/media/ui-panel.png</texture>
            <visible>!ListItem.IsParentFolder + Integer.IsGreater(ListItem.Property(UnWatchedEpisodes),0) + [String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season)]</visible>
        </control>
        <control type="label">
            <left>$PARAM[left]</left><top>$PARAM[top]</top><width>56</width><height>42</height>
            <label>$INFO[ListItem.Property(UnWatchedEpisodes)]</label><font>font20</font>
            <textcolor>asterIvory</textcolor><align>center</align><aligny>center</aligny>
            <visible>!ListItem.IsParentFolder + Integer.IsGreater(ListItem.Property(UnWatchedEpisodes),0) + [String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season)]</visible>
        </control>
        <control type="image">
            <left>$PARAM[left]</left><top>$PARAM[top]</top><width>32</width><height>32</height>
            <texture colordiffuse="asterSage">special://skin/media/ui-timer-dot.png</texture>
            <visible>!ListItem.IsParentFolder + !ListItem.IsResumable + !Integer.IsGreater(ListItem.Property(UnWatchedEpisodes),0) + [String.IsEqual(ListItem.Overlay,OverlayWatched.png) | Integer.IsGreater(ListItem.PlayCount,0)]</visible>
        </control>
        <control type="label">
            <left>$PARAM[left]</left><top>$PARAM[top]</top><width>32</width><height>32</height>
            <label>✓</label><font>font16</font><textcolor>asterInk</textcolor>
            <align>center</align><aligny>center</aligny>
            <visible>!ListItem.IsParentFolder + !ListItem.IsResumable + !Integer.IsGreater(ListItem.Property(UnWatchedEpisodes),0) + [String.IsEqual(ListItem.Overlay,OverlayWatched.png) | Integer.IsGreater(ListItem.PlayCount,0)]</visible>
        </control>
        <control type="label">
            <left>$PARAM[left]</left><top>$PARAM[top]</top><width>42</width><height>42</height>
            <label>●</label><font>font16</font><textcolor>asterSage</textcolor>
            <align>center</align><aligny>center</aligny>
            <visible>!ListItem.IsParentFolder + !ListItem.IsResumable + !Integer.IsGreater(ListItem.PlayCount,0) + !Integer.IsGreater(ListItem.Property(UnWatchedEpisodes),0) + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,episode)]</visible>
        </control>
    </include>

