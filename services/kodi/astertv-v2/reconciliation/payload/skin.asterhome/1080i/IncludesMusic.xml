<?xml version='1.0' encoding='utf-8'?>
<includes>
  <include name="AsterMusicPillButton">
    <width>200</width><height>50</height><font>font20</font><align>left</align><aligny>center</aligny>
    <textoffsetx>50</textoffsetx><textcolor>asterIvory</textcolor><focusedcolor>asterIvory</focusedcolor>
    <texturefocus border="20" colordiffuse="asterGreen">special://skin/media/ui-panel.png</texturefocus>
    <texturenofocus border="20" colordiffuse="c929302b">special://skin/media/ui-panel.png</texturenofocus>
  </include>
  <include name="AsterMusicPage">
    <param name="gridup" default="111" /><param name="page" />
    <param name="gridleft" />
    <param name="gridwidth" />
    <param name="searchvisible" />
    <param name="heading" />
    <param name="actionlabel" />
    <param name="lefttarget" />
    <param name="activeleft" />
    <definition>
      <control type="image">
        <left>0</left><top>0</top><width>1920</width><height>1080</height>
        <texture background="true">$INFO[Container(500).ListItem.Art(fanart)]</texture>
        <aspectratio>scale</aspectratio><fadetime>250</fadetime>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>1920</width><height>1080</height>
        <texture>special://skin/media/ui-solid.png</texture>
        <colordiffuse>66000000</colordiffuse><aspectratio>stretch</aspectratio>
        <visible>!String.IsEmpty(Container(500).ListItem.Art(fanart))</visible>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>1920</width><height>1080</height>
        <texture>special://skin/media/ui-hero-left-fade.png</texture>
        <colordiffuse>asterCharcoal</colordiffuse><aspectratio>stretch</aspectratio>
        <visible>!String.IsEmpty(Container(500).ListItem.Label)</visible>
      </control>
      <control type="image">
        <left>0</left><top>0</top><width>1920</width><height>1080</height>
        <texture>special://skin/media/ui-hero-bottom-fade.png</texture>
        <colordiffuse>asterStone</colordiffuse><aspectratio>stretch</aspectratio>
      </control>
      <include content="AsterNavigationRail"><param name="content" value="500" /><param name="railfocus" value="9007" /></include>
      <control type="group">
        <control type="image"><left>0</left><top>0</top><width>1920</width><height>160</height><texture>special://skin/media/ui-solid.png</texture><colordiffuse>ff3b3a32</colordiffuse></control><visible>!Control.HasFocus(8999) + !Control.HasFocus(9001) + !Control.HasFocus(9002) + !Control.HasFocus(9003) + !Control.HasFocus(9004) + !Control.HasFocus(9005) + !Control.HasFocus(9007)</visible>
        <control type="image">
          <left>110</left><top>0</top><width>240</width><height>160</height>
          <texture>special://skin/media/29-aster-music-logo.png</texture><aspectratio>keep</aspectratio>
        </control>
        <control type="button" id="110"><left>385</left><top>28</top><label>Albums</label><include>AsterMusicPillButton</include><onclick>ActivateWindow(1114)</onclick><onleft>8999</onleft><onright>111</onright><ondown>500</ondown></control>
        <control type="button" id="111"><left>597</left><top>28</top><label>Artists</label><include>AsterMusicPillButton</include><onclick>ActivateWindow(1115)</onclick><onleft>110</onleft><onright>112</onright><ondown>500</ondown></control>
        <control type="button" id="112"><left>809</left><top>28</top><label>Songs</label><include>AsterMusicPillButton</include><onclick>ActivateWindow(1116)</onclick><onleft>111</onleft><onright>113</onright><ondown>500</ondown></control>
        <control type="button" id="113"><left>1021</left><top>28</top><label>Playlists</label><include>AsterMusicPillButton</include><onclick>ActivateWindow(1117)</onclick><onleft>112</onleft><onright>114</onright><ondown>500</ondown></control>
        <control type="image"><left>$PARAM[activeleft]</left><top>86</top><width>200</width><height>4</height><texture>special://skin/media/ui-solid.png</texture><colordiffuse>asterGreen</colordiffuse><visible>$PARAM[activevisible]</visible></control>
        <control type="image"><left>395</left><top>35</top><width>36</width><height>36</height><texture>special://skin/media/23-music-album.png</texture><aspectratio>keep</aspectratio></control>
        <control type="image"><left>607</left><top>35</top><width>36</width><height>36</height><texture>special://skin/media/24-music-artist.png</texture><aspectratio>keep</aspectratio></control>
        <control type="image"><left>819</left><top>35</top><width>36</width><height>36</height><texture>special://skin/media/25-music-song.png</texture><aspectratio>keep</aspectratio></control>
        <control type="image"><left>1031</left><top>35</top><width>36</width><height>36</height><texture>special://skin/media/26-music-playlist.png</texture><aspectratio>keep</aspectratio></control>
        <include content="AsterClockPill" />
        <control type="label"><left>1050</left><top>163</top><width>700</width><height>38</height><label>$PARAM[heading]</label><font>font24</font><textcolor>asterGold</textcolor></control>
        <control type="label"><left>1050</left><top>214</top><width>760</width><height>68</height><label>$INFO[Container(500).ListItem.Label]</label><font>font40</font><textcolor>asterRailText</textcolor></control>
        <control type="textbox"><left>1050</left><top>288</top><width>710</width><height>85</height><label>$INFO[Container(500).ListItem.Property(AsterMusic.Summary)]</label><font>font24</font><textcolor>asterRailText</textcolor></control>
        <control type="label"><left>1050</left><top>386</top><width>760</width><height>32</height><label>$INFO[Window.Property(AsterMusic.Status)]</label><font>font20</font><textcolor>asterSage</textcolor></control>
        <control type="label"><left>$PARAM[gridleft]</left><top>555</top><width>1060</width><height>48</height><label>$PARAM[heading]</label><font>font30</font><textcolor>asterInk</textcolor></control>
        <control type="group">
          <visible>$PARAM[searchvisible]</visible>
          <control type="label"><left>1560</left><top>636</top><width>260</width><height>40</height><label>Search &amp; filter</label><font>font24</font><textcolor>asterMuted</textcolor></control>
          <include content="AsterQuietFieldBackplate"><param name="left" value="1560" /><param name="top" value="708" /><param name="innerleft" value="1562" /><param name="innertop" value="710" /><param name="innerwidth" value="256" /><param name="innerheight" value="52" /></include>
          <include content="AsterQuietFieldBackplate"><param name="left" value="1560" /><param name="top" value="780" /><param name="innerleft" value="1562" /><param name="innertop" value="782" /><param name="innerwidth" value="256" /><param name="innerheight" value="52" /></include>
          <control type="button" id="301"><left>1560</left><top>708</top><label>$INFO[Window.Property(AsterMusic.SearchLabel)]</label><include>AsterFilterButton</include><onclick>RunScript(special://skin/tools/music_data.py,$PARAM[page],search)</onclick><onleft>500</onleft><onright>8999</onright><onup>111</onup><ondown>302</ondown></control>
          <control type="button" id="302"><left>1560</left><top>780</top><label>Clear search</label><include>AsterFilterButton</include><onclick>RunScript(special://skin/tools/music_data.py,$PARAM[page],clear)</onclick><onleft>500</onleft><onright>8999</onright><onup>301</onup><ondown>500</ondown></control>
          <control type="label"><left>1560</left><top>880</top><width>260</width><height>100</height><label>$PARAM[searchhint]</label><font>font20</font><textcolor>asterMuted</textcolor><wrapmultiline>true</wrapmultiline></control>
        </control>
        <control type="panel" id="500">
          <left>$PARAM[gridleft]</left><top>615</top><width>$PARAM[gridwidth]</width><height>430</height>
          <viewtype label="Album tiles">icon</viewtype><orientation>vertical</orientation><scrolltime>180</scrolltime><preloaditems>2</preloaditems>
          <onleft>8999</onleft><onright>$PARAM[righttarget]</onright><onup>$PARAM[gridup]</onup><onclick>RunScript(special://skin/tools/music_data.py,$PARAM[page],open)</onclick>
          <itemlayout width="300" height="345">
            <control type="image"><left>10</left><top>4</top><width>260</width><height>260</height><texture border="28">special://skin/media/ui-panel.png</texture><colordiffuse>asterIvory</colordiffuse><visible>!String.IsEqual(ListItem.Property(AsterMusic.HasArt),true)</visible></control>
            <control type="image"><left>76</left><top>70</top><width>128</width><height>128</height><texture>$INFO[ListItem.Art(thumb)]</texture><aspectratio>keep</aspectratio><visible>!String.IsEqual(ListItem.Property(AsterMusic.HasArt),true)</visible></control>
            <control type="image"><left>10</left><top>4</top><width>260</width><height>260</height><texture background="true" diffuse="special://skin/media/ui-album-mask.png">$INFO[ListItem.Art(thumb)]</texture><aspectratio scalediffuse="false">scale</aspectratio><visible>String.IsEqual(ListItem.Property(AsterMusic.HasArt),true)</visible></control>
            <control type="label"><left>10</left><top>274</top><width>260</width><height>32</height><label>$INFO[ListItem.Label]</label><font>font20</font><textcolor>asterInk</textcolor></control>
            <control type="label"><left>10</left><top>307</top><width>260</width><height>26</height><label>$INFO[ListItem.Label2]</label><font>font16</font><textcolor>asterMuted</textcolor></control>
          </itemlayout>
          <focusedlayout width="300" height="345">
            <control type="image"><left>0</left><top>0</top><width>280</width><height>280</height><texture>special://skin/media/ui-album-ring.png</texture><colordiffuse>asterIvory</colordiffuse></control>
            <control type="image"><left>4</left><top>0</top><width>272</width><height>272</height><texture border="28">special://skin/media/ui-panel.png</texture><colordiffuse>asterIvory</colordiffuse><visible>!String.IsEqual(ListItem.Property(AsterMusic.HasArt),true)</visible></control>
            <control type="image"><left>76</left><top>68</top><width>128</width><height>128</height><texture>$INFO[ListItem.Art(thumb)]</texture><aspectratio>keep</aspectratio><visible>!String.IsEqual(ListItem.Property(AsterMusic.HasArt),true)</visible></control>
            <control type="image"><left>4</left><top>0</top><width>272</width><height>272</height><texture background="true" diffuse="special://skin/media/ui-album-mask.png">$INFO[ListItem.Art(thumb)]</texture><aspectratio scalediffuse="false">scale</aspectratio><visible>String.IsEqual(ListItem.Property(AsterMusic.HasArt),true)</visible></control>
            <control type="image"><left>4</left><top>0</top><width>272</width><height>272</height><texture>special://skin/media/ui-album-ring.png</texture><colordiffuse>asterGreen</colordiffuse></control>
            <control type="label"><left>4</left><top>280</top><width>272</width><height>32</height><label>$INFO[ListItem.Label]</label><font>font20</font><textcolor>asterGreen</textcolor></control>
            <control type="label"><left>4</left><top>313</top><width>272</width><height>26</height><label>$INFO[ListItem.Label2]</label><font>font16</font><textcolor>asterMuted</textcolor></control>
          </focusedlayout>
        </control>
      <control type="button" id="114"><left>1233</left><top>28</top><label>Genres</label><include>AsterMusicPillButton</include><onclick>RunScript(special://skin/tools/aster_v2_music.py,genres,$PARAM[page])</onclick><onleft>113</onleft><onright>500</onright><ondown>500</ondown></control><control type="image"><left>1243</left><top>35</top><width>36</width><height>36</height><texture>special://skin/media/13-music.png</texture><aspectratio>keep</aspectratio></control><control type="button" id="115"><left>1050</left><top>455</top><width>320</width><height>56</height><label>Shuffle all</label><font>font24</font><align>center</align><aligny>center</aligny><textcolor>asterIvory</textcolor><focusedcolor>asterIvory</focusedcolor><onleft>110</onleft><onright>500</onright><onup>112</onup><ondown>500</ondown><visible>Window.IsActive(11113)</visible><onclick>RunScript(special://skin/tools/aster_v2_music.py,shuffle,home)</onclick><texturefocus border="20" colordiffuse="asterGreen">special://skin/media/ui-panel.png</texturefocus><texturenofocus border="20" colordiffuse="c929302b">special://skin/media/ui-panel.png</texturenofocus><enable>String.IsEqual(Window.Property(AsterMusic.LoadReady),true)</enable></control></control>
    </definition>
  </include>
</includes>