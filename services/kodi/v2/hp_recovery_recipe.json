    {"id": "compiled-books", "kind": "private-service", "requirement": "TrueNAS AsterReader ready and generations exports reachable read-only at their fixed sources"},
    {"id": "restricted-identities", "kind": "restricted-provisioning", "requirement": "Provision YouTube account state and restricted voice, Home, camera, Books and request identities separately; never copy them from another client or bundle"}
