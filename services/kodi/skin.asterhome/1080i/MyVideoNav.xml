<?xml version="1.0" encoding="UTF-8"?>
<window>
  <defaultcontrol always="true">50</defaultcontrol>
  <views>50</views>
  <backgroundcolor>asterCharcoal</backgroundcolor>
  <controls>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture background="true">$VAR[AsterBrowseFanart]</texture>
      <aspectratio>scale</aspectratio>
      <fadetime>250</fadetime>
    </control>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture>special://skin/media/ui-hero-left-fade.png</texture>
      <colordiffuse>asterCharcoal</colordiffuse>
      <aspectratio>stretch</aspectratio>
    </control>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture>special://skin/media/ui-hero-bottom-fade.png</texture>
      <colordiffuse>asterStone</colordiffuse>
      <aspectratio>stretch</aspectratio>
    </control>
    <control type="image">
      <left>65</left>
      <top>18</top>
      <width>88</width>
      <height>88</height>
      <texture>$VAR[AsterBrowseIcon]</texture>
      <aspectratio>keep</aspectratio>
    </control>
    <control type="label">
      <left>175</left>
      <top>32</top>
      <width>1150</width>
      <height>60</height>
      <label>$VAR[AsterBrowseHeading]</label>
      <font>font40</font>
      <textcolor>asterRailText</textcolor>
    </control>
    <control type="button" id="9000">
      <left>1540</left>
      <top>34</top>
      <label>Back</label>
      <include>AsterCategoryButton</include>
      <width>280</width>
      <onclick>Action(Back)</onclick>
      <ondown>50</ondown>
    </control>
    <control type="label">
      <left>145</left>
      <top>132</top>
      <width>1200</width>
      <height>40</height>
      <label>$INFO[Container(50).ListItem.Genre]  [COLOR asterSage]$INFO[Container(50).ListItem.Year][/COLOR]</label>
      <font>font20</font>
      <textcolor>asterGold</textcolor>
    </control>
    <control type="label">
      <left>145</left>
      <top>178</top>
      <width>1200</width>
      <height>70</height>
      <label>$VAR[AsterBrowseTitle]</label>
      <font>font40</font>
      <textcolor>asterRailText</textcolor>
      <shadowcolor>66000000</shadowcolor>
    </control>
    <control type="label">
      <left>145</left>
      <top>256</top>
      <width>940</width>
      <height>44</height>
      <label>$INFO[Container(50).ListItem.Plot]</label>
      <font>font20</font>
      <textcolor>asterRailText</textcolor>
      <wrapmultiline>true</wrapmultiline>
      <aligny>top</aligny>
    </control>
    <control type="label">
      <left>145</left><top>308</top><width>940</width><height>30</height>
      <label>$INFO[Container(50).ListItem.Rating,Score: , / 10]  $INFO[Container(50).ListItem.Mpaa]</label>
      <font>font20</font><textcolor>asterSage</textcolor>
      <visible>!Container(50).ListItem.IsParentFolder</visible>
    </control>
    <control type="button" id="9100">
      <left>145</left>
      <top>350</top>
      <label>$VAR[AsterBrowseAction]</label>
      <width>280</width>
      <height>56</height>
      <font>font24</font>
      <align>center</align>
      <aligny>center</aligny>
      <textcolor>asterRailText</textcolor>
      <focusedcolor>asterInk</focusedcolor>
      <texturefocus border="20" colordiffuse="asterSage">special://skin/media/ui-panel.png</texturefocus>
      <texturenofocus border="20" colordiffuse="asterGreen">special://skin/media/ui-panel.png</texturenofocus>
      <onclick>SendClick(50)</onclick>
      <onright>9101</onright>
      <onleft>19</onleft>
      <onup>9000</onup>
      <ondown>50</ondown>
    </control>
    <control type="button" id="9101">
      <left>445</left>
      <top>350</top>
      <label>ⓘ  More Info</label>
      <include>AsterCategoryButton</include>
      <width>280</width>
      <onclick>SetFocus(50)</onclick>
      <onclick>Action(Info)</onclick>
      <onleft>9100</onleft>
      <onright>50</onright>
      <onup>9000</onup>
      <ondown>50</ondown>
    </control>
    <control type="image">
      <left>145</left>
      <top>350</top>
      <width>280</width>
      <height>56</height>
      <texture>special://skin/media/ui-button-ring.png</texture>
      <visible>Control.HasFocus(9100)</visible>
    </control>
    <control type="image">
      <left>445</left>
      <top>350</top>
      <width>280</width>
      <height>56</height>
      <texture>special://skin/media/ui-button-ring.png</texture>
      <visible>Control.HasFocus(9101)</visible>
    </control>
    <!-- Native title filtering is local to this category, not server search. -->
    <control type="image">
      <left>65</left>
      <top>492</top>
      <width>300</width>
      <height>548</height>
      <texture border="20">special://skin/media/ui-panel.png</texture>
      <colordiffuse>e6f2ede4</colordiffuse>
    </control>
    <control type="label">
      <left>85</left>
      <top>512</top>
      <width>260</width>
      <height>40</height>
      <label>Search &amp; filter</label>
      <font>font24</font>
      <textcolor>asterMuted</textcolor>
    </control>
    <include content="AsterQuietFieldBackplate"><param name="left" value="85" /><param name="top" value="564" /><param name="innerleft" value="87" /><param name="innertop" value="566" /><param name="innerwidth" value="256" /><param name="innerheight" value="52" /></include>
    <control type="edit" id="19">
      <left>85</left>
      <top>564</top>
      <width>260</width>
      <height>56</height>
      <hinttext>Search titles…</hinttext>
      <font>font20</font>
      <textcolor>asterIvory</textcolor>
      <focusedcolor>asterInk</focusedcolor>
      <texturefocus border="20" colordiffuse="asterSage">special://skin/media/ui-panel.png</texturefocus>
      <texturenofocus>none</texturenofocus>
      <onright>50</onright>
      <onup>9100</onup>
      <ondown>9200</ondown>
    </control>
    <include content="AsterQuietFieldBackplate"><param name="left" value="85" /><param name="top" value="636" /><param name="innerleft" value="87" /><param name="innertop" value="638" /><param name="innerwidth" value="256" /><param name="innerheight" value="52" /></include>
    <include content="AsterQuietFieldBackplate"><param name="left" value="85" /><param name="top" value="708" /><param name="innerleft" value="87" /><param name="innertop" value="710" /><param name="innerwidth" value="256" /><param name="innerheight" value="52" /></include>
    <include content="AsterQuietFieldBackplate"><param name="left" value="85" /><param name="top" value="780" /><param name="innerleft" value="87" /><param name="innertop" value="782" /><param name="innerwidth" value="256" /><param name="innerheight" value="52" /></include>
    <include content="AsterQuietFieldBackplate"><param name="left" value="85" /><param name="top" value="852" /><param name="innerleft" value="87" /><param name="innertop" value="854" /><param name="innerwidth" value="256" /><param name="innerheight" value="52" /></include>
    <control type="button" id="9001">
      <left>85</left>
      <top>780</top>
      <label>Clear all filters</label>
      <include>AsterFilterButton</include>
      <onclick>Action(FilterClear)</onclick>
      <onclick>RunScript(special://skin/tools/filter_library.py,clear)</onclick>
      <onup>9201</onup>
      <ondown>4</ondown>
      <onright>50</onright>
    </control>
    <control type="button" id="4">
      <left>85</left>
      <top>852</top>
      <label>Reverse order</label>
      <include>AsterFilterButton</include>
      <onup>9001</onup>
      <ondown>9000</ondown>
      <onright>50</onright>
    </control>
    <control type="label">
      <left>85</left>
      <top>924</top>
      <width>260</width>
      <height>100</height>
      <label>$INFO[Container(50).NumItems] titles[CR]Filters stay in this category[CR]Score is out of 10</label>
      <font>font20</font>
      <textcolor>asterMuted</textcolor>
      <wrapmultiline>true</wrapmultiline>
    </control>
    <control type="button" id="9200">
      <left>85</left><top>636</top><label>$VAR[AsterGenreFilterLabel]</label>
      <include>AsterFilterButton</include>
      <onclick>RunScript(special://skin/tools/filter_library.py,genre)</onclick>
      <enable>String.Contains(Container.FolderPath,.xsp)</enable>
      <onup>19</onup><ondown>9201</ondown><onright>50</onright>
    </control>
    <control type="button" id="9201">
      <left>85</left><top>708</top><label>$VAR[AsterScoreFilterLabel]</label>
      <include>AsterFilterButton</include>
      <onclick>RunScript(special://skin/tools/filter_library.py,rating)</onclick>
      <enable>String.Contains(Container.FolderPath,.xsp)</enable>
      <onup>9200</onup><ondown>9001</ondown><onright>50</onright>
    </control>
    <control type="panel" id="50">
      <left>400</left>
      <top>492</top>
      <width>1440</width>
      <height>548</height>
      <viewtype label="Posters">poster</viewtype>
      <orientation>vertical</orientation>
      <scrolltime>180</scrolltime>
      <preloaditems>2</preloaditems>
      <onup>9100</onup>
      <onleft>19</onleft>
      <itemlayout width="280" height="410">
        <control type="image">
          <visible>ListItem.IsParentFolder</visible>
          <left>12</left>
          <top>8</top>
          <width>220</width>
          <height>330</height>
          <texture border="20">special://skin/media/ui-panel.png</texture>
          <colordiffuse>asterPaper</colordiffuse>
        </control>
        <control type="label">
          <visible>ListItem.IsParentFolder</visible>
          <left>12</left>
          <top>8</top>
          <width>220</width>
          <height>330</height>
          <label>‹ Back</label>
          <font>font40</font>
          <textcolor>asterGreen</textcolor>
          <align>center</align>
          <aligny>center</aligny>
        </control>
        <control type="image">
          <left>12</left>
          <top>8</top>
          <width>220</width>
          <height>330</height>
          <texture background="true" diffuse="special://skin/media/ui-poster-mask.png">$VAR[AsterPosterArt]</texture>
          <aspectratio scalediffuse="false">scale</aspectratio>
        </control>
        <control type="textbox">
          <left>12</left>
          <top>350</top>
          <width>220</width>
          <height>48</height>
          <label>$VAR[AsterPosterLabel]</label>
          <font>font20</font>
          <textcolor>asterInk</textcolor>
          <wrapmultiline>true</wrapmultiline>
        </control>
      </itemlayout>
      <focusedlayout width="280" height="410">
        <control type="image">
          <visible>ListItem.IsParentFolder</visible>
          <left>12</left>
          <top>8</top>
          <width>220</width>
          <height>330</height>
          <texture border="20">special://skin/media/ui-panel.png</texture>
          <colordiffuse>asterPaper</colordiffuse>
        </control>
        <control type="label">
          <visible>ListItem.IsParentFolder</visible>
          <left>12</left>
          <top>8</top>
          <width>220</width>
          <height>330</height>
          <label>‹ Back</label>
          <font>font40</font>
          <textcolor>asterGreen</textcolor>
          <align>center</align>
          <aligny>center</aligny>
        </control>
        <control type="image">
          <left>12</left>
          <top>8</top>
          <width>220</width>
          <height>330</height>
          <texture background="true" diffuse="special://skin/media/ui-poster-mask.png">$VAR[AsterPosterArt]</texture>
          <aspectratio scalediffuse="false">scale</aspectratio>
        </control>
        <control type="image">
          <left>12</left>
          <top>8</top>
          <width>220</width>
          <height>330</height>
          <texture>special://skin/media/ui-poster-ring.png</texture>
          <colordiffuse>asterGreen</colordiffuse>
        </control>
        <control type="textbox">
          <left>12</left>
          <top>350</top>
          <width>220</width>
          <height>48</height>
          <label>$VAR[AsterPosterLabel]</label>
          <font>font20</font>
          <textcolor>asterGreen</textcolor>
          <wrapmultiline>true</wrapmultiline>
        </control>
      </focusedlayout>
    </control>
  </controls>
</window>
