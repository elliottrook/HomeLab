<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">9000</defaultcontrol>
    <backgroundcolor>asterCharcoal</backgroundcolor>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture background="true">$INFO[ListItem.Art(fanart)]</texture><aspectratio>scale</aspectratio>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture>special://skin/media/ui-hero-left-fade.png</texture><colordiffuse>asterCharcoal</colordiffuse><aspectratio>stretch</aspectratio>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture>special://skin/media/ui-hero-bottom-fade.png</texture><colordiffuse>asterStone</colordiffuse><aspectratio>stretch</aspectratio>
        </control>
        <control type="image">
            <left>110</left><top>0</top><width>240</width><height>160</height>
            <texture>special://skin/media/27-aster-media-logo.png</texture><aspectratio>keep</aspectratio>
        </control>
        <control type="button" id="9000">
            <left>1540</left><top>34</top><label>Back</label><include>AsterCategoryButton</include>
            <onclick>Action(Back)</onclick><ondown>400</ondown>
        </control>
        <control type="label">
            <left>145</left><top>176</top><width>1450</width><height>42</height>
            <label>$INFO[ListItem.Genre]  [COLOR asterSage]$INFO[ListItem.Year][/COLOR]</label>
            <font>font20</font><textcolor>asterGold</textcolor>
        </control>
        <control type="label">
            <left>145</left><top>229</top><width>1550</width><height>100</height>
            <label>$INFO[ListItem.Title]</label><include>AsterHeroTitle</include>
        </control>
        <control type="image">
            <left>145</left><top>440</top><width>300</width><height>450</height>
            <texture background="true" diffuse="special://skin/media/ui-poster-mask.png">$VAR[AsterPosterArt]</texture>
            <aspectratio scalediffuse="false">scale</aspectratio>
        </control>
        <control type="image">
            <left>500</left><top>440</top><width>1260</width><height>560</height>
            <texture border="20">special://skin/media/ui-panel.png</texture><colordiffuse>e6f2ede4</colordiffuse>
        </control>
        <control type="textbox" id="400">
            <left>540</left><top>475</top><width>1180</width><height>480</height>
            <label>$INFO[ListItem.Plot]</label><font>font24</font><textcolor>asterInk</textcolor>
            <onup>9000</onup><onleft>9000</onleft><onright>9000</onright><ondown>9000</ondown>
        </control>
    </controls>
</window>
