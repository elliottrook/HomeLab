<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include file="IncludesHub.xml" />
    <include file="IncludesMusic.xml" />
    <include file="IncludesBooks.xml" />
    <variable name="AsterGenreFilterLabel">
        <value condition="String.Contains(Container.FolderPath,skin.asterhome/filters/) + !String.IsEmpty(Window(10025).Property(AsterFilterGenre))">$INFO[Window(10025).Property(AsterFilterGenre),Genre: ]</value>
        <value>Genre…</value>
    </variable>
    <variable name="AsterScoreFilterLabel">
        <value condition="String.Contains(Container.FolderPath,skin.asterhome/filters/) + !String.IsEmpty(Window(10025).Property(AsterFilterScore))">$INFO[Window(10025).Property(AsterFilterScore),Score: ]</value>
        <value>Minimum score…</value>
    </variable>
    <variable name="AsterBrowseIcon">
        <value condition="String.Contains(Container.FolderPath,archive-tv.xsp)">special://skin/media/09-archive-tv.png</value>
        <value condition="String.Contains(Container.FolderPath,archive-film.xsp)">special://skin/media/10-archive-film.png</value>
        <value condition="Container.Content(sets)">special://skin/media/19-movie-collections-128.png</value>
        <value condition="Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes)">special://skin/media/07-tv.png</value>
        <value>special://skin/media/08-film.png</value>
    </variable>
    <variable name="AsterHeroRating">
        <value condition="Control.HasFocus(110) + !String.IsEmpty(Container(110).ListItem.Rating)">$INFO[Container(110).ListItem.Rating,Score: , / 10]  $INFO[Container(110).ListItem.Mpaa]</value>
        <value condition="!Control.HasFocus(110) + !String.IsEmpty(Container(100).ListItem.Rating)">$INFO[Container(100).ListItem.Rating,Score: , / 10]  $INFO[Container(100).ListItem.Mpaa]</value>
        <value>Score unavailable</value>
    </variable>
    <variable name="AsterBrowseHeading">
        <value condition="Container.Content(sets)">Collections</value>
        <value>$INFO[Container.FolderName]</value>
    </variable>
    <variable name="AsterPosterArt">
        <value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
        <value>$INFO[ListItem.Art(thumb)]</value>
    </variable>
    <variable name="AsterBrowseFanart">
        <value condition="!String.IsEmpty(Container(50).ListItem.Art(fanart))">$INFO[Container(50).ListItem.Art(fanart)]</value>
        <value>$INFO[Container(50).ListItem.Art(tvshow.fanart)]</value>
    </variable>
    <variable name="AsterBrowseTitle">
        <value condition="Container(50).ListItem.IsParentFolder">Choose a title</value>
        <value>$INFO[Container(50).ListItem.Label]</value>
    </variable>
    <variable name="AsterPosterLabel">
        <value condition="ListItem.IsParentFolder">Back</value>
        <value>$INFO[ListItem.Label]</value>
    </variable>
    <variable name="AsterBrowseAction">
        <value condition="Container.Content(tvshows) | Container.Content(sets) | Container.Content(seasons)">▶  Browse</value>
        <value>▶  Play</value>
    </variable>
    <variable name="AsterContinueLabel">
        <value condition="!String.IsEmpty(ListItem.Episode)">$INFO[ListItem.TVShowTitle] — S$INFO[ListItem.Season] E$INFO[ListItem.Episode]</value>
        <value>$INFO[ListItem.Label]</value>
    </variable>
    <variable name="AsterCardArt">
        <value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
        <value>$INFO[ListItem.Art(thumb)]</value>
    </variable>
    <variable name="AsterHeroLabel">
        <value condition="Control.HasFocus(110)">$INFO[Container(110).ListItem.Label]</value>
        <value condition="!String.IsEmpty(Container(100).ListItem.TVShowTitle)">$INFO[Container(100).ListItem.TVShowTitle]</value>
        <value>$INFO[Container(100).ListItem.Label]</value>
    </variable>
    <variable name="AsterHeroPlot">
        <value condition="Control.HasFocus(110)">$INFO[Container(110).ListItem.Plot]</value>
        <value>$INFO[Container(100).ListItem.Plot]</value>
    </variable>
    <variable name="AsterHeroYear">
        <value condition="Control.HasFocus(110)">$INFO[Container(110).ListItem.Year]</value>
        <value>$INFO[Container(100).ListItem.Year]</value>
    </variable>
    <variable name="AsterHeroDuration">
        <value condition="Control.HasFocus(110)">$INFO[Container(110).ListItem.Duration(hh:mm)]</value>
        <value>$INFO[Container(100).ListItem.Duration(hh:mm)]</value>
    </variable>
    <variable name="AsterHeroGenre">
        <value condition="Control.HasFocus(110)">$INFO[Container(110).ListItem.Genre]</value>
        <value>$INFO[Container(100).ListItem.Genre]</value>
    </variable>
    <variable name="AsterHeroResolution">
        <value condition="Control.HasFocus(110)">$INFO[Container(110).ListItem.VideoResolution]</value>
        <value>$INFO[Container(100).ListItem.VideoResolution]</value>
    </variable>
    <variable name="AsterHeroFanart">
        <value condition="Control.HasFocus(110)">$INFO[Container(110).ListItem.Art(fanart)]</value>
        <value>$INFO[Container(100).ListItem.Art(fanart)]</value>
    </variable>
    <variable name="AsterHeroPath">
        <value condition="Control.HasFocus(110)">$INFO[Container(110).ListItem.FileNameAndPath]</value>
        <value>$INFO[Container(100).ListItem.FileNameAndPath]</value>
    </variable>

    <include name="AsterPageBackground">
        <texture>none</texture>
        <animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
    </include>

    <include name="AsterTitle">
        <font>font40</font>
        <textcolor>asterInk</textcolor>
        <shadowcolor>33000000</shadowcolor>
        <shadowoffset>2</shadowoffset>
    </include>

    <include name="AsterHeroTitle">
        <font>font40</font>
        <textcolor>ffece8df</textcolor>
        <shadowcolor>66000000</shadowcolor>
        <shadowoffset>2</shadowoffset>
    </include>

    <include name="AsterBody">
        <font>font24</font>
        <textcolor>asterInk</textcolor>
    </include>

    <include name="AsterRailButton">
        <width>178</width>
        <height>62</height>
        <font>font24</font>
        <textcolor>asterRailText</textcolor>
        <focusedcolor>asterSage</focusedcolor>
        <align>left</align>
        <aligny>center</aligny>
        <texturefocus>special://skin/media/rail-focus.png</texturefocus>
        <texturenofocus>none</texturenofocus>
    </include>

    <include name="AsterCategoryButton">
        <width>280</width><height>56</height>
        <font>font24</font><align>center</align><aligny>center</aligny>
        <textcolor>asterInk</textcolor><focusedcolor>asterInk</focusedcolor>
        <texturefocus border="20" colordiffuse="asterSage">special://skin/media/ui-panel.png</texturefocus>
        <texturenofocus>special://skin/media/ui-limestone-panel.png</texturenofocus>
    </include>
    <include name="AsterTopCategoryButton">
        <width>248</width><height>56</height>
        <font>font20</font><align>left</align><aligny>center</aligny>
        <textoffsetx>52</textoffsetx>
        <textcolor>asterInk</textcolor><focusedcolor>asterInk</focusedcolor>
        <texturefocus border="20" colordiffuse="asterSage">special://skin/media/ui-panel.png</texturefocus>
        <texturenofocus>special://skin/media/ui-limestone-panel.png</texturenofocus>
        <ondown>120</ondown>
    </include>
    <include name="AsterFilterButton">
        <width>260</width><height>56</height><font>font24</font>
        <align>center</align><aligny>center</aligny>
        <textcolor>asterInk</textcolor><focusedcolor>asterInk</focusedcolor>
        <texturefocus border="20" colordiffuse="asterSage">special://skin/media/ui-panel.png</texturefocus>
        <texturenofocus>special://skin/media/ui-limestone-panel.png</texturenofocus>
    </include>
    <include name="AsterKeyboardActionButton">
        <width>190</width><height>56</height><font>font24</font>
        <align>center</align><aligny>center</aligny>
        <textcolor>asterInk</textcolor><focusedcolor>asterInk</focusedcolor>
        <texturefocus border="20" colordiffuse="asterSage">special://skin/media/ui-panel.png</texturefocus>
        <texturenofocus>special://skin/media/ui-limestone-panel.png</texturenofocus>
    </include>

    <include name="AsterActionButton">
        <height>70</height>
        <font>font28</font>
        <align>center</align>
        <aligny>center</aligny>
        <textcolor>asterInk</textcolor>
        <focusedcolor>asterGreen</focusedcolor>
        <texturefocus>none</texturefocus>
        <texturenofocus>none</texturenofocus>
    </include>

    <include name="AsterHeroActionButton">
        <height>70</height>
        <font>font28</font>
        <align>center</align>
        <aligny>center</aligny>
        <textcolor>ffece8df</textcolor>
        <focusedcolor>ffb9f2d0</focusedcolor>
        <texturefocus>none</texturefocus>
        <texturenofocus>none</texturenofocus>
    </include>
</includes>
