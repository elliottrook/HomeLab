<?xml version="1.0" encoding="UTF-8"?>
<window id="4">
    <defaultcontrol always="true">9000</defaultcontrol>
    <backgroundcolor>asterStone</backgroundcolor>
    <controls>
        <!-- Quiet Aster identity panel: settings stay practical rather than
             borrowing the media-heavy hero treatment. -->
        <control type="image">
            <left>0</left><top>0</top><width>400</width><height>1080</height>
            <texture>special://skin/media/rail-background.png</texture>
        </control>
        <control type="image">
            <left>72</left><top>76</top><width>256</width><height>112</height>
            <texture>special://skin/media/aster-home-horizontal-512.png</texture>
            <aspectratio>keep</aspectratio>
        </control>
        <control type="image">
            <left>72</left><top>232</top><width>88</width><height>88</height>
            <texture>special://skin/media/31-settings-app.png</texture>
            <aspectratio>keep</aspectratio>
        </control>
        <control type="label">
            <left>72</left><top>342</top><width>270</width><height>58</height>
            <label>Settings</label><font>font40</font><textcolor>asterRailText</textcolor>
        </control>
        <control type="textbox">
            <left>72</left><top>416</top><width>270</width><height>104</height>
            <label>Shape the Aster experience and manage Kodi.</label>
            <font>font20</font><textcolor>asterRailText</textcolor>
        </control>
        <control type="label">
            <left>72</left><top>966</top><width>270</width><height>36</height>
            <label>ESC  Back</label><font>font20</font><textcolor>asterSage</textcolor>
        </control>
        <control type="label">
            <left>472</left><top>92</top><width>1190</width><height>62</height>
            <label>Choose a settings area</label><font>font40</font><textcolor>asterInk</textcolor>
        </control>
        <control type="label">
            <left>474</left><top>156</top><width>1280</width><height>36</height>
            <label>System controls, presented in the Aster Home visual language.</label>
            <font>font20</font><textcolor>asterMuted</textcolor>
        </control>
        <control type="panel" id="9000">
            <left>462</left><top>238</top><width>1390</width><height>720</height>
            <orientation>horizontal</orientation><scrolltime>180</scrolltime>
            <itemlayout width="680" height="330">
                <control type="image"><left>10</left><top>10</top><width>650</width><height>290</height><texture border="36">special://skin/media/ui-limestone-panel.png</texture></control>
                <control type="image"><left>44</left><top>54</top><width>68</width><height>68</height><texture>special://skin/media/31-settings-app.png</texture><aspectratio>keep</aspectratio></control>
                <control type="label"><left>44</left><top>150</top><width>570</width><height>50</height><label>$INFO[ListItem.Label]</label><font>font30</font><textcolor>asterInk</textcolor></control>
                <control type="textbox"><left>44</left><top>207</top><width>570</width><height>56</height><label>$INFO[ListItem.Property(Description)]</label><font>font20</font><textcolor>asterMuted</textcolor></control>
            </itemlayout>
            <focusedlayout width="680" height="330">
                <control type="image"><left>10</left><top>10</top><width>650</width><height>290</height><texture border="36" colordiffuse="asterSage">special://skin/media/ui-panel.png</texture></control>
                <control type="image"><left>15</left><top>15</top><width>640</width><height>280</height><texture border="34" colordiffuse="asterPaper">special://skin/media/ui-panel.png</texture></control>
                <control type="image"><left>44</left><top>54</top><width>68</width><height>68</height><texture>special://skin/media/31-settings-app.png</texture><aspectratio>keep</aspectratio></control>
                <control type="label"><left>44</left><top>150</top><width>570</width><height>50</height><label>$INFO[ListItem.Label]</label><font>font30</font><textcolor>asterGreen</textcolor></control>
                <control type="textbox"><left>44</left><top>207</top><width>570</width><height>56</height><label>$INFO[ListItem.Property(Description)]</label><font>font20</font><textcolor>asterMuted</textcolor></control>
            </focusedlayout>
            <content>
                <item><label>Interface</label><property name="Description">Appearance, language and regional preferences</property><onclick>ActivateWindow(InterfaceSettings)</onclick></item>
                <item><label>Player</label><property name="Description">Playback behaviour, video and audio controls</property><onclick>ActivateWindow(PlayerSettings)</onclick></item>
                <item><label>Services</label><property name="Description">Network access, control and connected services</property><onclick>ActivateWindow(ServiceSettings)</onclick></item>
                <item><label>Add-ons</label><property name="Description">Installed extensions and available updates</property><onclick>ActivateWindow(AddonBrowser)</onclick></item>
                <item><label>Remote controls</label><property name="Description">Map remote and keyboard buttons for Aster</property><onclick>RunAddon(script.keymap)</onclick><visible>System.HasAddon(script.keymap)</visible></item>
                <item><label>Backup &amp; restore</label><property name="Description">Protect this Kodi profile before upgrades</property><onclick>RunAddon(script.xbmcbackup)</onclick><visible>System.HasAddon(script.xbmcbackup)</visible></item>
                <item><label>Diagnostics</label><property name="Description">Read the local Kodi log without uploading it</property><onclick>RunAddon(script.logviewer)</onclick><visible>System.HasAddon(script.logviewer)</visible></item>
                <item><label>Lyrics</label><property name="Description">Configure synchronized lyrics for Aster Music</property><onclick>Addon.OpenSettings(script.cu.lrclyrics)</onclick><visible>System.HasAddon(script.cu.lrclyrics)</visible></item>
            </content>
        </control>
        <include content="AsterClockPill"><param name="top" value="34"/><param name="innertop" value="36"/></include>
    </controls>
</window>
