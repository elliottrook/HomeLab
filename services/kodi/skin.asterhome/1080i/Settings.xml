<?xml version="1.0" encoding="UTF-8"?>
<window id="4">
    <defaultcontrol always="true">9000</defaultcontrol>
    <backgroundcolor>asterIvory</backgroundcolor>
    <controls>
        <control type="label">
            <left>100</left>
            <top>70</top>
            <width>1720</width>
            <height>70</height>
            <label>Settings</label>
            <font>font40</font>
            <textcolor>asterInk</textcolor>
        </control>
        <control type="panel" id="9000">
            <left>100</left>
            <top>220</top>
            <width>1720</width>
            <height>600</height>
            <orientation>horizontal</orientation>
            <itemlayout width="320" height="220">
                <control type="label">
                    <width>300</width>
                    <height>180</height>
                    <label>$INFO[ListItem.Label]</label>
                    <font>font28</font>
                    <textcolor>asterInk</textcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                </control>
            </itemlayout>
            <focusedlayout width="320" height="220">
                <control type="label">
                    <width>300</width>
                    <height>180</height>
                    <label>$INFO[ListItem.Label]</label>
                    <font>font28</font>
                    <textcolor>asterGreen</textcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                </control>
            </focusedlayout>
            <content>
                <item><label>Interface</label><onclick>ActivateWindow(InterfaceSettings)</onclick></item>
                <item><label>Player</label><onclick>ActivateWindow(PlayerSettings)</onclick></item>
                <item><label>Services</label><onclick>ActivateWindow(ServiceSettings)</onclick></item>
                <item><label>Add-ons</label><onclick>ActivateWindow(AddonBrowser)</onclick></item>
            </content>
        </control>
    </controls>
</window>
