        <!-- Hidden metadata source. The installed Jellyfin add-on populates
             Kodi's local video library; the presentation stays independent
             of Jellyfin's server URL and credentials. -->
        <control type="panel" id="101">
            <left>0</left>
            <top>0</top>
            <width>1</width>
            <height>1</height>
            <visible>false</visible>
            <orientation>horizontal</orientation>
            <content target="videos">videodb://recentlyaddedmovies/</content>
            <itemlayout width="1" height="1">
                <control type="image">
                    <width>1</width>
                    <height>1</height>
                    <texture>$INFO[ListItem.Art(fanart)]</texture>
                </control>
            </itemlayout>
            <focusedlayout width="1" height="1">
                <control type="image">
                    <width>1</width>
                    <height>1</height>
                    <texture>$INFO[ListItem.Art(fanart)]</texture>
                </control>
            </focusedlayout>
        </control>

        <include content="AsterNavigationRail"><param name="content" value="100" /></include>

        <control type="group" id="21">
            <zorder>2</zorder>
