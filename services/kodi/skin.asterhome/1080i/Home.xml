        <!-- Full-screen artwork with continuous readability and row fades. -->
        <control type="image" id="12">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture background="true">$VAR[AsterHeroFanart]</texture>
            <aspectratio>scale</aspectratio><fadetime>250</fadetime>
        </control>
        <control type="image" id="13">
            <visible>!Control.HasFocus(8999) + !Control.HasFocus(9001) + !Control.HasFocus(9002) + !Control.HasFocus(9003) + !Control.HasFocus(9004) + !Control.HasFocus(9005) + !Control.HasFocus(9007)</visible>
