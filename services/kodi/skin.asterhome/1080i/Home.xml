            <texture>special://skin/media/ui-hero-bottom-fade.png</texture>
            <colordiffuse>asterIvory</colordiffuse>
            <aspectratio>stretch</aspectratio>
        </control>
        <!-- Keep the selected artwork as ambient context behind the open rail.
             The menu overlay dims it; interactive copy and queues still hide. -->
        <control type="image">
            <visible>Control.HasFocus(8999) | Control.HasFocus(9001) | Control.HasFocus(9002) | Control.HasFocus(9003) | Control.HasFocus(9004) | Control.HasFocus(9005) | Control.HasFocus(9007)</visible>
