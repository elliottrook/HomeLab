        <control type="label">
            <left>370</left>
            <top>408</top>
            <width>550</width>
            <height>48</height>
            <label>Continue Watching</label>
            <include>AsterTitle</include>
        </control>
        <control type="label">
            <left>1660</left>
            <top>418</top>
            <width>160</width>
            <height>36</height>
            <label>View all  ›</label>
            <font>font20</font>
            <textcolor>asterGreen</textcolor>
            <align>right</align>
        </control>
        <control type="panel" id="100">
            <left>370</left>
            <top>462</top>
            <width>1450</width>
            <height>260</height>
            <orientation>horizontal</orientation>
            <scrolltime>180</scrolltime>
            <onleft>8999</onleft>
            <itemlayout width="220" height="242">
                <control type="image">
                    <left>14</left>
                    <top>4</top>
                    <width>190</width>
                    <height>216</height>
                    <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
                    <aspectratio>keep</aspectratio>
                </control>
                <control type="label">
                    <left>14</left>
                    <top>222</top>
                    <width>190</width>
                    <height>28</height>
                    <label>$INFO[ListItem.Label]</label>
                    <font>font20</font>
                    <textcolor>asterInk</textcolor>
                    <truncate>true</truncate>
                </control>
            </itemlayout>
            <focusedlayout width="236" height="252">
                <control type="image">
                    <left>10</left>
                    <top>0</top>
                    <width>216</width>
                    <height>236</height>
                    <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
                    <aspectratio>keep</aspectratio>
                    <animation effect="zoom" start="100" end="106" time="140" reversible="true">Focus</animation>
                </control>
                <control type="label">
                    <left>10</left>
                    <top>238</top>
                    <width>216</width>
                    <height>28</height>
                    <label>$INFO[ListItem.Label]</label>
                    <font>font20</font>
                    <textcolor>asterGreen</textcolor>
