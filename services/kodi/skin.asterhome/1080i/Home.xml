<?xml version="1.0" encoding="UTF-8"?>
<window id="0">
    <defaultcontrol always="true">100</defaultcontrol>
    <backgroundcolor>asterIvory</backgroundcolor>
    <controls>
        <!-- Temporary solid surfaces use the window background and text focus
             until repository-owned Aster textures are added. -->
        <control type="image" id="10">
            <left>1060</left>
            <top>24</top>
            <width>780</width>
            <height>438</height>
            <texture background="true">$INFO[Container(110).ListItem.Art(fanart)]</texture>
            <aspectratio>keep</aspectratio>
            <fadetime>250</fadetime>
        </control>
        <control type="image" id="11">
            <left>1060</left>
            <top>24</top>
            <width>780</width>
            <height>438</height>
            <texture colordiffuse="99f2ede4">$INFO[Container(110).ListItem.Art(fanart)]</texture>
            <aspectratio>keep</aspectratio>
        </control>

        <!-- Hidden metadata source. The installed Jellyfin add-on populates
             Kodi's local video library; the presentation stays independent
             of Jellyfin's server URL and credentials. -->
        <control type="panel" id="101">
            <left>0</left>
            <top>0</top>
            <width>1</width>
            <height>1</height>
            <visible>false</visible>
            <orientation>horizontal</orientation>
            <content target="videos">videodb://recentlyaddedmovies/</content>
            <itemlayout width="1" height="1">
                <control type="image">
                    <width>1</width>
                    <height>1</height>
                    <texture>$INFO[ListItem.Art(fanart)]</texture>
                </control>
            </itemlayout>
            <focusedlayout width="1" height="1">
                <control type="image">
                    <width>1</width>
                    <height>1</height>
                    <texture>$INFO[ListItem.Art(fanart)]</texture>
                </control>
            </focusedlayout>
        </control>

        <!-- Collapsed/revealing navigation rail. -->
        <control type="group" id="9000">
            <left>0</left>
            <top>0</top>
            <width>300</width>
            <height>1080</height>
            <visible>Control.HasFocus(8999) | Control.HasFocus(9001) | Control.HasFocus(9002) | Control.HasFocus(9003) | Control.HasFocus(9004) | Control.HasFocus(9005)</visible>
            <animation effect="slide" start="-300,0" end="0,0" time="180" reversible="true">VisibleChange</animation>
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>300</width>
                <height>1080</height>
                <texture>special://skin/media/rail-background.png</texture>
            </control>
            <control type="image">
                <left>40</left>
                <top>30</top>
                <width>56</width>
                <height>56</height>
                <texture>special://skin/media/aster-icon-128.png</texture>
                <aspectratio>keep</aspectratio>
            </control>
            <control type="label">
                <left>96</left>
                <top>48</top>
                <width>190</width>
                <height>50</height>
                <label>Aster Home</label>
                <font>font24</font>
                <textcolor>asterRailText</textcolor>
            </control>
            <control type="button" id="9001">
                <left>36</left>
                <top>180</top>
                <label>⌂   Home Hub</label>
                <onclick>ActivateWindow(Home)</onclick>
                <onleft>8999</onleft>
                <ondown>9002</ondown>
                <onright>100</onright>
                <include>AsterRailButton</include>
            </control>
            <control type="button" id="9002">
                <left>36</left>
                <top>250</top>
                <label>▦   Watch</label>
                <onclick>ActivateWindow(Videos)</onclick>
                <onleft>8999</onleft>
                <onup>9001</onup>
                <ondown>9003</ondown>
                <onright>100</onright>
                <include>AsterRailButton</include>
            </control>
            <control type="button" id="9003">
                <left>36</left>
                <top>320</top>
                <label>◷   Library</label>
                <onclick>ActivateWindow(Videos)</onclick>
                <onleft>8999</onleft>
                <onup>9002</onup>
                <ondown>9004</ondown>
                <onright>100</onright>
                <include>AsterRailButton</include>
            </control>
            <control type="button" id="9004">
                <left>36</left>
                <top>390</top>
                <label>⌕   Search</label>
                <onclick>ActivateWindow(Search)</onclick>
                <onleft>8999</onleft>
                <onup>9003</onup>
                <ondown>9005</ondown>
                <onright>100</onright>
                <include>AsterRailButton</include>
            </control>
            <control type="button" id="9005">
                <left>36</left>
                <top>460</top>
                <label>⚙   Settings</label>
                <onclick>ActivateWindow(Settings)</onclick>
                <onleft>8999</onleft>
                <onup>9004</onup>
                <onright>100</onright>
                <include>AsterRailButton</include>
            </control>
        </control>

        <!-- A visible 64 px collapsed rail makes the menu discoverable and
             gives remote/keyboard focus a stable target. -->
        <control type="image" id="8998">
            <visible>!Control.HasFocus(8999) + !Control.HasFocus(9001) + !Control.HasFocus(9002) + !Control.HasFocus(9003) + !Control.HasFocus(9004) + !Control.HasFocus(9005)</visible>
            <left>0</left>
            <top>0</top>
            <width>64</width>
            <height>1080</height>
            <texture>special://skin/media/rail-background.png</texture>
        </control>
        <control type="image" id="8997">
            <visible>!Control.HasFocus(8999) + !Control.HasFocus(9001) + !Control.HasFocus(9002) + !Control.HasFocus(9003) + !Control.HasFocus(9004) + !Control.HasFocus(9005)</visible>
            <left>12</left>
            <top>38</top>
            <width>40</width>
            <height>40</height>
            <texture>special://skin/media/aster-icon-128.png</texture>
            <aspectratio>keep</aspectratio>
        </control>
        <control type="button" id="8999">
            <visible>!Control.HasFocus(9001) + !Control.HasFocus(9002) + !Control.HasFocus(9003) + !Control.HasFocus(9004) + !Control.HasFocus(9005)</visible>
            <left>0</left>
            <top>470</top>
            <width>64</width>
            <height>130</height>
            <label>›</label>
            <font>font40</font>
            <textcolor>asterRailText</textcolor>
            <focusedcolor>asterSage</focusedcolor>
            <onright>9001</onright>
            <texturefocus>none</texturefocus>
            <texturenofocus>none</texturenofocus>
            <align>center</align>
            <aligny>center</aligny>
        </control>

        <!-- Brand header -->
        <control type="image">
            <left>360</left>
            <top>30</top>
            <width>64</width>
            <height>64</height>
            <texture>special://skin/media/aster-icon-128.png</texture>
            <aspectratio>keep</aspectratio>
        </control>
        <control type="label">
            <left>438</left>
            <top>42</top>
            <width>350</width>
            <height>52</height>
            <label>Aster Home</label>
            <font>font30</font>
            <textcolor>asterInk</textcolor>
        </control>
        <control type="label">
            <left>1600</left>
            <top>52</top>
            <width>220</width>
            <height>40</height>
            <label>7:24 PM   ●</label>
            <font>font20</font>
            <textcolor>asterMuted</textcolor>
            <align>right</align>
        </control>

        <!-- Hero copy -->
        <control type="label">
            <left>370</left>
            <top>102</top>
            <width>500</width>
            <height>42</height>
            <label>FEATURED FOR YOU</label>
            <font>font24</font>
            <textcolor>asterMuted</textcolor>
        </control>
        <control type="label">
            <left>370</left>
            <top>140</top>
            <width>650</width>
            <height>90</height>
            <label fallback="Northern Light">$INFO[Container(101).ListItem.Label]</label>
            <include>AsterTitle</include>
        </control>
        <control type="label">
            <left>370</left>
            <top>224</top>
            <width>650</width>
            <height>72</height>
            <label fallback="A journey through wild places where light, land and life exist in perfect balance.">$INFO[Container(101).ListItem.Plot]</label>
            <font>font24</font>
            <textcolor>asterInk</textcolor>
            <autoscroll time="6000" delay="3000" repeat="5000" />
        </control>
        <control type="label">
            <left>370</left>
            <top>302</top>
            <width>650</width>
            <height>36</height>
            <label fallback="2024   |   52 min   |   4K   |   Documentary">$INFO[Container(101).ListItem.Year]   |   $INFO[Container(101).ListItem.Duration(hh:mm)]</label>
            <font>font20</font>
            <textcolor>asterGreen</textcolor>
        </control>
        <control type="button" id="120">
            <left>370</left>
            <top>342</top>
            <width>230</width>
            <label>▶  Play</label>
            <onclick>PlayMedia($INFO[Container(101).ListItem.FileNameAndPath])</onclick>
            <onleft>8999</onleft>
            <onright>121</onright>
            <include>AsterActionButton</include>
        </control>
        <control type="button" id="121">
            <left>620</left>
            <top>342</top>
            <width>230</width>
            <label>ⓘ  More Info</label>
            <onclick>Info</onclick>
            <onleft>120</onleft>
            <onright>100</onright>
            <include>AsterActionButton</include>
