<?xml version="1.0" encoding="UTF-8"?>
<window id="0">
    <defaultcontrol always="true">100</defaultcontrol>
    <backgroundcolor>asterIvory</backgroundcolor>
    <controls>
        <!-- Temporary solid surfaces use the window background and text focus
             until repository-owned Aster textures are added. -->
        <control type="image" id="10">
            <left>320</left>
            <top>24</top>
            <width>1560</width>
            <height>420</height>
            <texture background="true">$INFO[Container(110).ListItem.Art(fanart)]</texture>
            <aspectratio>scale</aspectratio>
            <fadetime>250</fadetime>
        </control>
        <control type="image" id="11">
            <left>320</left>
            <top>24</top>
            <width>1560</width>
            <height>420</height>
            <texture colordiffuse="99f2ede4">$INFO[Container(110).ListItem.Art(fanart)]</texture>
            <aspectratio>scale</aspectratio>
        </control>

        <!-- Hidden metadata source. The installed Jellyfin add-on populates
             Kodi's local video library; the presentation stays independent
             of Jellyfin's server URL and credentials. -->
        <control type="panel" id="101">
            <left>0</left>
            <top>0</top>
            <width>1</width>
            <height>1</height>
            <visible>false</visible>
            <orientation>horizontal</orientation>
            <content target="videos">videodb://recentlyaddedmovies/</content>
            <itemlayout width="1" height="1">
                <control type="image">
                    <width>1</width>
                    <height>1</height>
                    <texture>$INFO[ListItem.Art(fanart)]</texture>
                </control>
            </itemlayout>
            <focusedlayout width="1" height="1">
                <control type="image">
                    <width>1</width>
                    <height>1</height>
                    <texture>$INFO[ListItem.Art(fanart)]</texture>
                </control>
            </focusedlayout>
        </control>

        <!-- Collapsed/revealing navigation rail. The rail is intentionally
             text-first until the final Aster icon set is available. -->
        <control type="group" id="9000">
            <left>-300</left>
            <top>0</top>
            <width>300</width>
            <height>1080</height>
            <animation effect="slide" start="0,0" end="300,0" time="180" reversible="true" condition="Control.HasFocus(8999) | Control.HasFocus(9001) | Control.HasFocus(9002) | Control.HasFocus(9003) | Control.HasFocus(9004) | Control.HasFocus(9005)">Conditional</animation>
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>300</width>
                <height>1080</height>
                <texture>none</texture>
            </control>
            <control type="label">
                <left>46</left>
                <top>48</top>
                <width>220</width>
                <height>50</height>
                <label>✦  Aster Home</label>
                <font>font30</font>
                <textcolor>asterRailText</textcolor>
            </control>
            <control type="button" id="9001">
                <left>36</left>
                <top>180</top>
                <label>⌂   Home Hub</label>
                <onclick>ActivateWindow(Home)</onclick>
                <onright>100</onright>
                <include>AsterRailButton</include>
            </control>
            <control type="button" id="9002">
                <left>36</left>
                <top>250</top>
                <label>▦   Watch</label>
                <onclick>ActivateWindow(Videos)</onclick>
                <onright>100</onright>
                <include>AsterRailButton</include>
            </control>
            <control type="button" id="9003">
                <left>36</left>
                <top>320</top>
                <label>◷   Library</label>
                <onclick>ActivateWindow(Videos)</onclick>
                <onright>100</onright>
                <include>AsterRailButton</include>
            </control>
            <control type="button" id="9004">
                <left>36</left>
                <top>390</top>
                <label>⌕   Search</label>
                <onclick>ActivateWindow(Search)</onclick>
                <onright>100</onright>
                <include>AsterRailButton</include>
            </control>
            <control type="button" id="9005">
                <left>36</left>
                <top>460</top>
                <label>⚙   Settings</label>
                <onclick>ActivateWindow(Settings)</onclick>
                <onright>100</onright>
                <include>AsterRailButton</include>
            </control>
        </control>

        <control type="button" id="8999">
            <left>0</left>
            <top>470</top>
            <width>38</width>
            <height>130</height>
            <label></label>
            <onright>9001</onright>
            <texturefocus>none</texturefocus>
            <texturenofocus>none</texturenofocus>
        </control>

        <!-- Brand header -->
        <control type="label">
            <left>360</left>
            <top>42</top>
            <width>430</width>
            <height>52</height>
            <label>ASTER HOME</label>
            <font>font30</font>
            <textcolor>asterInk</textcolor>
        </control>
        <control type="label">
            <left>1600</left>
            <top>52</top>
            <width>220</width>
            <height>40</height>
            <label>7:24 PM   ●</label>
            <font>font20</font>
            <textcolor>asterMuted</textcolor>
            <align>right</align>
        </control>

        <!-- Hero copy -->
        <control type="label">
            <left>370</left>
            <top>112</top>
            <width>500</width>
            <height>42</height>
            <label>$LOCALIZE[30001]</label>
            <font>font24</font>
            <textcolor>asterMuted</textcolor>
        </control>
        <control type="label">
            <left>370</left>
            <top>155</top>
            <width>760</width>
            <height>90</height>
            <label fallback="Northern Light">$INFO[Container(101).ListItem.Label]</label>
            <include>AsterTitle</include>
        </control>
        <control type="label">
            <left>370</left>
            <top>252</top>
            <width>580</width>
            <height>72</height>
            <label fallback="A journey through wild places where light, land and life exist in perfect balance.">$INFO[Container(101).ListItem.Plot]</label>
            <font>font24</font>
            <textcolor>asterInk</textcolor>
            <autoscroll time="6000" delay="3000" repeat="5000" />
        </control>
        <control type="label">
            <left>370</left>
            <top>330</top>
            <width>650</width>
            <height>36</height>
            <label fallback="2024   |   52 min   |   4K   |   Documentary">$INFO[Container(101).ListItem.Year]   |   $INFO[Container(101).ListItem.Duration(hh:mm)]</label>
            <font>font20</font>
            <textcolor>asterGreen</textcolor>
        </control>
        <control type="button" id="120">
            <left>370</left>
            <top>380</top>
            <width>230</width>
            <label>▶  $LOCALIZE[30004]</label>
            <onclick>PlayMedia($INFO[Container(101).ListItem.FileNameAndPath])</onclick>
            <onleft>8999</onleft>
            <onright>121</onright>
            <include>AsterActionButton</include>
        </control>
        <control type="button" id="121">
            <left>620</left>
            <top>380</top>
            <width>230</width>
            <label>ⓘ  $LOCALIZE[30005]</label>
            <onclick>Info</onclick>
            <onleft>120</onleft>
            <onright>100</onright>
            <include>AsterActionButton</include>
        </control>

        <control type="label">
            <left>370</left>
            <top>490</top>
            <width>550</width>
            <height>48</height>
            <label>$LOCALIZE[30002]</label>
            <include>AsterTitle</include>
        </control>
        <control type="label">
            <left>1660</left>
            <top>500</top>
            <width>160</width>
            <height>36</height>
            <label>$LOCALIZE[30011]  ›</label>
            <font>font20</font>
            <textcolor>asterGreen</textcolor>
            <align>right</align>
        </control>
        <control type="panel" id="100">
            <left>370</left>
            <top>550</top>
            <width>1450</width>
            <height>220</height>
            <orientation>horizontal</orientation>
            <scrolltime>180</scrolltime>
            <onleft>8999</onleft>
            <itemlayout width="268" height="210">
                <control type="image">
                    <left>4</left>
                    <top>4</top>
                    <width>252</width>
                    <height>180</height>
                    <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
                    <aspectratio>scale</aspectratio>
                </control>
                <control type="label">
                    <left>10</left>
                    <top>185</top>
                    <width>242</width>
                    <height>28</height>
                    <label>$INFO[ListItem.Label]</label>
                    <font>font20</font>
                    <textcolor>asterInk</textcolor>
                    <truncate>true</truncate>
                </control>
            </itemlayout>
            <focusedlayout width="284" height="220">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>276</width>
                    <height>198</height>
                    <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
                    <aspectratio>scale</aspectratio>
                    <animation effect="zoom" start="100" end="106" time="140" reversible="true">Focus</animation>
                </control>
                <control type="label">
                    <left>8</left>
                    <top>196</top>
                    <width>260</width>
                    <height>28</height>
                    <label>$INFO[ListItem.Label]</label>
                    <font>font20</font>
                    <textcolor>asterGreen</textcolor>
                    <truncate>true</truncate>
                </control>
            </focusedlayout>
            <content target="videos">videodb://inprogresstvshows/</content>
        </control>

        <control type="label">
            <left>370</left>
            <top>820</top>
            <width>650</width>
            <height>48</height>
            <label>$LOCALIZE[30003]</label>
            <include>AsterTitle</include>
        </control>
        <control type="panel" id="110">
            <left>370</left>
            <top>880</top>
            <width>1450</width>
            <height>170</height>
            <orientation>horizontal</orientation>
            <scrolltime>180</scrolltime>
            <onleft>8999</onleft>
            <itemlayout width="268" height="165">
                <control type="image">
                    <left>4</left>
                    <top>4</top>
                    <width>252</width>
                    <height>156</height>
                    <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
                    <aspectratio>scale</aspectratio>
                </control>
            </itemlayout>
            <focusedlayout width="284" height="170">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>276</width>
                    <height>164</height>
                    <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
                    <aspectratio>scale</aspectratio>
                    <animation effect="zoom" start="100" end="106" time="140" reversible="true">Focus</animation>
                </control>
            </focusedlayout>
            <content target="videos">videodb://recentlyaddedmovies/</content>
        </control>
    </controls>
</window>
