            <include>AsterTitle</include>
        </control>
        <control type="panel" id="110">
            <left>370</left>
            <top>776</top>
            <width>1450</width>
            <height>244</height>
            <orientation>horizontal</orientation>
            <scrolltime>180</scrolltime>
            <onleft>8999</onleft>
            <itemlayout width="220" height="230">
                <control type="image">
                    <left>14</left>
                    <top>4</top>
                    <width>190</width>
                    <height>216</height>
                    <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
