        <control type="button" id="112"><left>1098</left><top>28</top><label>Podcasts</label><include>AsterMusicPillButton</include><onclick>ActivateWindow(1120)</onclick><onleft>111</onleft><onright>500</onright><ondown>500</ondown></control>
        <control type="image"><left>$PARAM[activeleft]</left><top>86</top><width>280</width><height>4</height><texture>special://skin/media/ui-solid.png</texture><colordiffuse>asterGreen</colordiffuse><visible>$PARAM[activevisible]</visible></control>
        <control type="image"><left>500</left><top>38</top><width>36</width><height>36</height><texture>special://skin/media/21-books-app.png</texture><aspectratio>keep</aspectratio></control>
        <control type="image"><left>804</left><top>38</top><width>36</width><height>36</height><texture>special://skin/media/12-audiobooks.png</texture><aspectratio>keep</aspectratio></control>
        <control type="image"><left>1108</left><top>38</top><width>36</width><height>36</height><texture>special://skin/media/22-podcasts-app.png</texture><aspectratio>keep</aspectratio></control>
        <control type="image"><left>1750</left><top>32</top><width>146</width><height>44</height><texture border="20">special://skin/media/ui-panel.png</texture><colordiffuse>e029302b</colordiffuse></control>
