<?xml version="1.0" encoding="UTF-8"?>
<includes>
  <variable name="AsterBooksHeroTitle">
    <value condition="Control.HasFocus(501) + !String.IsEmpty(Container(501).ListItem.Label)">$INFO[Container(501).ListItem.Label]</value>
    <value condition="Control.HasFocus(503) + !String.IsEmpty(Container(503).ListItem.Label)">$INFO[Container(503).ListItem.Label]</value>
    <value condition="!String.IsEmpty(Container(502).ListItem.Label)">$INFO[Container(502).ListItem.Label]</value>
    <value condition="!String.IsEmpty(Container(500).ListItem.Label)">$INFO[Container(500).ListItem.Label]</value>
    <value condition="!String.IsEmpty(Window.Property(AsterBooks.Search)) + String.IsEmpty(Container(500).ListItem.Label)">No matching titles</value>
    <value>Choose your next chapter</value>
  </variable>
  <variable name="AsterBooksHeroDetail">
    <value condition="Control.HasFocus(501) + !String.IsEmpty(Container(501).ListItem.Label)">$INFO[Container(501).ListItem.Label2]</value>
    <value condition="Control.HasFocus(503) + !String.IsEmpty(Container(503).ListItem.Label)">$INFO[Container(503).ListItem.Label2]</value>
    <value condition="!String.IsEmpty(Container(502).ListItem.Label)">$INFO[Container(502).ListItem.Label2]</value>
    <value condition="!String.IsEmpty(Container(500).ListItem.Label)">$INFO[Container(500).ListItem.Label2]</value>
    <value condition="!String.IsEmpty(Window.Property(AsterBooks.Search)) + String.IsEmpty(Container(500).ListItem.Label)">Try a different title search.</value>
    <value condition="Window.IsActive(1118)">The eBook catalogue is not connected yet.</value>
    <value condition="Window.IsActive(1120)">The podcast catalogue is not connected yet.</value>
    <value>Discover eBooks, audiobooks and podcasts here.</value>
  </variable>
  <include name="AsterBooksTile">
    <control type="image"><left>10</left><top>4</top><width>260</width><height>260</height><texture border="28">special://skin/media/ui-panel.png</texture><colordiffuse>asterIvory</colordiffuse></control>
    <control type="image"><left>76</left><top>70</top><width>128</width><height>128</height><texture>$INFO[ListItem.Art(thumb)]</texture><aspectratio>keep</aspectratio></control>
    <control type="label"><left>10</left><top>274</top><width>260</width><height>32</height><label>$INFO[ListItem.Label]</label><font>font20</font><textcolor>asterInk</textcolor></control>
    <control type="label"><left>10</left><top>307</top><width>260</width><height>26</height><label>$INFO[ListItem.Label2]</label><font>font16</font><textcolor>asterMuted</textcolor></control>
  </include>
  <include name="AsterBooksSmallTile">
    <control type="image"><left>4</left><top>2</top><width>90</width><height>90</height><texture border="20">special://skin/media/ui-panel.png</texture><colordiffuse>asterIvory</colordiffuse></control>
    <control type="image"><left>20</left><top>18</top><width>58</width><height>58</height><texture>$INFO[ListItem.Art(thumb)]</texture><aspectratio>keep</aspectratio></control>
