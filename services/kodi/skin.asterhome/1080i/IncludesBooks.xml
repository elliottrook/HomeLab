        <control type="textbox"><left>1050</left><top>214</top><width>760</width><height>110</height><label>$VAR[AsterBooksHeroTitle]</label><font>font30</font><textcolor>asterRailText</textcolor></control>
        <control type="textbox"><left>1050</left><top>330</top><width>710</width><height>70</height><label>$VAR[AsterBooksHeroDetail]</label><font>font24</font><textcolor>asterRailText</textcolor></control>
        <control type="label"><left>1050</left><top>406</top><width>760</width><height>34</height><label>$INFO[Window.Property(AsterBooks.Status)]</label><font>font20</font><textcolor>asterSage</textcolor></control>
