    <param name="heading" />
    <param name="homevisible" default="false" />
    <param name="browsevisible" default="true" />
    <param name="activeleft" default="410" />
    <param name="activevisible" default="true" />
    <param name="icon" default="special://skin/media/21-books-app.png" />
    <definition>
      <control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture>special://skin/media/ui-solid.png</texture><colordiffuse>asterCharcoal</colordiffuse></control>
      <control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture>special://skin/media/ui-hero-bottom-fade.png</texture><colordiffuse>asterStone</colordiffuse><aspectratio>stretch</aspectratio></control>
      <include content="AsterNavigationRail"><param name="content" value="500" /></include>
      <control type="group">
        <visible>!Control.HasFocus(8999) + !Control.HasFocus(9001) + !Control.HasFocus(9002) + !Control.HasFocus(9003) + !Control.HasFocus(9004) + !Control.HasFocus(9005) + !Control.HasFocus(9007)</visible>
        <control type="image"><left>145</left><top>0</top><width>170</width><height>115</height><texture>special://skin/media/28-aster-books-logo.png</texture><aspectratio>keep</aspectratio></control>
