          <control type="label"><left>145</left><top>700</top><width>900</width><height>42</height><label>Audiobooks · catalogue snapshot</label><font>font28</font><textcolor>asterInk</textcolor></control>
          <control type="label"><left>145</left><top>745</top><width>1100</width><height>35</height><label>No audiobook titles in the current feed</label><font>font20</font><textcolor>asterMuted</textcolor><visible>String.IsEqual(Window.Property(AsterBooks.Count.audiobook),0)</visible></control>
          <control type="label"><left>145</left><top>880</top><width>900</width><height>42</height><label>Podcasts</label><font>font28</font><textcolor>asterInk</textcolor></control>
          <control type="label"><left>145</left><top>925</top><width>1100</width><height>35</height><label>Podcast catalogue not connected</label><font>font20</font><textcolor>asterMuted</textcolor><visible>String.IsEqual(Window.Property(AsterBooks.Count.podcast),0)</visible></control>
          <include content="AsterBooksHomeRow"><param name="id" value="501" /><param name="top" value="560" /><param name="up" value="300" /><param name="down" value="502" /></include>
          <include content="AsterBooksHomeRow"><param name="id" value="502" /><param name="top" value="740" /><param name="up" value="501" /><param name="down" value="503" /></include>
          <include content="AsterBooksHomeRow"><param name="id" value="503" /><param name="top" value="920" /><param name="up" value="502" /><param name="down" value="112" /></include>
        </control>
        <control type="group">
          <visible>$PARAM[browsevisible]</visible>
          <control type="label"><left>145</left><top>555</top><width>1050</width><height>48</height><label>$PARAM[heading]</label><font>font30</font><textcolor>asterInk</textcolor></control>
          <control type="image"><left>1540</left><top>615</top><width>300</width><height>420</height><texture border="20">special://skin/media/ui-panel.png</texture><colordiffuse>e6f2ede4</colordiffuse></control>
          <control type="image"><left>1550</left><top>625</top><width>280</width><height>56</height><texture>special://skin/media/ui-limestone-panel.png</texture></control>
          <control type="label"><left>1560</left><top>636</top><width>260</width><height>40</height><label>Search &amp; filter</label><font>font24</font><textcolor>asterInk</textcolor></control>
          <control type="button" id="301"><left>1560</left><top>708</top><label>$INFO[Window.Property(AsterBooks.SearchLabel)]</label><include>AsterFilterButton</include><onclick>RunScript(special://skin/tools/books_data.py,$PARAM[page],search)</onclick><onleft>500</onleft><onright>8999</onright><onup>300</onup><ondown>302</ondown></control>
          <control type="button" id="302"><left>1560</left><top>780</top><label>Clear search</label><include>AsterFilterButton</include><onclick>RunScript(special://skin/tools/books_data.py,$PARAM[page],clear)</onclick><onleft>500</onleft><onright>8999</onright><onup>301</onup><ondown>500</ondown></control>
          <control type="label"><left>1560</left><top>880</top><width>260</width><height>100</height><label>Searches the current[CR]sanitized catalogue</label><font>font20</font><textcolor>asterMuted</textcolor></control>
          <control type="panel" id="500"><left>145</left><top>615</top><width>1370</width><height>430</height><viewtype label="Book tiles">icon</viewtype><orientation>vertical</orientation><scrolltime>180</scrolltime><preloaditems>2</preloaditems><onleft>8999</onleft><onright>301</onright><onup>300</onup><onclick>RunScript(special://skin/tools/books_data.py,$PARAM[page],open)</onclick>
            <itemlayout width="300" height="345"><include>AsterBooksTile</include></itemlayout>
            <focusedlayout width="300" height="345"><include>AsterBooksTile</include><control type="image"><left>10</left><top>4</top><width>260</width><height>260</height><texture>special://skin/media/ui-album-ring.png</texture><colordiffuse>asterGreen</colordiffuse></control></focusedlayout>
          </control>
          <control type="label"><left>145</left><top>680</top><width>1200</width><height>80</height><label>No titles connected in this section</label><font>font24</font><textcolor>asterMuted</textcolor><visible>String.IsEmpty(Container(500).ListItem.Label) + String.IsEmpty(Window.Property(AsterBooks.Search))</visible></control>
          <control type="label"><left>145</left><top>680</top><width>1200</width><height>80</height><label>No titles match this search</label><font>font24</font><textcolor>asterMuted</textcolor><visible>String.IsEmpty(Container(500).ListItem.Label) + !String.IsEmpty(Window.Property(AsterBooks.Search))</visible></control>
        </control>
      </control>
    </definition>
  </include>
  <include name="AsterBooksHomeRow">
    <control type="panel" id="$PARAM[id]"><left>145</left><top>$PARAM[top]</top><width>1650</width><height>125</height><viewtype label="Books row">icon</viewtype><orientation>horizontal</orientation><scrolltime>180</scrolltime><preloaditems>2</preloaditems><onleft>8999</onleft><onright>300</onright><onup>$PARAM[up]</onup><ondown>$PARAM[down]</ondown><onclick>RunScript(special://skin/tools/books_data.py,home,open)</onclick>
      <itemlayout width="220" height="125"><include>AsterBooksSmallTile</include></itemlayout>
      <focusedlayout width="220" height="125"><include>AsterBooksSmallTile</include><control type="image"><left>4</left><top>2</top><width>90</width><height>90</height><texture>special://skin/media/ui-album-ring.png</texture><colordiffuse>asterGreen</colordiffuse></control></focusedlayout>
    </control>
  </include>
</includes>
