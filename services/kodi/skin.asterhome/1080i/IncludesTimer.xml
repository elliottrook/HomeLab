<includes>
  <!-- Sixty circular dots: one per second. The ring itself defines the dial;
       sage dots deplete as AsterHub.HomeTimerSecond moves from 60 to 0. -->
  <include name="AsterTimerDot">
    <param name="left" />
    <param name="top" />
    <param name="threshold" />
    <definition>
      <control type="image">
        <left>$PARAM[left]</left><top>$PARAM[top]</top><width>21</width><height>21</height>
        <texture>special://skin/media/ui-timer-dot.png</texture>
        <colordiffuse>7aD7D2C8</colordiffuse>
      </control>
      <control type="image">
        <left>$PARAM[left]</left><top>$PARAM[top]</top><width>21</width><height>21</height>
        <texture>special://skin/media/ui-timer-dot.png</texture>
        <colordiffuse>asterSage</colordiffuse>
        <visible>String.IsEqual(Window.Property(AsterHub.HomeTimerActive),true) + Integer.IsGreater(Window.Property(AsterHub.HomeTimerSecond),$PARAM[threshold])</visible>
      </control>
    </definition>
  </include>
