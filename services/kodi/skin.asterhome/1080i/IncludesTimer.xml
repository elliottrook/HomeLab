<includes>
  <!-- Sixty radial pills: one per second. The ring itself defines the dial;
       sage pills deplete as AsterHub.HomeTimerSecond moves from 60 to 0. -->
  <include name="AsterTimerPill">
    <param name="left" />
    <param name="top" />
    <param name="angle" />
    <param name="threshold" />
    <definition>
      <control type="image">
        <left>$PARAM[left]</left><top>$PARAM[top]</top><width>10</width><height>28</height>
        <texture border="5">special://skin/media/ui-progress.png</texture>
        <colordiffuse>7aD7D2C8</colordiffuse><angle>$PARAM[angle]</angle>
      </control>
      <control type="image">
        <left>$PARAM[left]</left><top>$PARAM[top]</top><width>10</width><height>28</height>
        <texture border="5">special://skin/media/ui-progress.png</texture>
        <colordiffuse>asterSage</colordiffuse><angle>$PARAM[angle]</angle>
        <visible>String.IsEqual(Window.Property(AsterHub.HomeTimerActive),true) + Integer.IsGreater(Window.Property(AsterHub.HomeTimerSecond),$PARAM[threshold])</visible>
      </control>
    </definition>
  </include>
