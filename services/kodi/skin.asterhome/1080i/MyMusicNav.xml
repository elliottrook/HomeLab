    <control type="button" id="9104"><left>676</left><top>890</top><width>150</width><height>64</height><label>Stop</label><font>font20</font><align>center</align><aligny>center</aligny><textcolor>asterInk</textcolor><texturefocus border="20" colordiffuse="asterSage">special://skin/media/ui-panel.png</texturefocus><texturenofocus border="20">special://skin/media/ui-limestone-panel.png</texturenofocus><onclick>PlayerControl(Stop)</onclick><onleft>9103</onleft><onright>50</onright><onup>9000</onup><ondown>50</ondown><visible>Player.HasAudio</visible></control>

    <control type="label"><left>970</left><top>224</top><width>790</width><height>65</height><label>Chapters &amp; episodes</label><font>font40</font><textcolor>asterInk</textcolor></control>
