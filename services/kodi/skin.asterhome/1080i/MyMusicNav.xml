<?xml version="1.0" encoding="UTF-8"?>
<window>
  <defaultcontrol always="true">50</defaultcontrol>
  <views>50</views>
  <backgroundcolor>asterCharcoal</backgroundcolor>
  <controls>
    <control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture>special://skin/media/ui-solid.png</texture><colordiffuse>asterStone</colordiffuse></control>
    <control type="image"><left>0</left><top>0</top><width>1920</width><height>180</height><texture>special://skin/media/ui-solid.png</texture><colordiffuse>asterCharcoal</colordiffuse></control>
    <control type="image"><left>80</left><top>30</top><width>160</width><height>140</height><texture>special://skin/media/28-aster-books-logo.png</texture><aspectratio>keep</aspectratio></control>
    <control type="label"><left>270</left><top>58</top><width>1060</width><height>70</height><label>Aster Books  /  Listening</label><font>font40</font><textcolor>asterRailText</textcolor></control>
    <control type="button" id="9000"><left>1540</left><top>62</top><width>240</width><label>Back to Books</label><include>AsterPlayerBackControl</include><onclick>Action(Back)</onclick><ondown>50</ondown></control>

    <!-- A soft edge gradient preserves contrast without enclosing the player. -->
    <control type="image"><left>0</left><top>180</top><width>1920</width><height>900</height><texture>special://skin/media/ui-hero-left-fade.png</texture><colordiffuse>d9292721</colordiffuse><aspectratio>stretch</aspectratio></control>
    <control type="image"><left>290</left><top>252</top><width>400</width><height>400</height><texture>special://skin/media/28-aster-books-logo.png</texture><aspectratio>keep</aspectratio><visible>String.IsEmpty(Container(50).ListItem.Property(AsterBooks.ParentTitle))</visible></control>
    <control type="image"><left>290</left><top>252</top><width>400</width><height>400</height><texture background="true" diffuse="special://skin/media/ui-album-mask.png">$INFO[Container(50).ListItem.Art(thumb)]</texture><aspectratio scalediffuse="false">scale</aspectratio></control>
    <control type="label"><left>150</left><top>660</top><width>680</width><height>32</height><label>$INFO[Container(50).ListItem.Property(AsterBooks.Kind)]  /  LISTENING</label><font>font20</font><textcolor>asterGold</textcolor></control>
    <control type="label"><left>150</left><top>696</top><width>680</width><height>52</height><label>$INFO[Container(50).ListItem.Property(AsterBooks.ParentTitle)]</label><font>font28</font><textcolor>asterInk</textcolor><truncate>true</truncate></control>
    <control type="label"><left>150</left><top>696</top><width>680</width><height>52</height><label>Choose what to listen to</label><font>font28</font><textcolor>asterRailText</textcolor><visible>String.IsEmpty(Container(50).ListItem.Property(AsterBooks.ParentTitle))</visible></control>
    <control type="label"><left>150</left><top>750</top><width>680</width><height>38</height><label>$INFO[Container(50).ListItem.Property(AsterBooks.EntryTitle)]</label><font>font20</font><textcolor>asterSage</textcolor><truncate>true</truncate></control>
    <control type="label"><left>150</left><top>796</top><width>145</width><height>30</height><label>$INFO[Player.Time(hh:mm:ss)]</label><font>font20</font><textcolor>asterRailText</textcolor><visible>Player.HasAudio</visible></control>
    <control type="label"><left>680</left><top>796</top><width>150</width><height>30</height><label>$INFO[Player.Duration(hh:mm:ss)]</label><font>font20</font><align>right</align><textcolor>asterRailText</textcolor><visible>Player.HasAudio</visible></control>
    <control type="progress"><left>150</left><top>834</top><width>680</width><height>10</height><texturebg border="4" colordiffuse="asterMuted">special://skin/media/ui-progress.png</texturebg><midtexture border="4" colordiffuse="asterSage">special://skin/media/ui-progress.png</midtexture><lefttexture></lefttexture><righttexture></righttexture><overlaytexture></overlaytexture><info>Player.Progress</info><visible>Player.HasAudio</visible></control>
    <control type="label"><left>150</left><top>805</top><width>680</width><height>32</height><label>Select a chapter or episode to begin</label><font>font20</font><textcolor>asterMuted</textcolor><visible>!Player.HasAudio</visible></control>

    <control type="button" id="9101"><left>150</left><top>895</top><width>150</width><label>−30</label><include>AsterPlayerControlLight</include><onclick>Seek(-30)</onclick><onleft>50</onleft><onright>9102</onright><onup>9000</onup><ondown>50</ondown><visible>Player.HasAudio + Player.SeekEnabled</visible></control>
    <control type="button" id="9102"><left>322</left><top>890</top><width>160</width><label>Pause</label><include>AsterPlayerPrimaryControlLight</include><onclick>PlayerControl(Play)</onclick><onleft>9101</onleft><onright>9103</onright><onup>9000</onup><ondown>50</ondown><visible>Player.HasAudio + !Player.Paused</visible></control>
    <control type="button" id="9105"><left>322</left><top>890</top><width>160</width><label>Play</label><include>AsterPlayerPrimaryControlLight</include><onclick>PlayerControl(Play)</onclick><onleft>9101</onleft><onright>9103</onright><onup>9000</onup><ondown>50</ondown><visible>Player.HasAudio + Player.Paused</visible></control>
    <control type="button" id="9103"><left>504</left><top>895</top><width>150</width><label>+30</label><include>AsterPlayerControlLight</include><onclick>Seek(30)</onclick><onleft>9102</onleft><onright>9104</onright><onup>9000</onup><ondown>50</ondown><visible>Player.HasAudio + Player.SeekEnabled</visible></control>
    <control type="button" id="9104"><left>676</left><top>895</top><width>150</width><label>Stop</label><include>AsterPlayerControlLight</include><onclick>PlayerControl(Stop)</onclick><onleft>9103</onleft><onright>50</onright><onup>9000</onup><ondown>50</ondown><visible>Player.HasAudio</visible></control>

    <control type="label"><left>970</left><top>224</top><width>790</width><height>65</height><label>Chapters &amp; episodes</label><font>font40</font><textcolor>asterInk</textcolor></control>
    <control type="label"><left>970</left><top>286</top><width>790</width><height>38</height><label>Select to play · scroll for more</label><font>font20</font><textcolor>asterMuted</textcolor></control>
    <control type="image"><left>970</left><top>330</top><width>850</width><height>2</height><texture>special://skin/media/ui-solid.png</texture><colordiffuse>asterMuted</colordiffuse></control>
    <control type="list" id="50">
      <left>970</left><top>344</top><width>850</width><height>648</height>
      <viewtype label="Audio titles">list</viewtype><orientation>vertical</orientation><scrolltime>150</scrolltime>
      <onup>9000</onup><onleft>9102</onleft><onright>9000</onright>
      <itemlayout height="54" width="850">
        <control type="label"><left>8</left><top>6</top><width>62</width><height>40</height><label>$INFO[ListItem.Property(AsterBooks.Number)]</label><font>font20</font><textcolor>asterMuted</textcolor></control>
        <control type="label"><left>76</left><top>6</top><width>610</width><height>40</height><label>$INFO[ListItem.Property(AsterBooks.EntryTitle)]</label><font>font20</font><textcolor>asterInk</textcolor><truncate>true</truncate></control>
        <control type="label"><left>76</left><top>6</top><width>610</width><height>40</height><label>Back to Books</label><font>font20</font><textcolor>asterInk</textcolor><visible>ListItem.IsParentFolder</visible></control>
        <control type="label"><left>76</left><top>6</top><width>610</width><height>40</height><label>$INFO[MusicPlayer.Title]</label><font>font20</font><textcolor>asterInk</textcolor><visible>Player.HasAudio + !ListItem.IsParentFolder + String.IsEmpty(ListItem.Property(AsterBooks.EntryTitle))</visible></control>
        <control type="label"><left>700</left><top>6</top><width>130</width><height>40</height><label>$INFO[ListItem.Property(AsterBooks.Length)]</label><font>font20</font><textcolor>asterMuted</textcolor><align>right</align></control>
      </itemlayout>
      <focusedlayout height="54" width="850">
        <control type="image"><left>0</left><top>5</top><width>4</width><height>42</height><texture>special://skin/media/ui-solid.png</texture><colordiffuse>asterGreen</colordiffuse></control>
        <control type="label"><left>8</left><top>6</top><width>62</width><height>40</height><label>$INFO[ListItem.Property(AsterBooks.Number)]</label><font>font20</font><textcolor>asterGreen</textcolor></control>
        <control type="label"><left>76</left><top>6</top><width>610</width><height>40</height><label>$INFO[ListItem.Property(AsterBooks.EntryTitle)]</label><font>font20</font><textcolor>asterGreen</textcolor><truncate>true</truncate></control>
        <control type="label"><left>76</left><top>6</top><width>610</width><height>40</height><label>Back to Books</label><font>font20</font><textcolor>asterGreen</textcolor><visible>ListItem.IsParentFolder</visible></control>
        <control type="label"><left>76</left><top>6</top><width>610</width><height>40</height><label>$INFO[MusicPlayer.Title]</label><font>font20</font><textcolor>asterGreen</textcolor><visible>Player.HasAudio + !ListItem.IsParentFolder + String.IsEmpty(ListItem.Property(AsterBooks.EntryTitle))</visible></control>
        <control type="label"><left>700</left><top>6</top><width>130</width><height>40</height><label>$INFO[ListItem.Property(AsterBooks.Length)]</label><font>font20</font><textcolor>asterGreen</textcolor><align>right</align></control>
      </focusedlayout>
    </control>
  </controls>
</window>
