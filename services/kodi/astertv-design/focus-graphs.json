        "play":{"left":"series-return","right":"trailer","down":"cast"},
        "trailer":{"left":"play","right":"season-list","down":"related"},
        "series-return":{"right":"play","down":"cast"},
        "cast":{"up":"play","right":"season-list","down":"related"},
        "related":{"up":"cast","right":"season-list","down":"cast"},
