{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astertv.local/schemas/design/component.schema.json",
  "type": "object",
  "required": ["id", "states", "variants"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "variants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
