<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kodi compatibility map for the G20S Pro Plus 2.4 GHz USB receiver.

  The receiver can expose OK as Linux KEY_SELECT, keyboard Return or
  mouse-left depending on its current mode/handshake, while Back is
  mouse-right. Route all observed OK forms
  through the Aster Select dispatcher so script-populated Music, Books and
  Digest rows activate like native Kodi items; all other controls receive
  normal Select. Leave every other correctly reported keyboard/media key alone.
  Normal couch use should keep the remote's air-mouse mode disabled.
-->
<keymap>
  <global>
    <keyboard>
      <select>RunScript(special://home/addons/skin.asterhome/tools/select_dispatch.py)</select>
      <return>RunScript(special://home/addons/skin.asterhome/tools/select_dispatch.py)</return>
      <enter>RunScript(special://home/addons/skin.asterhome/tools/select_dispatch.py)</enter>
    </keyboard>
    <mouse>
      <leftclick>RunScript(special://home/addons/skin.asterhome/tools/select_dispatch.py)</leftclick>
      <rightclick>Back</rightclick>
    </mouse>
  </global>
  <FullscreenVideo>
    <keyboard>
      <select>OSD</select>
      <return>OSD</return>
      <enter>OSD</enter>
    </keyboard>
    <mouse>
      <leftclick>OSD</leftclick>
      <rightclick>Fullscreen</rightclick>
    </mouse>
  </FullscreenVideo>
  <FullscreenGame>
    <keyboard>
      <select>OSD</select>
      <return>OSD</return>
      <enter>OSD</enter>
    </keyboard>
    <mouse>
      <leftclick>OSD</leftclick>
      <rightclick>Back</rightclick>
    </mouse>
  </FullscreenGame>
  <Visualisation>
    <keyboard>
      <select>OSD</select>
      <return>OSD</return>
      <enter>OSD</enter>
    </keyboard>
    <mouse>
      <leftclick>OSD</leftclick>
      <rightclick>Back</rightclick>
    </mouse>
  </Visualisation>
</keymap>
