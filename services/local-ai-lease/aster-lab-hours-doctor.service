[Unit]
Description=Validate Aster Lab Hours reservation and restoration health
After=pvescheduler.service pvestatd.service
ConditionPathExists=/usr/local/libexec/local-ai-lease/full-inference-pilot/lab_hours_doctor.py

[Service]
Type=oneshot
User=root
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B /usr/local/libexec/local-ai-lease/full-inference-pilot/lab_hours_doctor.py
