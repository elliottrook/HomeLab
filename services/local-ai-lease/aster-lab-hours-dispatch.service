[Unit]
Description=Dispatch due reservations for exclusive Aster Lab Hours
After=pvescheduler.service pvestatd.service
ConditionPathExists=/usr/local/libexec/local-ai-lease/full-inference-pilot/lab_hours_dispatcher.py

[Service]
Type=oneshot
User=root
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B /usr/local/libexec/local-ai-lease/full-inference-pilot/lab_hours_dispatcher.py
Nice=10
IOSchedulingClass=idle
