[Unit]
Description=Application-only B60 lease watchdog (disabled candidate)
After=network-online.target
ConditionPathExists=/var/lib/local-ai-lab/application-b60/application-b60.json
RefuseManualStart=yes

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/application-b60-lease-recovery --once --state /var/lib/local-ai-lab/application-b60/application-b60.json --effect-authorized
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/local-ai-lab/application-b60

[Install]
WantedBy=multi-user.target
