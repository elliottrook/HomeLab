[Unit]
Description=Stream A evaluation lease watchdog (inactive candidate)
After=local-fs.target
ConditionPathExists=/var/lib/local-ai-lab/stream-a-evaluation/lease.json
RefuseManualStart=yes

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/stream-a-evaluation-watchdog --once --effect-authorized
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/local-ai-lab/stream-a-evaluation

[Install]
WantedBy=timers.target
