[Unit]
Description=F2 archive preflight preparation (disabled candidate)
After=pvescheduler.service pvestatd.service
ConditionPathExists=/usr/local/libexec/local-ai-lease/f2_scheduled_release_candidate.py

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B /usr/local/libexec/local-ai-lease/f2_scheduled_release_candidate.py --phase prepare
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/var/lib/local-ai-lab/f2-preflight /var/lib/local-ai-lab/f2-scheduled
UMask=0077
TimeoutStartSec=90s
Restart=no
StandardOutput=null
StandardError=null
