[Unit]
Description=Local AI lease recovery watchdog (disabled candidate)
After=network-online.target
ConditionPathExists=/var/lib/local-ai-lab/runtime-manifest.json
RefuseManualStart=yes

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/local-ai-lease-recovery --once --state /var/lib/local-ai-lab/lease.json --manifest /var/lib/local-ai-lab/runtime-manifest.json --effect-authorized
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/local-ai-lab

[Install]
WantedBy=multi-user.target
