[Unit]
Description=Aster Authenticated CPU Batch Renderer Bridge Candidate
After=network-online.target aster-kokopop-news.service
Wants=network-online.target
Requires=aster-kokopop-news.service

[Service]
Type=simple
User=aster-renderer
Group=aster-renderer
UMask=0077
WorkingDirectory=/opt/aster-news-renderer/bridge
EnvironmentFile=/etc/aster-renderer/batch-bridge.env
ExecStart=/usr/bin/python3 /opt/aster-news-renderer/bridge/vulkan_renderer_bridge.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
