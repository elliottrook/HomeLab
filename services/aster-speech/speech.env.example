# Configuration template only. Provision the existing secret through the
# authorized credential path; never put a real key in this repository.
ASTER_SPEECH_API_KEY=
# Optional path to a separate television credential accepted only by /v1/stt.
# The real file must be root-owned, mode 0400/0440/0640 and readable by the
# aster-speech service group. Never place the key itself in this file or Git.
ASTER_SPEECH_TV_STT_KEY_FILE=/etc/aster-speech/tv-stt.key
ASTER_SPEECH_STT_MODEL=base.en
ASTER_SPEECH_PIPER_BIN=/opt/piper/piper/piper
ASTER_SPEECH_PIPER_VOICE=/opt/piper/voices/en_US-lessac-high.onnx
ASTER_SPEECH_PIPER_LENGTH_SCALE=1.15
HF_HOME=/var/lib/aster-speech/hf-cache
ASTER_AUTHENTIK_ISSUER=https://auth.elliottrook.com/application/o/aster-companion/
ASTER_AUTHENTIK_JWKS_URL=https://auth.elliottrook.com/application/o/aster-companion/jwks/
ASTER_AUTHENTIK_AUDIENCE=aster-companion
